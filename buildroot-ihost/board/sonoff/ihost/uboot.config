
CONFIG_DOS_PARTITION=y
# CONFIG_EFI_PARTITION is not set
# CONFIG_USB_STORAGE is not set
CONFIG_DISPLAY_BOARDINFO=y

# CONFIG_OF_LIBFDT_OVERLAY=y
# CONFIG_ENV_IS_IN_MMC is not set


# Boot must not be interruptible on a shipped device.
#
# U-Boot semantics (boot/Kconfig): "set to -2 to autoboot with no delay and not
# check for abort". Anything >= 0 opens a serial window in which any keypress
# drops to the U-Boot prompt — and from that prompt an attacker with physical
# access edits bootargs, boots with init=/bin/sh and owns the device, bypassing
# every OS-level control. Our rootfs is unencrypted and carries fleet-shared
# secrets, so that is a fleet compromise, not a device compromise.
#
# This file previously set 3, silently overriding the HAOS default of -2 in
# buildroot-external/bootloader/uboot.config:6 — leftover from board bring-up.
# Finding #9 of the 2026-07-27 security review.
#
# Operational consequence: the U-Boot prompt is no longer reachable over serial.
# Recovery paths that remain: the Linux serial console (getty), RAUC slot
# rollback, and SD-card reflash via the USB-SD-MUX. None of them need the
# U-Boot prompt. Bench work that genuinely does can build with a local override.
CONFIG_BOOTDELAY=-2
CONFIG_SYS_PROMPT="HAOS> "
