# Options HAOS added to its common fragment (kernel/v6.18.y/haos.config)
# between 16.3 (bd5ea3763) and 18.3 (b22f929d3), restated for the 6.12
# kernel this board stays on. The 16.3 v6.12.y fragments next to this file
# are copied verbatim from upstream bd5ea3763 (18.0 deleted v6.12.y).
#   d846fdb13 autofs, 8fc6503d2 F2FS, 553108380 CONNMARK, 6dd5770b2 NFSv4.x,
#   3ea000fab PSI, 13b2f05e7 iptables comments
CONFIG_AUTOFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
