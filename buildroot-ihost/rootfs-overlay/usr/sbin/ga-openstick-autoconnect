#!/bin/sh
# ga-openstick-autoconnect — Scan for OpenStick WiFi and create persistent connection
#
# Scans for GA-XXXX SSIDs, derives PSK via HMAC-SHA256, creates a persistent
# NM connection with autoconnect=yes. NM then manages failover automatically
# via route metrics:
#
#   Ethernet (100) > OpenStick (500) > RNDIS (700) > Install WiFi (800)
#
# Run by:
#   - ga-openstick-autoconnect.timer (every 5 min — picks up new sticks)
#   - ga-openstick-autoconnect.service (once at boot)
#
# NO RE-JOIN LOOP ON A DONGLE WITHOUT INTERNET (Odoo #2112)
# ---------------------------------------------------------
# A dongle whose Wi-Fi is up but has no WAN (no SIM, a SIM without a data
# service) used to be joined, judged not-full by NM, deleted, and joined AGAIN
# 10 minutes later (5-min timer + 5-min cooldown) - a ~30 s outage on the
# working uplink every 10 min for as long as the stick broadcasts (K31 bench,
# 2026-11-17). The ga-uplink-ladder never sees it: the profile is gone before
# its 2-min tick.
#
# So an SSID that proved to have no internet is BARRED, with a growing back-off
# per SSID (30 min -> 2 h -> 6 h, capped), persisted in /mnt/data so a reboot
# does not restart the ladder of retries. It is tried again when the bar
# expires (the stick may be the only uplink later). Two rules keep that from
# ever costing connectivity:
#   * The bar only applies while ANOTHER uplink is full. With nothing else
#     online the dongle is the only way out: a bar is ignored, and a join that
#     is not full is KEPT (never deleted) - the ladder keeps searching.
#   * A later `full` verdict on the stick clears the bar.
# Own state rather than the ladder's /run/ga-uplink-tried: that one is keyed by
# connection NAME (always "openstick-auto", whatever the SSID), flat 600 s,
# wiped at every boot, and the ladder never runs for this case at all.
set -e

# Every path and command is env-overridable so the decision logic runs host-side
# against a stub nmcli (tests/ga_tests/openstick_backoff).
NMCLI="${GA_OPENSTICK_NMCLI:-nmcli}"
SLEEP="${GA_OPENSTICK_SLEEP:-sleep}"
KEY_FILE="${GA_OPENSTICK_KEY_FILE:-/usr/share/ga-wifi/openstick-wifi.key}"
SSID_PREFIX="GA-"
CONN_NAME="openstick-auto"
COOLDOWN_FILE="${GA_OPENSTICK_COOLDOWN_FILE:-/mnt/data/.ga-openstick-cooldown}"
COOLDOWN_SECS=300
BACKOFF_FILE="${GA_OPENSTICK_BACKOFF_FILE:-/mnt/data/.ga-openstick-backoff}"
# seconds a failed SSID stays barred, per consecutive failure; the last repeats
BACKOFF_STEPS="1800 7200 21600"
BACKOFF_CAP=21600
PARK_DIR="${GA_LADDER_PARK_DIR:-/run/ga-uplink-parked}"
LOG_TAG="ga-openstick"

log() { echo "$LOG_TAG: $1"; }
# bar / unbar / lifted-bar decisions are loud: journal at warning, not info
warn() { echo "$LOG_TAG: $1"; logger -t "$LOG_TAG" -p daemon.warning "$1" 2>/dev/null || true; }
now() { date +%s; }

# --- per-SSID back-off: file lines "<ssid>\t<level>\t<until-epoch>" ---------
bo_field() { # bo_field <ssid> <2|3>
  [ -f "$BACKOFF_FILE" ] || return 0
  awk -F'\t' -v s="$1" -v f="$2" '$1==s {print $f; exit}' "$BACKOFF_FILE" 2>/dev/null || true
}
bo_drop() { # bo_drop <ssid>
  [ -f "$BACKOFF_FILE" ] || return 0
  _t="$BACKOFF_FILE.tmp"
  awk -F'\t' -v s="$1" '$1!=s' "$BACKOFF_FILE" > "$_t" 2>/dev/null && mv "$_t" "$BACKOFF_FILE" || true
}
# remaining bar in seconds (0 = not barred). A clock that jumped backwards
# (no RTC at boot) must not strand a bar for years: clamp to the cap.
bo_remaining() {
  _u=$(bo_field "$1" 3); _n=$(now)
  case "$_u" in ''|*[!0-9]*) echo 0; return 0 ;; esac
  [ "$_u" -gt "$_n" ] || { echo 0; return 0; }
  _r=$((_u - _n)); [ "$_r" -le "$BACKOFF_CAP" ] || _r=$BACKOFF_CAP
  echo "$_r"
}
bar_ssid() { # bar_ssid <ssid> <why>
  _l=$(bo_field "$1" 2); case "$_l" in ''|*[!0-9]*) _l=0 ;; esac
  _l=$((_l + 1))
  _d=$BACKOFF_CAP; _i=0
  for _st in $BACKOFF_STEPS; do _i=$((_i + 1)); [ "$_i" -eq "$_l" ] && { _d=$_st; break; }; done
  bo_drop "$1"
  printf '%s\t%s\t%s\n' "$1" "$_l" "$(( $(now) + _d ))" >> "$BACKOFF_FILE"
  warn "BARRED $1 for ${_d}s (failure $_l in a row, $2) - not re-joined while another uplink is full; retried when the bar expires"
}
unbar_ssid() { # unbar_ssid <ssid>
  [ -n "$(bo_field "$1" 2)" ] || return 0
  bo_drop "$1"
  warn "UNBARRED $1 - it carries internet again (full), back-off reset"
}

# 1. Check if secret exists (feature disabled without key)
# This used to `exit 0` in silence. The key is injected at BUILD time from
# secrets/openstick-wifi.key and the post-build step only warns in the build
# log, so an image built without it disables the LTE fallback on every device
# it ships to — and no device ever says so (working-method rule 44), on the one
# uplink a site may have nothing else but.
if [ ! -f "$KEY_FILE" ]; then
  log "NO SHARED KEY at $KEY_FILE — the LTE/OpenStick fallback is DISABLED on this device. This image was built without secrets/openstick-wifi.key; a site whose only uplink is the stick cannot come online."
  exit 0
fi

# 2a. Respect a parked rung. ga-uplink-ladder parks a connection that carries
# no internet (autoconnect no + down) and re-tests it after a cooldown. Without
# this check the scan below would find the stick "not active", delete the
# profile and recreate it — undoing the park every 5 minutes and pinning the
# device to a dead uplink. Two mechanisms, one connection: the ladder owns
# whether it may run, this script owns whether it exists.
if [ -f "$PARK_DIR/$CONN_NAME" ]; then
  log "$CONN_NAME is parked by ga-uplink-ladder (no internet on it) — leaving it alone"
  exit 0
fi

# 2. Check if already connected — nothing to do
if $NMCLI -t -f NAME connection show --active 2>/dev/null | grep -q "$CONN_NAME"; then
  # An active stick that NM calls full (cached verdict, no traffic) clears any
  # bar left over from when it had no internet.
  if [ -s "$BACKOFF_FILE" ] && [ "$($NMCLI -t -f CONNECTIVITY general status 2>/dev/null | head -1)" = "full" ]; then
    _as=$($NMCLI -g 802-11-wireless.ssid connection show "$CONN_NAME" 2>/dev/null | head -1 || true)
    [ -z "$_as" ] || unbar_ssid "$_as"
  fi
  exit 0
fi

# 3. Check cooldown (avoid scan loops when no stick in range)
if [ -f "$COOLDOWN_FILE" ]; then
  COOLDOWN_UNTIL=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
  NOW=$(now)
  if [ "$NOW" -lt "$COOLDOWN_UNTIL" ]; then
    exit 0
  fi
  rm -f "$COOLDOWN_FILE"
fi

log "Scanning for OpenStick WiFi..."

# 4. WiFi scan (multiple rescans for reliability)
for _scan in 1 2 3; do
  $NMCLI dev wifi rescan 2>/dev/null
  $SLEEP 5
done

# 5. Find GA-* SSIDs sorted by signal strength
GA_SSIDS=$($NMCLI -t -f SSID,SIGNAL dev wifi list 2>/dev/null \
  | grep "^${SSID_PREFIX}" \
  | sort -t: -k2 -rn \
  | cut -d: -f1 \
  | head -5)

if [ -z "$GA_SSIDS" ]; then
  log "No GA-* SSIDs found — cooldown ${COOLDOWN_SECS}s"
  echo $(( $(now) + COOLDOWN_SECS )) > "$COOLDOWN_FILE"
  exit 0
fi

SECRET=$(cat "$KEY_FILE" | tr -d '\n')

# Is there a better rung right now? The stick is not active (step 2), so NM's
# verdict describes the OTHER uplink. Snapshot it BEFORE joining: afterwards the
# single radio has left it. Cached verdict first (free); one forced probe only
# when it is not full, so a stale cache cannot wrongly lift a bar.
OTHER_FULL=no
_v=$($NMCLI -t -f CONNECTIVITY general status 2>/dev/null | head -1 || true)
[ "$_v" = "full" ] || _v=$($NMCLI networking connectivity check 2>/dev/null | head -1 || true)
[ "$_v" = "full" ] && OTHER_FULL=yes

# 6. Try each SSID — create persistent autoconnect connection
for SSID in $GA_SSIDS; do
  # Validate format: GA- followed by 4 digits
  if ! echo "$SSID" | grep -qE "^GA-[0-9]{4}$"; then
    continue
  fi

  # Derive PSK
  PSK=$(echo -n "$SSID" | openssl dgst -sha256 -hmac "$SECRET" 2>/dev/null | cut -d' ' -f2 | cut -c1-16)
  if [ ${#PSK} -ne 16 ]; then
    log "HMAC derivation failed for $SSID"
    continue
  fi

  _rem=$(bo_remaining "$SSID")
  if [ "$_rem" -gt 0 ]; then
    if [ "$OTHER_FULL" = "yes" ]; then
      log "$SSID is barred for another ${_rem}s (no internet on it earlier) - another uplink is full, skipping"
      continue
    fi
    warn "bar on $SSID (${_rem}s left) LIFTED - no other uplink is full, the dongle may be the only way online"
  fi

  log "Creating persistent connection for $SSID..."

  # Remove old connection if exists
  $NMCLI connection delete "$CONN_NAME" 2>/dev/null || true

  # Create persistent connection with autoconnect + correct priority.
  # wifi.powersave=2 (disable) is REQUIRED — without it nmcli writes the
  # connection-default value 1 (=ignore), which overrides the system-wide
  # `wifi.powersave=2` from `[connection-wifi-defaults]` in NetworkManager.conf.
  # On the Realtek RTW88 chip, leaving the driver-default powersave on causes
  # the AP to queue ARP replies during sleep windows; the station misses them,
  # the ARP cache stays INCOMPLETE, and no IP traffic flows even though the
  # link looks associated. Setting powersave=2 here keeps the OS default in
  # effect for the auto-generated profile.
  # wifi.cloned-mac-address=permanent matches the OS default for stable identity.
  if $NMCLI connection add type wifi ifname wlan0 \
       con-name "$CONN_NAME" \
       ssid "$SSID" \
       wifi-sec.key-mgmt wpa-psk \
       wifi-sec.psk "$PSK" \
       connection.autoconnect yes \
       connection.autoconnect-priority 10 \
       ipv4.route-metric 500 \
       wifi.powersave 2 \
       wifi.cloned-mac-address permanent \
       2>/dev/null; then

    log "Connection '$CONN_NAME' created for $SSID (autoconnect=yes, priority=10, metric=500, powersave=disabled)"

    # Activate now (NM will auto-activate on future boots/scans)
    $NMCLI connection up "$CONN_NAME" 2>/dev/null || true

    # Wait for DHCP
    $SLEEP 10

    # Verify internet with the SAME verdict ga-uplink-ladder acts on: NM's own
    # HTTPS probe (https://checkonline.greenautarky.com/online.txt, see
    # conf.d/50-ga.conf), not a private plain-HTTP curl. The two can disagree
    # (a proxy that rewrites HTTP, a portal, a captive redirect): curl "ok"
    # kept a profile the ladder then parked after three strikes, curl "dead"
    # deleted one NM called `full` (Odoo #2112). One probe, one verdict.
    # Retry a few times: DHCP and the route can lag the association.
    _verdict=""
    for _try in 1 2 3; do
      _verdict=$($NMCLI networking connectivity check 2>/dev/null | head -1)
      [ "$_verdict" = "full" ] && break
      $SLEEP 5
    done
    if [ "$_verdict" = "full" ]; then
      log "Connected to $SSID — internet verified. Connection is persistent."
      unbar_ssid "$SSID"
      rm -f "$COOLDOWN_FILE"
      exit 0
    elif [ "$OTHER_FULL" = "yes" ]; then
      warn "$SSID connected but NM connectivity is '$_verdict' (not full) and another uplink is full - removing connection"
      $NMCLI connection delete "$CONN_NAME" 2>/dev/null || true
      bar_ssid "$SSID" "NM connectivity '$_verdict'"
    else
      # Nothing else is online: deleting this would leave the device with no
      # link at all. Keep it; ga-uplink-ladder keeps searching and moves off it
      # the moment a real rung appears.
      warn "$SSID connected but NM connectivity is '$_verdict' (not full) - NO other uplink is full, KEEPING it (never leave the device without a link); no back-off"
      exit 0
    fi
  else
    log "Failed to create connection for $SSID"
  fi
done

log "No GA-* SSID to join (failed or barred) — cooldown ${COOLDOWN_SECS}s"
echo $(( $(now) + COOLDOWN_SECS )) > "$COOLDOWN_FILE"
