#!/bin/sh
# ga-wifi-watchdog — recover two distinct rtw88_8723ds runtime WiFi failures,
# both of which strand the device while wlan0 stays UP at a STRONG signal, and
# both invisible to a simple "is wlan0 up?" check.
#
# MODE B — degraded TX hang. The chip firmware stops completing transmits and
# the driver spams
#   rtw_8723ds mmc1:0001:1: failed to get tx report from firmware
# Transmit retries pile up, throughput collapses (~18 KB/s despite -44 dBm), and
# any OS OTA times out (ga-rauc-install killed at its 15-min start-timeout). Seen
# on K7 + K17 (2026-07-02); a reboot cleared it (18 KB/s -> 2.68 MB/s, tx-report
# errors 375 -> 0). See ga-ihost-docs DISCUSSION-WIFI-RTW88-DEGRADED-TX.md / KB123.
#
# MODE C — beacon-loss association flapping. The client stops hearing the AP's
# beacons at STRONG signal, so wpa_supplicant logs CTRL-EVENT-BEACON-LOSS in a
# storm and the association drops and re-forms every few minutes — the device is
# effectively offline for hours. tx-report errors stay FLAT, so mode B is blind
# to it. Observed on K0 (2026-07-24): 2854 beacon-loss events/hour, AP logged
# connect/disconnect every 2-5 min at -44 dBm. Classic rtw88 power-save symptom.
# See Odoo #596/#597, KB #167.
#
# This runs periodically (ga-wifi-watchdog.timer, every 3 min) and, on EITHER
# failure, escalates:
#   1. in-place module reload (rmmod/modprobe) — cheapest recovery;
#   2. if the NEXT check still shows the fault, a GUARDED reboot — bounded to
#      REBOOT_MAX within REBOOT_WINDOW_S so a genuine hardware fault can never
#      cause a boot loop (mirrors the ga-boot-check / ga-crash-marker ledger).
#
# Fail-safe by construction: only acts when wlan0 is the ACTIVE default route
# (so a fault actually strands the device) AND the signal is strong (rules out a
# legitimately-weak/absent link — a weak link legitimately loses beacons), AND
# the fault is happening NOW (tx-report errors climbing / beacon-loss storming).
set -eu

TAG="ga-wifi-watchdog"
SDIO_DEV="/sys/bus/sdio/devices/mmc1:0001:1"
IFACE="wlan0"
ERR_STATE="/run/ga-wifi-watchdog.errcount"      # last-seen tx-report error count
STREAK_STATE="/run/ga-wifi-watchdog.streak"     # consecutive degraded checks
RELOADED_MARK="/run/ga-wifi-watchdog.reloaded"  # a reload was already tried this session
REBOOT_LEDGER="/mnt/data/.ga-wifi-recover-reboots"  # epoch per reboot (persists across boots)

# ---- tunables ----
ERR_DELTA_THRESHOLD=15   # NEW tx-report errors since last check = actively failing (mode B)
BEACON_LOSS_WINDOW_MIN=4 # look back this far for beacon-loss (timer fires every 3 min)
BEACON_LOSS_THRESHOLD=20 # NEW CTRL-EVENT-BEACON-LOSS in the window = flapping (mode C).
                         # A stable link produces ~0; the K0 pathology was ~140 per 3 min.
STREAK_TO_ACT=2          # require N consecutive degraded checks (anti-flap)
MIN_RSSI_DBM=-72         # only act on a strong link (negative int compare is fine in sh)
RELOAD_SETTLE_S=25       # wait for wlan0 to re-associate after a module reload
REBOOT_MAX=3             # at most this many self-reboots ...
REBOOT_WINDOW_S=21600    # ... within 6 h; beyond that, stop (likely hardware)

# log() = routine (journald info, stays on-device — dropped by fluent-bit's
# PRIORITY [0-4] filter). logw()/loge() prefix the systemd stdout priority
# (`<4>`=warning, `<3>`=err) so the ACTUAL trigger/recovery events pass that
# filter and reach Loki, while the every-3-min healthy checks do not.
log()  { echo "$TAG: $*"; }
logw() { echo "<4>$TAG: $*"; }
loge() { echo "<3>$TAG: $*"; }

# ---- preconditions ----
[ -d "$SDIO_DEV" ] || { log "no rtw SDIO device — not an iHost WiFi chip, skip"; exit 0; }
[ -d "/sys/class/net/$IFACE" ] || { log "$IFACE absent — cold-boot recovery is ga-rtw-recover's job, skip"; exit 0; }
# Only matters if this WiFi is the ACTIVE uplink; on ethernet a TX hang doesn't strand us.
if ! ip route 2>/dev/null | grep -q "^default .* dev $IFACE "; then
    log "$IFACE is not the default route — skip"
    exit 0
fi

# ---- degraded signal: NEW tx-report errors since the last run ----
now_err=$(dmesg 2>/dev/null | grep -c "failed to get tx report" || true)
now_err=${now_err:-0}
prev_err=0
[ -f "$ERR_STATE" ] && prev_err=$(cat "$ERR_STATE" 2>/dev/null || echo 0)
printf '%s\n' "$now_err" > "$ERR_STATE"
# dmesg ring can wrap/be cleared -> if it shrank, count all current as fresh.
if [ "$now_err" -ge "$prev_err" ]; then
    delta=$(( now_err - prev_err ))
else
    delta=$now_err
fi

# RSSI: /proc/net/wireless is PRIMARY — it still reports during the hang, whereas
# `iw dev wlan0 link` returns nothing (the chip can't answer). level = 4th field
# on the wlan0 row, e.g. "wlan0: 0000 66. -44. -256" -> -44 (strip trailing dot).
rssi=$(grep -E "^[[:space:]]*${IFACE}:" /proc/net/wireless 2>/dev/null | awk '{v=$4; gsub(/\./,"",v); print v; exit}')
[ -z "${rssi:-}" ] && rssi=$(iw dev "$IFACE" link 2>/dev/null | awk '/signal:/{print $2; exit}')
rssi=${rssi:-0}

degraded_tx=0
if [ "$delta" -ge "$ERR_DELTA_THRESHOLD" ] && [ "$rssi" -ge "$MIN_RSSI_DBM" ]; then
    degraded_tx=1
fi

# ---- degraded signal C: beacon-loss association flapping ----
# wpa_supplicant logs "CTRL-EVENT-BEACON-LOSS" each time it misses the AP's
# beacons; a storm of them at STRONG signal is the power-save disassociation
# pathology (mode C). Counted over a short window rather than as a cumulative
# delta because, unlike tx-report errors, these are transient log lines. The
# strong-RSSI gate is essential: a genuinely weak link loses beacons too, and we
# must not reboot for that.
beacon_loss=$(journalctl --since "-${BEACON_LOSS_WINDOW_MIN} min" --no-pager 2>/dev/null \
                | grep -c "CTRL-EVENT-BEACON-LOSS" || true)
beacon_loss=${beacon_loss:-0}
degraded_beacon=0
if [ "$beacon_loss" -ge "$BEACON_LOSS_THRESHOLD" ] && [ "$rssi" -ge "$MIN_RSSI_DBM" ]; then
    degraded_beacon=1
fi

# Either failure class counts as degraded; both feed the same escalation ladder.
# (Written as an explicit if — a `a || b && c` one-liner would exit under set -e
# when both tests are false, because the whole list then returns non-zero.)
degraded=0
if [ "$degraded_tx" -eq 1 ] || [ "$degraded_beacon" -eq 1 ]; then
    degraded=1
fi

streak=0
[ -f "$STREAK_STATE" ] && streak=$(cat "$STREAK_STATE" 2>/dev/null || echo 0)
if [ "$degraded" -eq 1 ]; then
    streak=$(( streak + 1 ))
else
    streak=0
    # healthy check clears the "reload already tried" latch
    rm -f "$RELOADED_MARK"
fi
printf '%s\n' "$streak" > "$STREAK_STATE"

log "check: tx_report_errs=$now_err delta=$delta beacon_loss=$beacon_loss rssi=${rssi}dBm degraded=$degraded(tx=$degraded_tx,beacon=$degraded_beacon) streak=$streak"

# Initial detection needs STREAK_TO_ACT consecutive hits (anti-flap). But once a
# reload has already been tried (RELOADED_MARK set), a SINGLE further degraded
# tick is enough to know the reload didn't help -> escalate to reboot promptly.
act_threshold="$STREAK_TO_ACT"
[ -f "$RELOADED_MARK" ] && act_threshold=1
[ "$streak" -ge "$act_threshold" ] || exit 0

# ---- confirmed degraded: recover ----
printf '0\n' > "$STREAK_STATE"

reload_stack() {
    logw "degraded WiFi confirmed (tx=$degraded_tx beacon=$degraded_beacon) — reloading rtw88_8723ds module stack"
    for m in rtw88_8723ds rtw88_8723d rtw88_8723x rtw88_sdio; do
        if lsmod 2>/dev/null | grep -q "^${m} "; then
            rmmod "$m" 2>/dev/null && log "unloaded $m" || log "rmmod $m failed — continuing"
        fi
    done
    modprobe rtw88_8723ds || log "modprobe rtw88_8723ds failed"
    i=0
    while [ "$i" -lt "$RELOAD_SETTLE_S" ]; do
        [ -d "/sys/class/net/$IFACE" ] && iw dev "$IFACE" link 2>/dev/null | grep -q "Connected to" && break
        sleep 1
        i=$(( i + 1 ))
    done
    # Reset the error baseline so the NEXT tick measures errors produced AFTER the
    # reload — that's how we tell whether the reload actually fixed the TX path.
    printf '%s\n' "$(dmesg 2>/dev/null | grep -c 'failed to get tx report' || echo 0)" > "$ERR_STATE"
}

guarded_reboot() {
    now=$(date +%s 2>/dev/null || echo 0)
    recent=0
    fresh=""
    if [ -f "$REBOOT_LEDGER" ]; then
        while IFS= read -r ts; do
            [ -n "$ts" ] || continue
            if [ "$(( now - ts ))" -lt "$REBOOT_WINDOW_S" ]; then
                fresh="${fresh}${ts}
"
                recent=$(( recent + 1 ))
            fi
        done < "$REBOOT_LEDGER"
        printf '%s' "$fresh" > "$REBOOT_LEDGER" 2>/dev/null || true
    fi
    if [ "$recent" -ge "$REBOOT_MAX" ]; then
        loge "reload did NOT clear degraded TX, and already rebooted ${recent}x in ${REBOOT_WINDOW_S}s — NOT rebooting (likely hardware); leaving device degraded for inspection"
        return 0
    fi
    printf '%s\n' "$now" >> "$REBOOT_LEDGER" 2>/dev/null || true
    loge "reload did NOT clear degraded TX — scheduling reboot ($(( recent + 1 ))/${REBOOT_MAX} in window)"
    sync
    systemctl reboot
}

if [ -f "$RELOADED_MARK" ]; then
    # A reload was already attempted and it's STILL degraded -> escalate.
    guarded_reboot
else
    reload_stack
    touch "$RELOADED_MARK"
fi
