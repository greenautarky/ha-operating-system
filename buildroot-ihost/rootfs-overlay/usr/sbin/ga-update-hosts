#!/bin/sh
# ga-update-hosts — Generate /etc/hosts entries from ga-services.conf
#
# Reads the central GA services configuration and writes host entries
# so that GA backend services (InfluxDB, Loki, OTA) resolve correctly
# even when NetBird DNS is unavailable.
#
# OTA-host gets a dynamic IP picked by ga-resolve-ota (failover):
#   - If /run/ga-resolve-ota.active exists, use that IP for GA_OTA_HOST
#   - Otherwise fall back to the first IP in GA_OTA_IPS, or GA_SERVICES_IP
#
# Called by ga-update-hosts.service at boot (after ga-resolve-ota), and
# re-triggered by ga-resolve-ota whenever the active OTA IP changes.
#
# Sources (in priority order):
#   1. /mnt/data/ga-services.conf   (runtime override, persistent)
#   2. /etc/ga-services.conf        (rootfs default, OTA-updatable)
#
# Writes to:
#   /mnt/overlay/etc/hosts           (bind-mounted as /etc/hosts by HAOS)
#   /mnt/data/ga-supervisor-hosts    (bind-mounted READ-ONLY as /etc/hosts into
#                                     the Supervisor container by hassos-supervisor)
#
# Modes:
#   ga-update-hosts                     write both files; if the Supervisor
#                                       container is running, verify it (below)
#   ga-update-hosts --verify-supervisor write nothing; wait for the Supervisor
#                                       container, then verify it (run by
#                                       ga-supervisor-hosts-check.service)
# Verifying = the container's /etc/hosts carries the GA entries AND a lookup
# from inside the container returns the configured address for every GA name.
# A failed verification logs at error level and exits non-zero.
#
# IMPORTANT: HAOS bind-mounts /etc/hosts onto /mnt/overlay/etc/hosts.
# We MUST write the file in-place (truncate + write) — never via rename.
# `sed -i`, `cp -f`, `mv` all use rename(2) which destroys the bind-mount
# inode link, leaving /etc/hosts pointing at an orphaned (Links: 0) file.

set -eu

MODE="update"
case "${1:-}" in
    "") ;;
    --verify-supervisor) MODE="verify" ;;
    *) echo "usage: ga-update-hosts [--verify-supervisor]" >&2; exit 2 ;;
esac

# Paths are overridable for the host-side test suite (tests/ga_tests/
# update_hosts); production runs with the defaults.
CONF_OVERRIDE="${GA_SERVICES_CONF_OVERRIDE:-/mnt/data/ga-services.conf}"
CONF_DEFAULT="${GA_SERVICES_CONF_BAKED:-/etc/ga-services.conf}"
HOSTS_FILE="${GA_HOSTS_FILE:-/mnt/overlay/etc/hosts}"
OTA_ACTIVE_FILE="${GA_OTA_ACTIVE_FILE:-/run/ga-resolve-ota.active}"
# The Supervisor container's /etc/hosts. hassos-supervisor bind-mounts this
# file READ-ONLY at /etc/hosts in the container; keep the two paths in step.
SUP_HOSTS_FILE="${GA_SUPERVISOR_HOSTS_FILE:-/mnt/data/ga-supervisor-hosts}"
SUP_CONTAINER="hassio_supervisor"
SUP_WAIT_S="${GA_SUPERVISOR_WAIT_S:-300}"
MARKER="# ga-services managed entries (do not edit manually)"
END_MARKER="# end ga-services"
# Persistent record of the last-applied services IP, so we can detect an
# endpoint change across runs/reboots and bounce clients that cache the
# resolved IP (fluent-bit, telegraf). On /mnt/data so it survives OTA reboots.
APPLIED_IP_FILE="${GA_APPLIED_IP_FILE:-/mnt/data/.ga-services-applied-ip}"
# Legacy pre-marker header older versions of this script emitted; stripped below.
LEGACY_COMMENT="# GreenAutarky services — fallback when NetBird DNS is unavailable"
# Services that cache the resolved GA endpoint IP and must be bounced when it
# changes so they re-resolve (only restarted if present + already running).
# This is the SAME set of telemetry shippers ga_manager's identity-write worker
# bounces (its _SHIPPER_UNITS) — they must stay in lockstep, because both lists
# answer the one question "which long-lived clients hold a cached GA endpoint?":
#   - fluent-bit-tier0.service : always-on Loki writer (no consent gate)
#   - fluent-bit.service       : tier-1 Loki writer (consent-gated; running only
#                                when the user opted into error logs — a
#                                try-restart no-ops when it is not running)
#   - telegraf.service         : tier-2 InfluxDB writer (consent-gated)
# fluent-bit.service was missing here while present in identity-write: on a
# backend-IP cutover a consented device's tier-1 error logs kept shipping to the
# stale IP until the next reconnect/reboot, while tier-0 + telegraf re-resolved.
ENDPOINT_BOUND_SERVICES="fluent-bit-tier0.service fluent-bit.service telegraf.service"

# The override LAYERS ON TOP of the baked default — it does not replace it.
# Replacing turned a one-line override into a silent kill switch (see the
# comment in ga-enroll for the measured shape); ga-publish-services has read
# override-then-baked per key since it was written, so this is the intended
# semantics, not a new invention.
_loaded=""
if [ -f "$CONF_DEFAULT" ]; then
    . "$CONF_DEFAULT"
    _loaded="$CONF_DEFAULT"
fi
if [ -f "$CONF_OVERRIDE" ]; then
    . "$CONF_OVERRIDE"
    _loaded="${_loaded:+$_loaded + }$CONF_OVERRIDE"
fi
if [ -z "$_loaded" ]; then
    echo "ga-update-hosts: ERROR — no ga-services.conf found"
    exit 1
fi
echo "ga-update-hosts: loaded config from $_loaded"

if [ -z "${GA_SERVICES_IP:-}" ]; then
    echo "ga-update-hosts: ERROR — GA_SERVICES_IP not set in config"
    exit 1
fi

OTA_IP=""
if [ -n "${GA_OTA_HOST:-}" ]; then
    if [ -f "$OTA_ACTIVE_FILE" ]; then
        OTA_IP=$(cat "$OTA_ACTIVE_FILE" 2>/dev/null | tr -d '[:space:]')
        echo "ga-update-hosts: OTA dynamic pick from $OTA_ACTIVE_FILE = ${OTA_IP}"
    fi
    if [ -z "$OTA_IP" ] && [ -n "${GA_OTA_IPS:-}" ]; then
        OTA_IP=$(echo "$GA_OTA_IPS" | awk '{print $1}')
        echo "ga-update-hosts: OTA fallback to first GA_OTA_IPS entry = ${OTA_IP}"
    fi
    if [ -z "$OTA_IP" ]; then
        OTA_IP="$GA_SERVICES_IP"
        echo "ga-update-hosts: OTA falling back to GA_SERVICES_IP = ${OTA_IP}"
    fi
fi

GA_HOSTS_LINE="${GA_SERVICES_IP}"
[ -n "${GA_INFLUX_HOST:-}" ] && GA_HOSTS_LINE="${GA_HOSTS_LINE} ${GA_INFLUX_HOST}"
[ -n "${GA_LOKI_HOST:-}" ] && GA_HOSTS_LINE="${GA_HOSTS_LINE} ${GA_LOKI_HOST}"
[ -n "${GA_MQTT_HOST:-}" ] && GA_HOSTS_LINE="${GA_HOSTS_LINE} ${GA_MQTT_HOST}"
[ -n "${GA_FLEET_HOST:-}" ] && GA_HOSTS_LINE="${GA_HOSTS_LINE} ${GA_FLEET_HOST}"

# ---------------------------------------------------------------------------
# Supervisor container: what it must resolve, and the check that it does.
#
# WHY A MOUNTED FILE, NOT `docker exec ... >> /etc/hosts`. This script used to
# append the GA entries to the container's /etc/hosts through `docker exec`.
# The Supervisor runs under the upstream AppArmor profile `hassio-supervisor`,
# which denies that write — so every append failed, the error went to
# /dev/null behind `|| true`, and the script still logged "injected". Measured
# on a canary running BOSv1.4.0-rc5 (2026-10-06): six apparmor="DENIED" lines
# on /etc/hosts, zero GA entries in the container, and the Supervisor resolving
# the GA names through public DNS instead of the mesh. Docker would also
# rebuild that file on the next container start, so the append could never
# have survived a Supervisor restart or self-update anyway.
#
# Now hassos-supervisor bind-mounts $SUP_HOSTS_FILE read-only at /etc/hosts
# when it creates the container (the same pattern as /etc/ga-services.conf
# and /etc/ga-version-url), and this script owns the file on the HOST. The
# container's process never writes, so AppArmor has nothing to deny, and the
# profile stays exactly as upstream ships it. The file is rewritten IN PLACE
# (truncate + write): a file bind mount pins the inode, so a rename would
# leave the container reading the old file. An OTA failover of the active OTA
# address is therefore visible in the container at once, without a restart.
# ---------------------------------------------------------------------------

# Log at error level: when stderr is the journal (systemd sets JOURNAL_STREAM),
# a "<3>" prefix sets the priority to err (SyslogLevelPrefix=, default on).
err() {
    if [ -n "${JOURNAL_STREAM:-}" ]; then
        echo "<3>ga-update-hosts: ERROR — $*" >&2
    else
        echo "ga-update-hosts: ERROR — $*" >&2
    fi
}

# "name ip" pairs the Supervisor container must resolve.
expected_pairs() {
    for _h in "${GA_INFLUX_HOST:-}" "${GA_LOKI_HOST:-}" "${GA_MQTT_HOST:-}" "${GA_FLEET_HOST:-}"; do
        [ -n "$_h" ] && echo "$_h $GA_SERVICES_IP"
    done
    if [ -n "${GA_OTA_HOST:-}" ] && [ -n "$OTA_IP" ]; then
        echo "$GA_OTA_HOST $OTA_IP"
    fi
    return 0
}

sup_running() {
    [ "$(docker inspect -f '{{.State.Running}}' "$SUP_CONTAINER" 2>/dev/null)" = "true" ]
}

# Returns 0 only if the RUNNING container reads the GA-managed file and every
# GA name resolves, from inside the container, to the configured address.
# Every failed condition is reported, not just the first one.
verify_supervisor() {
    _ok=0
    _src=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/hosts"}}{{.Source}}{{end}}{{end}}' "$SUP_CONTAINER" 2>/dev/null) || _src=""
    if [ "$_src" != "$SUP_HOSTS_FILE" ]; then
        err "$SUP_CONTAINER does not mount $SUP_HOSTS_FILE at /etc/hosts (mount source: '${_src:-none}') — the container was created by a launcher without the GA hosts mount; restart hassos-supervisor.service to recreate it"
        _ok=1
    fi
    _in=$(docker exec "$SUP_CONTAINER" cat /etc/hosts 2>&1) || {
        err "cannot read /etc/hosts inside $SUP_CONTAINER: $_in"
        _in=""
        _ok=1
    }
    _pairs=$(expected_pairs)
    if [ -z "$_pairs" ]; then
        err "no GA host names configured — nothing to verify is a failure, not a pass"
        return 1
    fi
    _n=0
    while read -r _name _ip; do
        [ -n "$_name" ] || continue
        _n=$((_n + 1))
        if ! printf '%s\n' "$_in" | awk -v ip="$_ip" -v h="$_name" '
                $1 == ip { for (i = 2; i <= NF; i++) if ($i == h) f = 1 }
                END { exit !f }'; then
            err "$SUP_CONTAINER /etc/hosts has no '$_ip $_name' entry"
            _ok=1
        fi
        # Resolve with the Supervisor's own runtime (Python, the libc resolver
        # it uses for every HTTP request), not with a tool it never calls.
        _got=$(docker exec "$SUP_CONTAINER" python3 -c \
            'import socket, sys; print(socket.gethostbyname(sys.argv[1]))' "$_name" 2>&1) || _got="lookup failed: $_got"
        if [ "$_got" != "$_ip" ]; then
            err "$_name resolves to '$_got' inside $SUP_CONTAINER, expected $_ip (the mesh address from ga-services.conf)"
            _ok=1
        fi
    done <<EOF_PAIRS
$_pairs
EOF_PAIRS
    if [ "$_ok" = 0 ]; then
        echo "ga-update-hosts: verified $SUP_CONTAINER — $_n GA names resolve to their configured addresses"
    fi
    return "$_ok"
}

if [ "$MODE" = "verify" ]; then
    _deadline=$(( $(date +%s) + SUP_WAIT_S ))
    until sup_running; do
        if [ "$(date +%s)" -ge "$_deadline" ]; then
            err "$SUP_CONTAINER not running after ${SUP_WAIT_S}s — cannot verify its name resolution"
            exit 1
        fi
        sleep 5
    done
    verify_supervisor || exit 1
    exit 0
fi

# Read the last-applied services IP (persists across reboots) to decide later
# whether the endpoint changed and clients need a bounce.
PREV_SERVICES_IP=""
[ -f "$APPLIED_IP_FILE" ] && PREV_SERVICES_IP=$(tr -d '[:space:]' < "$APPLIED_IP_FILE" 2>/dev/null || true)

# Build new content in memory, then truncate-write the file in-place.
# Preserve any existing non-GA content (localhost, hostname pin, etc.).
PRESERVED=""
if [ -f "$HOSTS_FILE" ]; then
    PRESERVED=$(awk -v m="$MARKER" -v e="$END_MARKER" '
        $0 == m { skip=1; next }
        $0 == e { skip=0; next }
        !skip   { print }
    ' "$HOSTS_FILE")
else
    PRESERVED='127.0.0.1	localhost
::1		localhost ip6-localhost ip6-loopback
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters'
    echo "ga-update-hosts: creating base hosts file"
fi

# Self-clean: drop ANY pre-existing line for a GA-managed hostname (and the
# legacy header), not just this script's marker block. Older builds wrote
# un-markered entries; on an endpoint change those would linger and, being
# first in /etc/hosts, win the files lookup — pinning clients to the OLD IP.
# The fresh managed block below re-adds the correct entries.
PRESERVED=$(printf '%s\n' "$PRESERVED" | grep -vF "$LEGACY_COMMENT" || true)
for _h in "${GA_INFLUX_HOST:-}" "${GA_LOKI_HOST:-}" "${GA_OTA_HOST:-}" "${GA_FLEET_HOST:-}"; do
    [ -n "$_h" ] && PRESERVED=$(printf '%s\n' "$PRESERVED" | grep -vF "$_h" || true)
done

# Strip trailing blank lines from preserved section
PRESERVED=$(printf '%s\n' "$PRESERVED" | awk 'NF{c=NR} {a[NR]=$0} END{for(i=1;i<=c;i++)print a[i]}')

NEW_CONTENT="$PRESERVED

$MARKER
$GA_HOSTS_LINE"
if [ -n "${GA_OTA_HOST:-}" ] && [ -n "$OTA_IP" ]; then
    NEW_CONTENT="$NEW_CONTENT
$OTA_IP $GA_OTA_HOST"
fi
NEW_CONTENT="$NEW_CONTENT
$END_MARKER"

# In-place truncate-write — preserves bind-mount inode. Do NOT use sed -i,
# cp -f, or mv (all rename-based) on this file.
printf '%s\n' "$NEW_CONTENT" > "$HOSTS_FILE"

echo "ga-update-hosts: wrote ${GA_HOSTS_LINE} to $HOSTS_FILE"
[ -n "${GA_OTA_HOST:-}" ] && [ -n "$OTA_IP" ] && \
    echo "ga-update-hosts: wrote ${OTA_IP} ${GA_OTA_HOST} to $HOSTS_FILE"

if getent hosts "${GA_INFLUX_HOST:-influx.greenautarky.com}" >/dev/null 2>&1; then
    echo "ga-update-hosts: verification OK — ${GA_INFLUX_HOST} resolves"
else
    echo "ga-update-hosts: WARNING — ${GA_INFLUX_HOST} does not resolve yet (may need overlay mount)"
fi

# Supervisor container: rewrite its host-managed /etc/hosts in place (see the
# block comment above verify_supervisor), then prove the container sees it.
SUP_BASE='127.0.0.1	localhost
::1		localhost ip6-localhost ip6-loopback
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters'
SUP_CONTENT="$SUP_BASE

$MARKER
$GA_HOSTS_LINE"
if [ -n "${GA_OTA_HOST:-}" ] && [ -n "$OTA_IP" ]; then
    SUP_CONTENT="$SUP_CONTENT
$OTA_IP $GA_OTA_HOST"
fi
SUP_CONTENT="$SUP_CONTENT
$END_MARKER"

SUP_FAILED=0
if [ -L "$SUP_HOSTS_FILE" ] || { [ -e "$SUP_HOSTS_FILE" ] && [ ! -f "$SUP_HOSTS_FILE" ]; }; then
    err "$SUP_HOSTS_FILE is not a regular file — refusing to write through it; the Supervisor keeps resolving GA names without the mesh entries"
    SUP_FAILED=1
elif ! printf '%s\n' "$SUP_CONTENT" > "$SUP_HOSTS_FILE"; then
    # In-place truncate-write, never rename: the bind mount pins the inode.
    err "cannot write $SUP_HOSTS_FILE — the Supervisor keeps resolving GA names without the mesh entries"
    SUP_FAILED=1
else
    echo "ga-update-hosts: wrote GA entries to $SUP_HOSTS_FILE (the Supervisor container's /etc/hosts)"
fi

if [ "$SUP_FAILED" = 0 ]; then
    if sup_running; then
        verify_supervisor || SUP_FAILED=1
    else
        # Not a pass: the container reads the file when it starts, and
        # ga-supervisor-hosts-check.service verifies it once it runs.
        echo "ga-update-hosts: $SUP_CONTAINER not running — verification deferred to ga-supervisor-hosts-check.service"
    fi
fi

# ---------------------------------------------------------------------------
# Persist the applied services IP and bounce endpoint-bound clients on change.
#
# Long-lived clients (fluent-bit, telegraf) resolve the GA endpoint once at
# start and hold the connection, so a cutover to a new backend IP would not
# take effect until they happen to reconnect (or the device reboots). When the
# services IP differs from the last-applied value we restart them so they
# re-resolve immediately. First run (no prior record) does NOT bounce — a fresh
# start already resolves the current IP.
# ---------------------------------------------------------------------------
if [ -n "$PREV_SERVICES_IP" ] && [ "$PREV_SERVICES_IP" != "$GA_SERVICES_IP" ]; then
    echo "ga-update-hosts: services IP changed ${PREV_SERVICES_IP} -> ${GA_SERVICES_IP}; bouncing endpoint-bound clients"
    for _svc in $ENDPOINT_BOUND_SERVICES; do
        if systemctl cat "$_svc" >/dev/null 2>&1; then
            systemctl try-restart --no-block "$_svc" >/dev/null 2>&1 || true
            echo "ga-update-hosts: try-restart $_svc"
        fi
    done
fi
# Record the now-applied IP (best effort; /mnt/data may be unmounted very early).
printf '%s\n' "$GA_SERVICES_IP" > "$APPLIED_IP_FILE" 2>/dev/null || true

if [ "$SUP_FAILED" != 0 ]; then
    err "the Supervisor container does not resolve the GA names to their mesh addresses (see above)"
    exit 1
fi
