#!/bin/sh
# ga-wlan0-powersave-assert — assert WiFi powersave is OFF on the dongle hop.
#
# The shipped OpenStick auto-connect profile sets `wifi.powersave 2` (disable),
# because on the Realtek RTW88 chip leaving LPS on makes the AP queue ARP
# replies during sleep windows; the station misses them and no IP traffic flows
# though the link looks associated (the dongle hop's own flapping cause, KB230).
# But "disabled, by whom unclear" — a profile edit or a driver default could
# silently re-enable it. This boot oneshot ASSERTS the state and repairs it
# on the active wlan0 connection if it drifted (without re-activating it), logging loudly either way
# (a path that only runs on the event it reports is unverified — rule 53 — so
# it logs the observed value every boot, not only on a fix).
#
# POSIX /bin/sh. Test hook: GA_PSAVE_TEST=1 sources without acting; nmcli is
# overridable.
set -u

IFACE="${GA_PSAVE_IFACE:-wlan0}"
NMCLI="${GA_PSAVE_NMCLI:-nmcli}"
IW="${GA_PSAVE_IW:-iw}"
NMBIN="${GA_PSAVE_NM:-NetworkManager}"
WAIT_S="${GA_PSAVE_WAIT:-30}"
LOG_TAG="ga-wlan0-powersave-assert"
_log() { logger -t "$LOG_TAG" -p "daemon.$1" "$2" 2>/dev/null || echo "$LOG_TAG: $2" >&2; }

# The connection name active on IFACE, or empty.
active_conn() {
    $NMCLI -t -f NAME,DEVICE connection show --active 2>/dev/null \
      | awk -F: -v d="$IFACE" '$2==d {print $1; exit}'
}

# The 802-11-wireless.powersave value of a connection (raw nmcli word).
conn_powersave() {
    $NMCLI -t -f 802-11-wireless.powersave connection show "$1" 2>/dev/null \
      | sed 's/^802-11-wireless.powersave://'
}

# Activation state of a connection (nmcli word: activated, activating, ...).
conn_state() {
    $NMCLI -t -g GENERAL.STATE connection show "$1" 2>/dev/null | head -n 1
}

# The global default NM applies when the profile says "default": the first
# wifi.powersave in a [connection*] section of the merged config (conf.d
# 50-ga.conf sets 2). Empty if unset/unreadable.
global_powersave() {
    $NMBIN --print-config 2>/dev/null | awk -v iface="$IFACE" '
        function flush() {
            if (sec ~ /^\[connection/ && have && !done) {
                # applies to wlan0 if no match-device, or it names type:wifi / our ifname
                if (md == "" || md ~ /type:wifi/ || md ~ ("interface-name:" iface) || md == iface || md == "*") {
                    if (sec == "[connection]") last = val; else if (first == "") first = val
                }
            }
            have = 0; md = ""; val = ""
        }
        /^\[/ { flush(); sec = $0; next }
        /^match-device[ ]*=/ { sub(/^[^=]*=[ ]*/, ""); md = $0; next }
        /^wifi.powersave[ ]*=/ { sub(/^[^=]*=[ ]*/, ""); val = $0; have = 1; next }
        END { flush(); if (first != "") print first; else if (last != "") print last }'
}

# Runtime truth from the driver: "off" | "on" | "" (unknown). Not the profile.
have_iw() { command -v "$IW" >/dev/null 2>&1; }
runtime_powersave() {
    have_iw || return 0
    $IW dev "$IFACE" get power_save 2>/dev/null | awk '/Power save:/ {print $3; exit}'
}

# assert: read the active conn's powersave; 2 = disabled = correct. Echoes
# ok|fixed|fix-failed|pending-next-activation|deferred|no-conn. "fixed" = set
# succeeded AND the re-read state is off; fix-failed = set failed or re-read not off.
#
# NEVER `connection up` / re-activate here. NetworkManager 1.50 cannot reapply
# 802-11-wireless.powersave on a live link (nm-device-wifi.c can_reapply_change
# whitelists only seen-bssids, mtu, wake-on-wlan), so a re-activation is a
# deauth + reconnect — and on a fresh-flash first boot, ~13 s after the first
# association, it raced the openstick auto-connect scan (measured). Instead:
#   * profile 2                          -> ok
#   * profile "default" (0): the EFFECTIVE value is the global default; if that is
#     2 (50-ga.conf) -> ok, no action (this was a standing false positive). If
#     the global is unreadable, a driver reporting power save off is also ok.
#   * connection still activating        -> wait a bounded time; if it is still
#                                           activating, defer (do not touch it)
#   * otherwise: persist 2 in the profile (takes effect at the next activation)
#     and switch the driver off right now with `iw ... set power_save off`,
#     which does not drop the link.
assert_once() {
    _c="$(active_conn)"
    if [ -z "$_c" ]; then
        _log info "no active connection on $IFACE — nothing to assert (no dongle hop up)"
        echo no-conn; return
    fi
    _w=0
    while [ "$(conn_state "$_c")" = "activating" ] && [ "$_w" -lt "$WAIT_S" ]; do
        sleep 2; _w=$((_w + 2))
    done
    if [ "$(conn_state "$_c")" = "activating" ]; then
        _log warning "'$_c' is still activating after ${WAIT_S}s — not touching it (no re-activation); powersave left unchecked this boot"
        echo deferred; return
    fi
    _ps="$(conn_powersave "$_c")"
    if [ "$_ps" = "2" ]; then
        _log info "$IFACE powersave is disabled (802-11-wireless.powersave=2) on '$_c' — as intended"
        echo ok; return
    fi
    case "$_ps" in
        0|default|"0 (default)"|"default (0)")
            # EFFECTIVE value = profile value, falling back to the global default.
            _g="$(global_powersave)"
            if [ -z "$_g" ]; then
                _log err "cannot read the global wifi.powersave from '$NMBIN --print-config' (empty/unparseable) — cannot prove the effective value, falling back to the driver state"
            fi
            if [ "$_g" = "2" ]; then
                _log info "$IFACE powersave profile value is default; the global [connection-wifi-defaults] wifi.powersave=2 is the effective value on '$_c' — as intended, no action"
                echo ok; return
            fi
            if [ "$(runtime_powersave)" = "off" ]; then
                _log info "$IFACE powersave profile value is default but the driver reports power save off (conf.d default 2) on '$_c' — as intended"
                echo ok; return
            fi ;;
    esac
    $NMCLI connection modify "$_c" 802-11-wireless.powersave 2 2>/dev/null || true
    if have_iw; then
        _log warning "$IFACE powersave is '$_ps' on '$_c' (expected 2=disabled) — persisted 2 and switched the driver off without re-activating; RTW88 with LPS on flaps on its own"
        # Check the status: a failed `iw set power_save off` must NOT be reported as
        # "fixed" (Odoo #1572). The profile is persisted either way, so the next
        # activation applies it; the live link keeps its old power-save until then.
        # "fixed" only after the effective state was RE-READ post-set and is off.
        if _iwerr="$($IW dev "$IFACE" set power_save off 2>&1)"; then
            _after="$(runtime_powersave)"
            if [ "$_after" = "off" ]; then
                echo fixed
            else
                _log err "'$IW dev $IFACE set power_save off' returned 0 but the re-read state is '${_after:-unreadable}', not off — NOT fixed live; profile persisted, takes effect at next activation"
                echo fix-failed
            fi
        else
            _iwrc=$?
            _log err "'$IW dev $IFACE set power_save off' FAILED (exit $_iwrc: ${_iwerr:-no output}) — profile persisted, but the driver is NOT switched off live; takes effect at next activation"
            echo fix-failed
        fi
    else
        _log warning "$IFACE powersave is '$_ps' on '$_c' (expected 2=disabled) — persisted 2 but live disable unavailable ('$IW' not installed): takes effect at next activation"
        echo pending-next-activation
    fi
}

if [ -z "${GA_PSAVE_TEST:-}" ]; then
    _st="$(assert_once)"
    echo "$_st"
    # Status file for readers; fix-failed also fails the unit (systemctl --failed).
    { echo "$_st" > "${GA_PSAVE_STATUS:-/run/ga-wlan0-powersave-assert.status}"; } 2>/dev/null || true
    [ "$_st" = fix-failed ] && exit 1
    exit 0
fi
