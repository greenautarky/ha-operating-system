#!/bin/sh
# ga-manage-ethernet — enable/disable the Ethernet interface via NetworkManager
#
# Usage:
#   ga-manage-ethernet enable     # persist "on"  + bring eth0 up now
#   ga-manage-ethernet disable    # persist "off" + take eth0 down now
#   ga-manage-ethernet status     # print current state
#   ga-manage-ethernet apply      # reconcile from persisted state (systemd, boot)
#   ga-manage-ethernet retire     # delete the flash-time override, link untouched
#
# STATE — absent is OFF
#
#   GA_ETHERNET_ENABLED=true in /mnt/data/ga-env.conf turns the interface on.
#   Anything else — key absent, file absent, garbled — means OFF.
#
#   This is the inverse of the previous GA_ETHERNET_DISABLED key. That one made
#   "absent" mean ON, so a device that missed provisioning, was flashed by hand,
#   or had its data partition wiped came up with the interface live. The safe
#   state must not depend on a tool having run.
#
# OVERRIDE — two markers, two different authorisations
#
#   /mnt/boot/ga-ethernet-force        SHIPPED ON BY DEFAULT since 2026-07-30
#                                      (operator decision): provisioning runs
#                                      over Ethernet, not WiFi, and a cable
#                                      beats a WLAN per bench. The image build
#                                      writes it (board hassos-hook.sh).
#                                      An earlier version of this comment said
#                                      "physical access IS the authorisation —
#                                      whoever set this had the card in a
#                                      reader". That stopped being true the
#                                      moment the image started carrying it, so
#                                      it is corrected rather than left to
#                                      mislead: presence now proves only that
#                                      this is a factory image.
#                                      The consequence is that the safety moved
#                                      from the marker's origin to a REMOVAL
#                                      STEP. That step used to be a sentence in
#                                      a comment and nothing executed it: no
#                                      stage in the provisioner and no check in
#                                      provision-verify ever mentioned this file
#                                      (measured against origin, 2026-09-08),
#                                      so every unit built since 2026-07-30
#                                      shipped with the override live. It is now
#                                      a mechanism: ga-ethernet-retire.path fires
#                                      `retire` below the moment ga_manager
#                                      writes its converged marker, and
#                                      tests/ga_tests/ethernet_force is the exit
#                                      gate. That gate reads this script's own
#                                      status file, not just the filesystem,
#                                      because deleting the file changes nothing
#                                      until the device reboots.
#                                      Still honoured in every environment
#                                      including production: refusing it would
#                                      block the on-site case without preventing
#                                      anything, and it is scoped to the one
#                                      device whose card carries it.
#
#   <ga_manager addon /data>/          settable remotely via ga_manager, so it is
#     ga-ethernet-force                the one that could silently override many
#                                      devices at once. Honoured in production
#                                      too — offices where we run the onboarding
#                                      on the customer's behalf and Ethernet is
#                                      the only uplink need exactly this — but
#                                      only if the file CONTAINS THIS DEVICE'S
#                                      OWN LABEL. A marker broadcast fleet-wide
#                                      therefore does nothing, and the operator
#                                      has to act per device.
#
#                                      NOT in /share: that bridge is writable
#                                      by every add-on declaring `share:rw`
#                                      (three installed today, all ours — but
#                                      the customer can add to that set), so
#                                      any of them could flip the device's
#                                      network exposure. The add-on's
#                                      private /data dir is writable by
#                                      ga_manager alone and readable from the
#                                      host — the same channel the per-device
#                                      Loki credential already travels
#                                      (ga-fluent-bit-env reads
#                                      addons/data/*_ga_manager/ga-fleet-loki.yaml).
#                                      The slug prefix differs per device, hence
#                                      the glob.
#
#   The device-bound check needs /mnt/data/ga-device-label to exist. If it does
#   not, the remote override is refused — a device that cannot say who it is
#   must not accept an instruction addressed to a name.
#
# Re-enable remotely: ssh -p 22222 root@<mesh-ip> 'ga-manage-ethernet enable'
set -e

GA_ENV_FILE="/mnt/data/ga-env.conf"
SHARE_DIR="/mnt/data/supervisor/share"
STATUS_FILE="$SHARE_DIR/ga-ethernet-status.json"
FORCE_BOOT="/mnt/boot/ga-ethernet-force"
CONVERGED_MARKER="$SHARE_DIR/.ga_converged"
ADDON_DATA_GLOB="/mnt/data/supervisor/addons/data/*_ga_manager"
LABEL_FILE="/mnt/data/ga-device-label"
LEGACY_KEY="GA_ETHERNET_DISABLED"
ETH_IFACE="eth0"

# Find the NM connection name for eth0 (active or inactive)
find_eth_connection() {
  conn=$(nmcli -t -f NAME,DEVICE connection show 2>/dev/null | grep ":${ETH_IFACE}$" | head -1 | cut -d: -f1)
  if [ -n "$conn" ]; then
    echo "$conn"
    return
  fi
  nmcli -t -f NAME,TYPE connection show 2>/dev/null | grep ':802-3-ethernet$' | head -1 | cut -d: -f1
}

is_eth_connected() {
  nmcli -t -f DEVICE,STATE device status 2>/dev/null | grep -q "^${ETH_IFACE}:connected"
}

is_enabled_flag() {
  [ -f "$GA_ENV_FILE" ] && grep -q "^GA_ETHERNET_ENABLED=true" "$GA_ENV_FILE" 2>/dev/null
}

set_enabled() { # $1 = true|false
  if [ ! -f "$GA_ENV_FILE" ]; then
    echo "GA_ETHERNET_ENABLED=$1" > "$GA_ENV_FILE"
    return
  fi
  if grep -q "^GA_ETHERNET_ENABLED=" "$GA_ENV_FILE" 2>/dev/null; then
    sed -i "s/^GA_ETHERNET_ENABLED=.*/GA_ETHERNET_ENABLED=$1/" "$GA_ENV_FILE"
  else
    echo "GA_ETHERNET_ENABLED=$1" >> "$GA_ENV_FILE"
  fi
  # The old key would be read by nothing now; drop it so a device does not
  # carry two contradictory statements about the same thing.
  sed -i "/^${LEGACY_KEY}=/d" "$GA_ENV_FILE" 2>/dev/null || true
}

# --- override gate ---------------------------------------------------------
# Echoes the override source, or nothing.
override_source() {
  # Physical marker: authorised by presence, scoped to this one device.
  if [ -e "$FORCE_BOOT" ]; then
    echo "force-boot"
    return 0
  fi

  # Remote marker lives in ga_manager's addon-private /data, not in /share.
  # The slug prefix varies per device, so resolve the glob and take the first
  # readable hit.
  _remote=""
  for _d in $ADDON_DATA_GLOB; do
    [ -r "$_d/ga-ethernet-force" ] && { _remote="$_d/ga-ethernet-force"; break; }
  done
  [ -n "$_remote" ] || return 0

  # Must name THIS device, so a fleet-wide copy is inert.
  _label=""
  [ -r "$LABEL_FILE" ] && _label=$(tr -d ' \t\n\r' < "$LABEL_FILE")
  if [ -z "$_label" ]; then
    echo "ga-manage-ethernet: remote force marker present but this device has no label — refusing" >&2
    return 0
  fi
  if ! grep -qF "$_label" "$_remote" 2>/dev/null; then
    echo "ga-manage-ethernet: remote force marker does not name $_label — refusing" >&2
    return 0
  fi

  echo "force-config"
}

# --- status ----------------------------------------------------------------
# link_state is deliberately "unknown" while the interface is down: the carrier
# file is unreadable then (EINVAL), so we must not claim to know whether a cable
# is plugged in.
write_status() { # $1 = enabled(true/false) $2 = source
  [ -d "$SHARE_DIR" ] || return 0
  _link="unknown"
  if [ "$(cat "/sys/class/net/${ETH_IFACE}/operstate" 2>/dev/null)" = "up" ]; then
    _link=$(tr -d '\n' < "/sys/class/net/${ETH_IFACE}/carrier" 2>/dev/null)
    case "$_link" in 1) _link="carrier" ;; 0) _link="no-carrier" ;; *) _link="unknown" ;; esac
  fi
  # The flash-time override is reported SEPARATELY from `source` on purpose.
  # `source` is what the RUNNING interface rides on; `boot_marker` is what is
  # on the card. After a retire they legitimately disagree — the file is gone
  # and the link is still up because nothing reboots the device to re-read it —
  # and collapsing the two into one field is what would make the shipping gate
  # green while the running system is still forced. Two claims, two fields.
  _marker="absent"
  [ -e "$FORCE_BOOT" ] && _marker="present"
  tmp="$STATUS_FILE.tmp.$$"
  cat > "$tmp" <<EOF
{
  "schema_version": 2,
  "enabled": $1,
  "source": "$2",
  "boot_marker": "$_marker",
  "link_state": "$_link",
  "interface": "$ETH_IFACE"
}
EOF
  mv -f "$tmp" "$STATUS_FILE" 2>/dev/null || rm -f "$tmp"
}

# --- actions ---------------------------------------------------------------
link_down() {
  CONN=$(find_eth_connection)
  if [ -n "$CONN" ]; then
    nmcli connection modify "$CONN" connection.autoconnect no 2>/dev/null || true
    nmcli connection down "$CONN" 2>/dev/null || true
  fi
  # Always finish with the interface administratively down. Without this the
  # NM path and the no-profile path meant two different things: `connection
  # down` can leave the link up (carrier asserted, L2 reachable, just no IP).
  ip link set "$ETH_IFACE" down 2>/dev/null || true
}

link_up() {
  CONN=$(find_eth_connection)
  ip link set "$ETH_IFACE" up 2>/dev/null || true
  if [ -n "$CONN" ]; then
    nmcli connection modify "$CONN" connection.autoconnect yes 2>/dev/null || true
    # Activate now only when there is a link. Without carrier the explicit
    # `up` fails at once and, with unbounded retries, fed the storm behind
    # Odoo #753. autoconnect=yes is enough: NetworkManager activates the
    # profile itself the moment the carrier appears.
    if [ "$(cat "/sys/class/net/${ETH_IFACE}/carrier" 2>/dev/null)" = "1" ]; then
      nmcli connection up "$CONN" 2>/dev/null || true
    else
      echo "ga-manage-ethernet: no carrier on $ETH_IFACE — profile armed (autoconnect), not activated"
    fi
  fi
  # NetworkManager activates asynchronously. Without this wait the status file
  # written straight afterwards reads operstate as still down and reports
  # link_state "unknown" on every enable — a status that is wrong more often
  # than it is right. Bounded, and we proceed regardless if it never settles.
  _i=0
  while [ "$_i" -lt 10 ]; do
    [ "$(cat "/sys/class/net/${ETH_IFACE}/operstate" 2>/dev/null)" = "up" ] && break
    _i=$((_i + 1))
    sleep 1
  done
}

do_disable() {
  echo "Disabling Ethernet on $ETH_IFACE"
  link_down
  set_enabled false
  write_status false onboarding
  echo "Ethernet disabled (GA_ETHERNET_ENABLED=false)"
}

do_enable() {
  echo "Enabling Ethernet on $ETH_IFACE"
  link_up
  set_enabled true
  write_status true onboarding
  echo "Ethernet enabled (GA_ETHERNET_ENABLED=true)"
}

do_status() {
  src=$(override_source)
  if [ -n "$src" ]; then eff=true; else
    if is_enabled_flag; then eff=true; src=onboarding; else eff=false; src=default; fi
  fi
  echo "ethernet_enabled=${eff}"
  echo "ethernet_source=${src}"
  echo "ethernet_state=$(is_eth_connected && echo connected || echo disconnected)"
  echo "ethernet_connection=$(find_eth_connection || echo none)"
  echo "ethernet_operstate=$(cat "/sys/class/net/${ETH_IFACE}/operstate" 2>/dev/null || echo unknown)"
}

# Read one key back out of the status file we last wrote. Used by `retire`,
# which must NOT recompute the running state: the interface it describes is
# still up on an override that has just been deleted from the card, so
# recomputing would report the post-reboot state as if it were the current one.
prior_status() { # $1 = key
  [ -f "$STATUS_FILE" ] || return 0
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",]*\)\"\{0,1\},\{0,1\}.*/\\1/p" \
    "$STATUS_FILE" | head -1 | tr -d ' \t'
}

# --- retire ----------------------------------------------------------------
# Delete the flash-time override from the boot partition. The RUNNING interface
# is deliberately left alone.
#
# WHY THIS EXISTS. The boot marker is a BOOTSTRAP credential: it is shipped in
# the image so that provisioning can run over a cable before the device has an
# identity or any fleet configuration. Once ga_manager has converged, the
# fleet-manager owns this switch (`ethernet.force_enabled` -> the addon-private
# /data marker), so the bootstrap one has done its job. Letting it outlive that
# job is Odoo #750 — every unit that ever shipped forces eth0 up forever — and
# it is what makes Odoo #753 reachable, where a link-less eth0 has
# NetworkManager retry ~15/s until the Supervisor's D-Bus loop sits at 100%.
#
# WHY THE HOST AND NOT THE PROVISIONER. Nothing else can. The ga_manager
# container maps /share, /data, /homeassistant and all_addon_configs and
# nothing else, so /mnt/boot is invisible from inside it; and ga-provision.sh
# holds no per-device credentials and no SSH by design. The host is the only
# actor with the file in reach.
#
# WHY THE LINK IS NOT TOUCHED. The device is provisioned over Ethernet and is
# still using it — for the fleet-manager, for the add-on pulls, for the
# customer account. Applying the post-retire state here would cut the uplink at
# the exact moment the provisioner has to confirm the retire worked, over that
# same uplink. The interface therefore keeps running on the override until the
# next boot, which is the truth this reports rather than hides: `boot_marker`
# goes to "absent", `source` stays whatever the running state actually rides
# on. tests/ga_tests/ethernet_force keeps both claims apart for the same reason.
do_retire() {
  if [ -e "$FORCE_BOOT" ]; then
    rm -f "$FORCE_BOOT"
    if [ -e "$FORCE_BOOT" ]; then
      echo "ga-manage-ethernet: FAILED to remove $FORCE_BOOT" >&2
      exit 1
    fi
    echo "retired the flash-time override $FORCE_BOOT (link untouched; effective until next boot)"
  else
    echo "no flash-time override present ($FORCE_BOOT) — nothing to retire"
  fi

  # Re-publish the status so the removal is visible to the fleet without
  # waiting for a reboot. Preserve the running state verbatim; only the
  # marker claim changes.
  _en=$(prior_status enabled)
  _src=$(prior_status source)
  case "$_en" in true|false) ;; *) _en=false; [ "$(cat "/sys/class/net/${ETH_IFACE}/operstate" 2>/dev/null)" = "up" ] && _en=true ;; esac
  [ -n "$_src" ] || _src=unknown
  write_status "$_en" "$_src"
}

do_apply() {
  # One-time carry-over. A device upgrading from the old GA_ETHERNET_DISABLED
  # scheme has no GA_ETHERNET_ENABLED key, which under the new rule means OFF —
  # so an OTA would silently take a working uplink down. If the old key is
  # absent (= was enabled) and the link is currently up, record that intent
  # once instead of reversing it behind the operator's back.
  if [ -f "$GA_ENV_FILE" ] \
     && ! grep -q "^GA_ETHERNET_ENABLED=" "$GA_ENV_FILE" 2>/dev/null \
     && ! grep -q "^${LEGACY_KEY}=true" "$GA_ENV_FILE" 2>/dev/null \
     && [ "$(cat "/sys/class/net/${ETH_IFACE}/operstate" 2>/dev/null)" = "up" ]; then
    echo "carrying over pre-upgrade state: interface is up, recording GA_ETHERNET_ENABLED=true"
    set_enabled true
  fi

  src=$(override_source)
  if [ -n "$src" ]; then
    echo "override active ($src) — enabling Ethernet"
    link_up
    write_status true "$src"
    return
  fi

  if is_enabled_flag; then
    echo "GA_ETHERNET_ENABLED=true — enabling Ethernet"
    link_up
    write_status true onboarding
  else
    echo "no enable flag — keeping Ethernet down"
    link_down
    write_status false default
  fi
}

case "${1:-}" in
  disable) do_disable ;;
  enable)  do_enable ;;
  status)  do_status ;;
  apply)   do_apply ;;
  retire)  do_retire ;;
  *)
    echo "Usage: ga-manage-ethernet {disable|enable|status|apply|retire}"
    exit 1
    ;;
esac
