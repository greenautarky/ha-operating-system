#!/bin/sh
# ga-firewall-gate — load an nftables ruleset that exposes only SSH and the
# Home Assistant UI on the customer LAN, and keeps everything else reachable
# over the NetBird mesh / Tailscale only.
#
# DEFAULT ON. The firewall is the shipped posture; it is not something a
# provisioning tool has to switch on. Absent state is the SAFE state:
#
#   * No marker at all            → firewall ACTIVE (this is the normal case).
#   * /mnt/boot/ga-firewall-off   → firewall OFF. Operator escape hatch on the
#                                   boot partition; survives a data-partition
#                                   wipe and is reachable from a card reader
#                                   when the device itself is not.
#
# Rationale for the inversion (was: default OFF, enable marker required):
# a device that missed a provisioning step, was flashed by hand, or whose data
# partition was wiped used to come up completely unfiltered. The security
# posture must not depend on a tool having run.
#
# SAFETY — this is the highest-blast-radius component in the image. A bad rule
# means a device in a customer home reachable only over the mesh, and if the
# mesh is also down, only over the serial console.
#
#   * HARD INVARIANT: loopback, the NetBird mesh (wt0) and Tailscale
#     (tailscale0) are accepted FIRST in every chain, hardcoded, never derived
#     from policy. The fleet-manager and GACI reach :8099 and HA Core (:80 on
#     Core 2026.8+, :8123 before) over the mesh.
#   * DEFAULT-DENY INGRESS (Odoo #1647): after the hardcoded trusted accepts
#     (lo, mesh, container bridges) and the LAN allowlist, EVERYTHING else
#     arriving on ANY interface is dropped — the modem uplink (ppp0 / wwan0 /
#     usb0 / whatever a board names it), a future NIC, a USB-Ethernet adapter.
#     The model is an allowlist of trusted interfaces, not a denylist of LAN
#     names, so an uplink nobody listed is closed rather than forgotten.
#     Outbound-initiated flows are unaffected (ct established,related).
#   * The chain policy stays `accept`. nft loads a file atomically, so the
#     table is either complete (final `drop` included) or absent — a truncated
#     ruleset cannot exist. Fail-closed (policy drop) would lock a device out
#     of its only management path if the table load or the mesh failed; for a
#     device in a customer home that is the worse failure. A load failure is
#     therefore fail-OPEN but LOUD: journal at err level plus status JSON
#     ruleset_loaded=false / source=load-failed (read by ga_manager's firewall
#     healthcheck).
#   * If `nft -f` fails the table is deleted, leaving the device as it was.
#
# INTERFACES (iHost defaults; a board names its own in /usr/share/ga-board.conf)
#   eth0    customer LAN — the only interface facing the household network.
#   wlan0   NOT household WiFi: the device joins the LTE dongle's own AP
#           (connection `openstick-auto`). Locked down identically — the stick
#           is single-purpose equipment, but it is not hardened, and nothing
#           needs to reach the device inbound over it.
#   wt0 / tailscale0   management mesh, always open.
#   hassio / docker0 / br-* / veth* / wpan0   container bridges and the local
#           Thread radio: internal, accepted (they must be, the table now ends
#           in a default drop).
#   anything else (ppp0, wwan0, usb0, ...)   uplink / unknown: dropped, except
#           replies to connections the device itself opened.
#
# HOST vs CONTAINER (Odoo #1610):
# Docker's PREROUTING DNAT rewrites a published container port before routing,
# so LAN traffic to a published port is DNAT'd FORWARD traffic and the `input`
# chain is not the deciding hook for it. Plain host ports and host-network HA
# Core do hit `input`, which carries the allowlist for them.
# The `forward` chain must match the ORIGINAL destination port
# (`ct original proto-dst`): the post-DNAT port also matches published
# container ports that map to 80/8123.
# `input` stays allowlisted for the host ports, both UI ports (:80 on Core
# 2026.8+, :8123 before — see CONTAINER_ALLOW_TCP).
#
# Consumer of the status file: ga_manager healthchecks/ga_specific.check_firewall
# reads /share/ga-firewall-status.json (= this file over the share map).
set -u

SHARE_DIR=/mnt/data/supervisor/share
STATUS_FILE="$SHARE_DIR/ga-firewall-status.json"
OFF_MARKER=/mnt/boot/ga-firewall-off
TABLE="inet ga_firewall"

# Physical interfaces the allowlist governs. Everything arriving here that is
# not explicitly allowed below is dropped. The names come from the board
# (/usr/share/ga-board.conf, GA_LAN_IFACES, space separated); a board without
# that file keeps the default below, so the iHost needs no file.
GA_BOARD_CONF="${GA_BOARD_CONF:-/usr/share/ga-board.conf}"
# shellcheck disable=SC1090
[ -r "$GA_BOARD_CONF" ] && . "$GA_BOARD_CONF"
LAN_IFACES=''
for _if in ${GA_LAN_IFACES:-eth0 wlan0}; do
	LAN_IFACES="${LAN_IFACES:+$LAN_IFACES, }\"$_if\""
done

# What stays reachable from those interfaces.
HOST_ALLOW_TCP='22222'          # sshd — on-site + local diagnostics
# Comma-separated ON PURPOSE: these expand into nft sets `{ ... }` and a JSON
# array below. A space instead of a comma yields `{ 22222, 80 8123 }`, which
# nft rejects — `nft -f` then deletes the table and the device ships
# UNFILTERED. :80 is the current HA Core default UI port; :8123 stays for the
# frozen 2025.11.3 armv7 Core and any explicit server_port. Same trust class.
CONTAINER_ALLOW_TCP='80, 8123'  # HA Core UI (resident's own front door)

log() { echo "ga-firewall-gate: $*"; }
# Loud variant for the fail-open path: reaches the journal at err priority.
log_err() { echo "ga-firewall-gate: $*"; logger -t ga-firewall-gate -p daemon.err "$*" 2>/dev/null || true; }

flush_table() {
	# Idempotent removal: `delete table` errors if absent, so probe first.
	# $TABLE is unquoted on purpose — "inet ga_firewall" has to reach nft as
	# two arguments (family + name), so the word split is the point.
	# shellcheck disable=SC2086
	if nft list table $TABLE >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		nft delete table $TABLE 2>/dev/null || true
	fi
}

# $1 = enabled(true/false) $2 = source $3 = ruleset_loaded(true/false)
# Published through ga-share-publish (staged outside the shared directory,
# renamed into place), never written in place.
write_status() {
	[ -d "$SHARE_DIR" ] || return 0
	/usr/libexec/ga-share-publish "$STATUS_FILE" 0644 <<EOF || return 0
{
  "schema_version": 2,
  "enabled": $1,
  "source": "$2",
  "ruleset_loaded": $3,
  "mode": "allowlist",
  "lan_open_tcp": [$HOST_ALLOW_TCP, $CONTAINER_ALLOW_TCP]
}
EOF
}

# --- resolve state ---------------------------------------------------------
if [ -e "$OFF_MARKER" ]; then
	flush_table
	log "disabled by $OFF_MARKER — no ruleset loaded"
	write_status false marker-off false
	exit 0
fi

if ! command -v nft >/dev/null 2>&1; then
	# Report honestly rather than silently pretending to be protected.
	log "nft not installed — firewall INERT, device is unfiltered"
	write_status false no-nft false
	exit 0
fi

# --- build ruleset ---------------------------------------------------------
RULES="$(mktemp /tmp/ga-firewall.XXXXXX)" || {
	log "mktemp failed"; write_status true default false; exit 0
}

{
	echo "table $TABLE {"

	echo "  chain input {"
	echo "    type filter hook input priority 0; policy accept;"
	echo "    iif \"lo\" accept"
	echo "    iifname { \"wt0\", \"tailscale0\" } accept"
	echo "    iifname { \"hassio\", \"docker0\", \"wpan0\" } accept"
	echo "    iifname \"br-*\" accept"
	echo "    iifname \"veth*\" accept"
	echo "    ct state established,related accept"
	# ICMPv6 neighbour/router discovery MUST pass or IPv6 stops working
	# entirely — no address resolution, and no router advertisement means no
	# default route. This is the classic way an inet-family ruleset silently
	# kills v6 while looking correct for v4.
	echo "    icmpv6 type { echo-request, echo-reply, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, time-exceeded, parameter-problem, destination-unreachable } accept"
	echo "    icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept"
	# DHCP/DHCPv6 client replies arrive before conntrack has a flow.
	echo "    udp sport 67 udp dport 68 accept"
	echo "    udp sport 547 udp dport 546 accept"
	# HA Core runs with host networking, so its UI ports (:80/:8123) arrive
	# HERE, next to the host port (sshd). Published container ports do NOT:
	# they are DNAT'd and filtered in `forward` by their ORIGINAL port.
	echo "    iifname { $LAN_IFACES } tcp dport { $HOST_ALLOW_TCP, $CONTAINER_ALLOW_TCP } accept"
	echo "    iifname { $LAN_IFACES } drop"
	# Default deny for every other interface (uplinks, unknown NICs).
	echo "    drop"
	echo "  }"

	echo "  chain forward {"
	echo "    type filter hook forward priority -5; policy accept;"
	echo "    iifname { \"wt0\", \"tailscale0\" } accept"
	echo "    iifname { \"hassio\", \"docker0\", \"wpan0\" } accept"
	echo "    iifname \"br-*\" accept"
	echo "    iifname \"veth*\" accept"
	echo "    ct state established,related accept"
	echo "    iifname { $LAN_IFACES } ct status dnat meta l4proto tcp ct original proto-dst { $CONTAINER_ALLOW_TCP } accept"
	echo "    iifname { $LAN_IFACES } ct status dnat drop"
	echo "    ct status dnat drop"
	echo "  }"

	echo "}"
} > "$RULES"

# Atomic load. On failure, delete the table so we never leave a half-applied
# ruleset that could lock the device out.
flush_table
if nft -f "$RULES" 2>/tmp/ga-firewall.err; then
	log "active (allowlist) — LAN open: tcp $HOST_ALLOW_TCP (host), tcp $CONTAINER_ALLOW_TCP (container)"
	write_status true default true
else
	log_err "nft load FAILED — firewall NOT active, device is UNFILTERED (fail-open): $(cat /tmp/ga-firewall.err 2>/dev/null)"
	flush_table
	write_status false load-failed false
fi
rm -f "$RULES" /tmp/ga-firewall.err
exit 0
