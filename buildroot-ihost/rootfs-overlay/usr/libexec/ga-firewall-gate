#!/bin/sh
# ga-firewall-gate — load an nftables ruleset that exposes only SSH and the
# Home Assistant UI on the customer LAN, and keeps everything else reachable
# over the NetBird mesh / Tailscale only.
#
# DEFAULT ON. The firewall is the shipped posture; it is not something a
# provisioning tool has to switch on. Absent state is the SAFE state:
#
#   * No marker at all            → firewall ACTIVE (this is the normal case).
#   * /mnt/boot/ga-firewall-off   → firewall OFF. Operator escape hatch on the
#                                   boot partition; survives a data-partition
#                                   wipe and is reachable from a card reader
#                                   when the device itself is not.
#
# Rationale for the inversion (was: default OFF, enable marker required):
# a device that missed a provisioning step, was flashed by hand, or whose data
# partition was wiped used to come up completely unfiltered. The security
# posture must not depend on a tool having run.
#
# SAFETY — this is the highest-blast-radius component in the image. A bad rule
# means a device in a customer home reachable only over the mesh, and if the
# mesh is also down, only over the serial console.
#
#   * HARD INVARIANT: loopback, the NetBird mesh (wt0) and Tailscale
#     (tailscale0) are accepted FIRST in every chain, hardcoded, never derived
#     from policy. The fleet-manager and GACI reach :8099/:8123 over the mesh.
#   * The drops are scoped to the PHYSICAL interfaces by name. The chain policy
#     stays `accept`, so a truncated or half-loaded ruleset fails OPEN rather
#     than locking the device out — and container traffic (hassio, docker0,
#     veth*) is untouched by construction rather than by an accept rule someone
#     might delete.
#   * If `nft -f` fails the table is deleted, leaving the device as it was.
#
# INTERFACES
#   eth0    customer LAN — the only interface facing the household network.
#   wlan0   NOT household WiFi: the device joins the LTE dongle's own AP
#           (connection `openstick-auto`). Locked down identically — the stick
#           is single-purpose equipment, but it is not hardened, and nothing
#           needs to reach the device inbound over it.
#   wt0 / tailscale0   management mesh, always open.
#   hassio / docker0 / veth*   container bridges, never filtered here.
#
# HOST vs CONTAINER: dropbear SSH (:22222) is a HOST process → `input` hook.
# HA Core (:8123), ga_manager (:8099), the Supervisor observer (:4357),
# Mosquitto and device-local InfluxDB are Docker containers with PUBLISHED
# ports → their inbound traffic is DNAT'd and traverses `forward`, NOT `input`.
# Both chains are therefore needed; an input-only filter silently misses every
# container port.
#
# Consumer of the status file: ga_manager healthchecks/ga_specific.check_firewall
# reads /share/ga-firewall-status.json (= this file over the share map).
set -u

SHARE_DIR=/mnt/data/supervisor/share
STATUS_FILE="$SHARE_DIR/ga-firewall-status.json"
OFF_MARKER=/mnt/boot/ga-firewall-off
TABLE="inet ga_firewall"

# Physical interfaces the allowlist governs. Everything arriving here that is
# not explicitly allowed below is dropped.
LAN_IFACES='"eth0", "wlan0"'

# What stays reachable from those interfaces.
HOST_ALLOW_TCP='22222'          # dropbear — on-site + local diagnostics
CONTAINER_ALLOW_TCP='8123'      # Home Assistant UI — the resident's own access

log() { echo "ga-firewall-gate: $*"; }

flush_table() {
	# Idempotent removal: `delete table` errors if absent, so probe first.
	# $TABLE is unquoted on purpose — "inet ga_firewall" has to reach nft as
	# two arguments (family + name), so the word split is the point.
	# shellcheck disable=SC2086
	if nft list table $TABLE >/dev/null 2>&1; then
		# shellcheck disable=SC2086
		nft delete table $TABLE 2>/dev/null || true
	fi
}

# $1 = enabled(true/false) $2 = source $3 = ruleset_loaded(true/false)
write_status() {
	[ -d "$SHARE_DIR" ] || return 0
	tmp="$STATUS_FILE.tmp.$$"
	cat > "$tmp" <<EOF
{
  "schema_version": 2,
  "enabled": $1,
  "source": "$2",
  "ruleset_loaded": $3,
  "mode": "allowlist",
  "lan_open_tcp": [$HOST_ALLOW_TCP, $CONTAINER_ALLOW_TCP]
}
EOF
	mv -f "$tmp" "$STATUS_FILE" 2>/dev/null || { rm -f "$tmp"; return 0; }
}

# --- resolve state ---------------------------------------------------------
if [ -e "$OFF_MARKER" ]; then
	flush_table
	log "disabled by $OFF_MARKER — no ruleset loaded"
	write_status false marker-off false
	exit 0
fi

if ! command -v nft >/dev/null 2>&1; then
	# Report honestly rather than silently pretending to be protected.
	log "nft not installed — firewall INERT, device is unfiltered"
	write_status false no-nft false
	exit 0
fi

# --- build ruleset ---------------------------------------------------------
RULES="$(mktemp /tmp/ga-firewall.XXXXXX)" || {
	log "mktemp failed"; write_status true default false; exit 0
}

{
	echo "table $TABLE {"

	echo "  chain input {"
	echo "    type filter hook input priority 0; policy accept;"
	echo "    iif \"lo\" accept"
	echo "    iifname { \"wt0\", \"tailscale0\" } accept"
	echo "    ct state established,related accept"
	# ICMPv6 neighbour/router discovery MUST pass or IPv6 stops working
	# entirely — no address resolution, and no router advertisement means no
	# default route. This is the classic way an inet-family ruleset silently
	# kills v6 while looking correct for v4.
	echo "    icmpv6 type { echo-request, echo-reply, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, time-exceeded, parameter-problem, destination-unreachable } accept"
	echo "    icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept"
	# DHCP/DHCPv6 client replies arrive before conntrack has a flow.
	echo "    udp sport 67 udp dport 68 accept"
	echo "    udp sport 547 udp dport 546 accept"
	echo "    iifname { $LAN_IFACES } tcp dport { $HOST_ALLOW_TCP } accept"
	echo "    iifname { $LAN_IFACES } drop"
	echo "  }"

	echo "  chain forward {"
	echo "    type filter hook forward priority -5; policy accept;"
	echo "    iifname { \"wt0\", \"tailscale0\" } accept"
	echo "    ct state established,related accept"
	echo "    iifname { $LAN_IFACES } ct status dnat tcp dport { $CONTAINER_ALLOW_TCP } accept"
	echo "    iifname { $LAN_IFACES } ct status dnat drop"
	echo "  }"

	echo "}"
} > "$RULES"

# Atomic load. On failure, delete the table so we never leave a half-applied
# ruleset that could lock the device out.
flush_table
if nft -f "$RULES" 2>/tmp/ga-firewall.err; then
	log "active (allowlist) — LAN open: tcp $HOST_ALLOW_TCP (host), tcp $CONTAINER_ALLOW_TCP (container)"
	write_status true default true
else
	log "nft load FAILED — flushing to fail-open: $(cat /tmp/ga-firewall.err 2>/dev/null)"
	flush_table
	write_status false load-failed false
fi
rm -f "$RULES" /tmp/ga-firewall.err
exit 0
