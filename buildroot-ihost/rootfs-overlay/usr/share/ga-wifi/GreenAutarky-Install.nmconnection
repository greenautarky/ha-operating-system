[connection]
id=GreenAutarky-Install
type=wifi
autoconnect=true
autoconnect-priority=-10

[wifi]
mode=infrastructure
ssid=GreenAutarky-Install
# 2 = disable power save (RTW88 flaps with LPS on). Set in the profile so the
# first association already has it; without it the profile says "default".
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=__WIFI_INSTALL_PSK__

[ipv4]
method=auto

[ipv6]
method=auto
