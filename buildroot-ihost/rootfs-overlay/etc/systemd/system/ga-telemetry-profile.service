[Unit]
# Applies the telemetry profile ga_manager selected (normal | minimal |
# lte_saver) to the log and metric shippers: runtime drop-ins under
# /run/systemd/system, so a reboot starts from the base units and this unit
# re-applies the profile before the shippers start. BOOT ONLY: a change of the
# request is applied by ga-telemetry-profile-runtime.service (see there why it
# must not be this unit). ADR-0045.
Description=Apply the telemetry profile to the log and metric shippers
Documentation=https://github.com/greenautarky/ga-ihost-docs/blob/main/adr/ADR-0045-telemetry-profiles-and-storage-writes.md
After=mnt-data.mount
Before=fluent-bit-tier0.service fluent-bit.service telegraf.service

[Service]
Type=oneshot
# --boot: never a blocking restart — this unit is ordered Before= the shippers,
# so a blocking `systemctl try-restart <shipper>` from here deadlocks.
ExecStart=/usr/sbin/ga-telemetry-profile-apply --boot
# A oneshot has no start timeout by default; never let it hold the shippers.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
