[Unit]
Description=GreenAutarky health-gated LTE standby route (seam S2 consumer)
Documentation=https://github.com/greenautarky/ga-ihost-docs/blob/main/adr/ADR-0025-health-gated-standby-uplink.md
After=network.target NetworkManager.service mnt-data.mount
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/ga-lte-standby-route
# Driven by the paired .timer (bounded poll). A single reconcile per tick:
# add the wlan0 default route while the verdict is usable+fresh, withdraw it
# (loudly) when it is not-usable / missing / stale.

# Runs every 30 s. At the default level every run put PID 1's "Starting",
# "Finished"/"Deactivated" and the script's routine info lines into the
# persistent journal on the SD card: systemd timer chatter was ~10 % of all
# journal entries on a bench device (Odoo #1225). Capped at notice: warnings
# and errors (the route withdrawal is logged at warning) still reach the journal and tier-0/tier-1, and a failed run
# still logs "Main process exited" (notice) and "Failed with result" (warning).
# Not kept: the plain stdout/stderr text of a run — run the script by hand to
# see it. Guarded by tests/gates/frequent_timer_loglevel.
LogLevelMax=notice
