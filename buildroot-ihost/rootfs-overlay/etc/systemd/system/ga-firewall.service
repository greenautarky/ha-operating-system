[Unit]
Description=Host firewall — LAN allowlist (SSH + HA UI), default ON
# The firewall is the shipped posture, not something a provisioning step has to
# switch on: absent state is the SAFE state. The only way to disable it is the
# explicit /mnt/boot/ga-firewall-off marker, which lives on the boot partition
# so it survives a data-partition wipe and can be set from a card reader when
# the device itself is unreachable. See ga-firewall-gate.
RequiresMountsFor=/mnt/data /mnt/boot
# After docker so the container `forward` chains exist before we add ours, and
# after the network is up so mesh/LAN interfaces are known. The nft rules match
# by interface NAME + port, so wt0 appearing later (netbird) is still handled.
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ga-firewall-gate
# Re-flush on stop so disabling/removing the unit reliably reopens the ports.
ExecStop=/bin/sh -c 'command -v nft >/dev/null 2>&1 && nft list table inet ga_firewall >/dev/null 2>&1 && nft delete table inet ga_firewall || true'

[Install]
WantedBy=multi-user.target
