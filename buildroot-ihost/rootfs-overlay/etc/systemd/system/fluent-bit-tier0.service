[Unit]
Description=Fluent Bit Tier-0 (always-on, no consent gate)
Documentation=https://github.com/greenautarky/ga-ihost-docs/blob/main/PRIVACY_TIERS.md
After=network-online.target hassio-supervisor.service netbird.service
Wants=network-online.target
# NO ConditionPathExists — Tier 0 ships regardless of consent state.
# Legal basis: DSGVO Art. 6 (b) Vertragserfüllung + (f) berechtigtes Interesse.
#
# Because tier-1 (fluent-bit.service) IS consent-gated, tier-0 is the only
# fluent-bit running on most of the fleet, and therefore its only Loki writer.
# It must carry the per-device credential before Loki enforces auth_enabled, or
# those devices go dark. Its Loki OUTPUT lives in fluent-bit-tier0.conf, shipped
# by the ga-telemetry-config OCI overlay (pinned in version.yaml) — not in this
# repo. That is why an earlier "tier-0 auth fix" patched network-details.conf,
# a scaffold no service loads, and changed nothing.

[Service]
Type=simple

# Builds /mnt/data/fluent-bit/env: GA_ENV, DEVICE_UUID, DEVICE_LABEL, and the
# per-device LOKI_* credential read from the ga-fleet-loki.yaml sidecar.
#
# Do NOT inline shell here. systemd expands ${VAR} in Exec* lines itself, before
# /bin/sh ever sees them; the previous inline version therefore wrote EMPTY
# LOKI_* values, and its "key already present" guard made them permanent. The
# script rewrites the env file in full on every start, so a wrong value heals.
# It always exits 0 — an absent cred degrades to the anonymous defaults below
# instead of taking the stream down.
ExecStartPre=/usr/libexec/ga-fluent-bit-env

# Fallback for the case where /mnt/data/fluent-bit/env cannot be read at all
# (EnvironmentFile below is optional — note the leading '-'). These LOKI_*
# reproduce the pre-ADR-0003-Step-3 behaviour: plain :3100, no auth. Loki in
# single-tenant mode ignores both the Authorization header and X-Scope-OrgID,
# so the "anonymous" sentinels are wire-inert.
Environment=GA_ENV=dev DEVICE_UUID=unknown DEVICE_LABEL=unknown
Environment=LOKI_HOST=loki.greenautarky.com LOKI_PORT=3100 LOKI_USER=anonymous LOKI_PASSWORD=anonymous LOKI_TENANT=anonymous

# Written by the ExecStartPre above; overrides the defaults for ExecStart.
EnvironmentFile=-/mnt/data/fluent-bit/env

ExecStart=/usr/bin/fluent-bit -c /etc/fluent-bit/fluent-bit-tier0.conf

Restart=on-failure
RestartSec=10
# Smaller resource budget than tier-1 — narrow scope keeps it light
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
