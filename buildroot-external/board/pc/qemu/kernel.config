# QEMU CI kernel fragment — promotes the 9p virtio stack from =m to =y
# so the CI harness can mount the test share without first having to
# modprobe inside the guest.
#
# The base ova kernel.config already enables these as modules; this
# fragment is layered AFTER it (see BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
# in ga_qemu_defconfig), so the =y wins.
#
# Same change is not needed for the ova/ deployment image — there 9p as
# =m is fine because nothing mounts it at boot time. CI does, hence =y.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
