# GA_HAOS external tree: the GreenAutarky packages every board builds.
# Upstream HAOS's own buildroot-external/Config.in stays unmodified (haos/).
menu "GreenAutarky OS layer (GA_HAOS)"
source "$BR2_EXTERNAL_GA_HAOS_PATH/package/fluent-bit-config/Config.in"
source "$BR2_EXTERNAL_GA_HAOS_PATH/package/netbird/Config.in"
source "$BR2_EXTERNAL_GA_HAOS_PATH/package/telegraf/Config.in"
endmenu
