index 75c2bea61..0bd51fff6 100644
--- a/buildroot-external/genimage/image-raucb-spl.cfg
+++ b/buildroot-external/genimage/image-raucb-spl.cfg
@@ -1,13 +1,20 @@
 rauc {
-	key = "/build/key.pem"
-	cert = "/build/cert.pem"
-	# intermediate can be removed after May 14th 2028, along with old CAs from the keyrings
-	intermediate = "${BR2_EXTERNAL_HAOS_PATH}/ota/rel-ca-xsign-oldroot.cert.pem"
+	# Set by hdd-image.sh from the build mode. The default is a path that does
+	# NOT exist, on purpose: an unset selector must fail loudly here rather than
+	# silently fall back to the production key. Until 2026-07-30 these two lines
+	# hardcoded /build/key.pem, so every dev build signed with the production key
+	# regardless of what the rest of the build thought it was doing.
+	key = "${GA_SIGN_KEY:-/build/GA_SIGN_KEY-IS-UNSET}"
+	cert = "${GA_SIGN_CERT:-/build/GA_SIGN_CERT-IS-UNSET}"
 	keyring = "${TARGET_DIR}/etc/rauc/keyring.pem"
 	manifest = "${RAUC_MANIFEST:-PLEASE_SPECIFY_RAUC_MANIFEST}"
 	file hook { image = "${BR2_EXTERNAL_HAOS_PATH}/ota/rauc-hook" }
 	file spl.img { image = "spl.img" }
-	file boot.vfat { image = "boot.vfat" }
+	# NOT boot.vfat: the OTA boot partition is marker-free by construction.
+	# See buildroot-external/genimage/images-boot-ota.cfg for why. The name
