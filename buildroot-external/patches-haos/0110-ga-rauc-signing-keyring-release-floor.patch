From: GreenAutarky OS <noreply@greenautarky.invalid>
Subject: [PATCH] rauc: GA signing material, GA keyring, release floor, marker-free OTA boot

GA deltas of the RAUC/genimage scripts and templates (until HAOS 18.x edits of
the files themselves), on HAOS 18.x:

  scripts/rauc.sh          signing key + certificate from the read-only
                           secrets mount ($GA_SECRETS_DIR, default /secrets);
                           the keyring holds the GA OTA root only, read from
                           the GA layer (ota/rel-ca.pem, builder-provided,
                           pinned by ga_build.sh); missing or empty fails, a
                           signing certificate that does not chain fails.
  scripts/hdd-image.sh     same signing material for the bundle; manifest
                           [meta.ga] release from the rootfs /etc/ga-release;
                           the bundle gets boot-ota.vfat (the boot tree minus
                           the provisioning marker). Slot sizes are upstream's
                           (fresh 18.x images: 256M system slots).
  ota/system.conf.gtpl     pre-install handler /usr/lib/rauc/ga-release-floor.
  ota/manifest.raucm.gtpl  [meta.ga] release=.
  genimage/image-raucb-*   GA key/certificate; boot.vfat <- boot-ota.vfat;
                           upstream's intermediate (HA cross-signed root) is
                           not carried: the GA keyring trusts the GA root only.
  genimage/images-boot-ota.cfg  new: the OTA boot image.
---
 .../genimage/image-raucb-nospl.cfg            |  17 ++-
 .../genimage/image-raucb-spl.cfg              |  17 ++-
 .../genimage/images-boot-ota.cfg              |  29 +++++
 buildroot-external/ota/manifest.raucm.gtpl    |  10 ++
 buildroot-external/ota/system.conf.gtpl       |   7 +-
 buildroot-external/scripts/hdd-image.sh       |  54 ++++++++-
 buildroot-external/scripts/rauc.sh            | 105 +++++++++++++++---
 7 files changed, 211 insertions(+), 28 deletions(-)

diff --git a/buildroot-external/genimage/image-raucb-nospl.cfg b/buildroot-external/genimage/image-raucb-nospl.cfg
index 38df198b3..569194607 100644
--- a/buildroot-external/genimage/image-raucb-nospl.cfg
+++ b/buildroot-external/genimage/image-raucb-nospl.cfg
@@ -1,12 +1,19 @@
 rauc {
-	key = "/build/key.pem"
-	cert = "/build/cert.pem"
-	# intermediate can be removed after May 14th 2028, along with old CAs from the keyrings
-	intermediate = "${BR2_EXTERNAL_HAOS_PATH}/ota/rel-ca-xsign-oldroot.cert.pem"
+	# Set by hdd-image.sh from the build mode. The default is a path that does
+	# NOT exist, on purpose: an unset selector must fail loudly here rather than
+	# silently fall back to the production key. Until 2026-07-30 these two lines
+	# hardcoded /build/key.pem, so every dev build signed with the production key
+	# regardless of what the rest of the build thought it was doing.
+	key = "${GA_SIGN_KEY:-/build/GA_SIGN_KEY-IS-UNSET}"
+	cert = "${GA_SIGN_CERT:-/build/GA_SIGN_CERT-IS-UNSET}"
 	keyring = "${TARGET_DIR}/etc/rauc/keyring.pem"
 	manifest = "${RAUC_MANIFEST:-PLEASE_SPECIFY_RAUC_MANIFEST}"
 	file hook { image = "${BR2_EXTERNAL_HAOS_PATH}/ota/rauc-hook" }
-	file boot.vfat { image = "boot.vfat" }
+	# NOT boot.vfat: the OTA boot partition is marker-free by construction.
+	# See buildroot-external/genimage/images-boot-ota.cfg for why. The name
+	# INSIDE the bundle stays boot.vfat — manifest.raucm addresses it by that
+	# name and every deployed device's install hook expects it.
+	file boot.vfat { image = "boot-ota.vfat" }
 	file kernel.img { image = "kernel.img" }
 	file rootfs.img { image = ${SYSTEM_IMAGE} }
 }
