+++ b/buildroot-external/package/hassio/Config.in
@@ -18,6 +18,20 @@ config BR2_PACKAGE_HASSIO_MACHINE
 	help
 	  Machine to pull containers for (used for landing page).
 
+config BR2_PACKAGE_HASSIO_FULL_CORE
+	bool "Bake the full Home Assistant Core"
+	help
+	  GA: bake the channel's Core (homeassistant.<machine>) instead of
+	  the landing page.
+
+config BR2_PACKAGE_HASSIO_DATA_IMAGE_SIZE
+	string "Data image build size"
+	default "1280M"
+	help
+	  GA: size of the data.ext4 the bake fills (shrunk to its content
+	  afterwards). Must hold every baked image unpacked (containerd
