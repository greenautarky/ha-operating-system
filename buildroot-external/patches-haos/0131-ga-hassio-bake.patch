 .../package/hassio/dind-import-containers.sh  |  45 +++++-
 .../package/hassio/fetch-addon-images.sh      |  31 ++++
 .../package/hassio/fetch-container-image.sh   |   6 +
 buildroot-external/package/hassio/hassio.mk   | 142 +++++++++++++++++-
 6 files changed, 247 insertions(+), 15 deletions(-)

