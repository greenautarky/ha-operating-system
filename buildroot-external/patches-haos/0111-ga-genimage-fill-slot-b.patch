From: GreenAutarky OS <noreply@greenautarky.invalid>
Subject: [PATCH] genimage: write kernel+rootfs into slot B as well (gpt, mbr)

A fresh flash fills kernel1/system1 too, so ga-rauc-slots can prove the
inactive slot by byte identity. partitions-os-hybrid.cfg is a symlink to
partitions-os-gpt.cfg upstream and follows.
---
 .../genimage/partitions-os-gpt.cfg            | 31 +++++++++++++++++++
 .../genimage/partitions-os-mbr.cfg            | 31 +++++++++++++++++++
 2 files changed, 62 insertions(+)

diff --git a/buildroot-external/genimage/partitions-os-gpt.cfg b/buildroot-external/genimage/partitions-os-gpt.cfg
index 814e7a3e1..014de2e88 100644
--- a/buildroot-external/genimage/partitions-os-gpt.cfg
+++ b/buildroot-external/genimage/partitions-os-gpt.cfg
@@ -1,3 +1,32 @@
+# Both slot pairs carry the SAME content since 2026-08-19. Measured on K31 the
+# day before: an SD flash left kernel1/system1 EMPTY, so RAUC reported the
+# inactive slot with installed_version=null / bootable=false and
+# rollback.possible=false. A brand-new device therefore had NO rollback target at
+# all, and the first OTA it ever received was un-rollback-able by construction —
+# which is exactly the OTA you most want to be able to undo.
+#
+# Cost, measured rather than guessed: the partitions are ALREADY allocated by
+# `size` below, so the .img and the dd write are unchanged (9 663 676 416 bytes
+# either way). Only the .img.xz grows, by roughly the compressed size of
+# kernel+rootfs — about +240 MB on 1.28 GB, ~19%. An image is downloaded once per
+# batch and flashed onto many cards, so that is paid once, not per device.
+#
+# THIS ALONE CHANGES NOTHING AT RUNTIME, deliberately. RAUC keys "was anything
+# ever written here" on the slot's installed.timestamp in rauc.db, which only
+# `rauc install` writes — never a flash. So a filled slot is still not a rollback
+# target, and the guard in /usr/libexec/ga-rauc-slots keeps refusing, on purpose:
+# rolling into an unverified slot is an endless reboot loop, and since rc38
+# (CONFIG_BOOTDELAY=-2) there is no U-Boot prompt, so recovery is physically
+# re-flashing the card. What this change does is make the CONTENT true, so that a
+# later, separate change can honestly record "this slot booted this device" as
+# evidence instead of faking an install record.
+#
+# That later change exists since 2026-09-13: /usr/libexec/ga-rauc-slots compares
+# the inactive slot pair with the booted one byte for byte ON THE DEVICE and
+# reports rollback.possible=true only on that measured identity (MIRROR
+# EVIDENCE in the script). rauc.db itself is still never pre-populated here —
+# the OTA hook copies boot.vfat over /mnt/boot wholesale, so a baked-in rauc.db
+# would overwrite the device's real install history on every OTA.
 include("partition-gptboot-${PARTITION_TABLE_TYPE}.cfg")
 
 partition hassos-kernel0 {
@@ -18,12 +47,14 @@ partition hassos-kernel1 {
 	partition-type-uuid = "linux"
 	partition-uuid = "fc02a4f0-5350-406f-93a2-56cbed636b5f"
 	size = ${KERNEL_SIZE}
+	image = "kernel.img"
 }
 
 partition hassos-system1 {
 	partition-type-uuid = "linux"
 	partition-uuid = "a3ec664e-32ce-4665-95ea-7ae90ce9aa20"
 	size = ${SYSTEM_SIZE}
+	image = ${SYSTEM_IMAGE}
 }
 
 partition hassos-bootstate {
diff --git a/buildroot-external/genimage/partitions-os-mbr.cfg b/buildroot-external/genimage/partitions-os-mbr.cfg
index c40892b94..6d70ddbcb 100644
--- a/buildroot-external/genimage/partitions-os-mbr.cfg
+++ b/buildroot-external/genimage/partitions-os-mbr.cfg
@@ -1,3 +1,32 @@
+# Both slot pairs carry the SAME content since 2026-08-19. Measured on K31 the
+# day before: an SD flash left kernel1/system1 EMPTY, so RAUC reported the
+# inactive slot with installed_version=null / bootable=false and
+# rollback.possible=false. A brand-new device therefore had NO rollback target at
+# all, and the first OTA it ever received was un-rollback-able by construction —
+# which is exactly the OTA you most want to be able to undo.
+#
+# Cost, measured rather than guessed: the partitions are ALREADY allocated by
+# `size` below, so the .img and the dd write are unchanged (9 663 676 416 bytes
+# either way). Only the .img.xz grows, by roughly the compressed size of
+# kernel+rootfs — about +240 MB on 1.28 GB, ~19%. An image is downloaded once per
+# batch and flashed onto many cards, so that is paid once, not per device.
+#
+# THIS ALONE CHANGES NOTHING AT RUNTIME, deliberately. RAUC keys "was anything
+# ever written here" on the slot's installed.timestamp in rauc.db, which only
+# `rauc install` writes — never a flash. So a filled slot is still not a rollback
+# target, and the guard in /usr/libexec/ga-rauc-slots keeps refusing, on purpose:
+# rolling into an unverified slot is an endless reboot loop, and since rc38
+# (CONFIG_BOOTDELAY=-2) there is no U-Boot prompt, so recovery is physically
+# re-flashing the card. What this change does is make the CONTENT true, so that a
+# later, separate change can honestly record "this slot booted this device" as
+# evidence instead of faking an install record.
+#
+# That later change exists since 2026-09-13: /usr/libexec/ga-rauc-slots compares
+# the inactive slot pair with the booted one byte for byte ON THE DEVICE and
+# reports rollback.possible=true only on that measured identity (MIRROR
+# EVIDENCE in the script). rauc.db itself is still never pre-populated here —
+# the OTA hook copies boot.vfat over /mnt/boot wholesale, so a baked-in rauc.db
+# would overwrite the device's real install history on every OTA.
 partition hassos-boot {
 	size = ${BOOT_SIZE}
 	partition-type = 0xc
@@ -20,11 +49,13 @@ partition hassos-system0 {
 partition hassos-kernel1 {
 	partition-type = 0x83
 	size = ${KERNEL_SIZE}
+	image = "kernel.img"
 }
 
 partition hassos-system1 {
 	partition-type = 0x83
 	size = ${SYSTEM_SIZE}
+	image = ${SYSTEM_IMAGE}
 }
 
 partition hassos-bootstate {
