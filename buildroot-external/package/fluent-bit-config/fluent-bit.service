[Unit]
Description=Fluent Bit log agent
After=network-online.target hassio-supervisor.service netbird.service ga-telemetry-consent.service
Wants=network-online.target
# Only start if user consented to error log collection (marker written by ga-telemetry-consent.service)
ConditionPathExists=/mnt/data/.ga-consent-error_logs

[Service]
Type=simple

# Builds /mnt/data/fluent-bit/env: GA_ENV, DEVICE_UUID, DEVICE_LABEL, and the
# per-device LOKI_* credential read from the ga-fleet-loki.yaml sidecar
# (ADR-0003 Step 3; delivered by the fleet-manager credentials_autopush ->
# ga_manager creds-write worker into its addon-private /data dir).
#
# Do NOT inline shell here. systemd expands ${VAR} in Exec* lines itself, before
# /bin/sh ever sees them; the previous inline version therefore wrote EMPTY
# LOKI_* values, and its "key already present" guard made them permanent. It
# also rebuilt the env file unconditionally on every start, clobbering what
# tier-0 had written. The script does both jobs once, for both tiers: rewrite in
# full (so a wrong value heals) and always exit 0 (so an absent cred degrades to
# the anonymous defaults rather than taking the stream down).
ExecStartPre=/usr/libexec/ga-fluent-bit-env

# Fallback for the case where /mnt/data/fluent-bit/env cannot be read at all
# (EnvironmentFile below is optional — note the leading '-'). LOKI_* here
# reproduce the pre-ADR-0003-Step-3 behaviour: plain :3100, no auth. Loki in
# single-tenant mode (auth_enabled: false) IGNORES both the Authorization header
# and X-Scope-OrgID, so the "anonymous" sentinels are wire-inert.
Environment=GA_ENV=dev DEVICE_UUID=unknown DEVICE_LABEL=unknown
Environment=LOKI_HOST=loki.greenautarky.com LOKI_PORT=3100 LOKI_USER=anonymous LOKI_PASSWORD=anonymous LOKI_TENANT=anonymous

# Written by the ExecStartPre above; overrides the defaults for ExecStart.
EnvironmentFile=-/mnt/data/fluent-bit/env

# Use override config from data partition if present, otherwise rootfs default.
# To switch to debug: cp /etc/fluent-bit/fluent-bit-debug.conf /mnt/data/fluent-bit/override.conf
# To revert:          rm /mnt/data/fluent-bit/override.conf
ExecStart=/bin/sh -c 'if [ -f /mnt/data/fluent-bit/override.conf ]; then exec /usr/bin/fluent-bit -c /mnt/data/fluent-bit/override.conf; else exec /usr/bin/fluent-bit -c /etc/fluent-bit/fluent-bit.conf; fi'

Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
