[Unit]
Description=Telegraf metrics agent
After=network-online.target docker.service hassos-supervisor.service netbird.service ga-telemetry-consent.service
Wants=network-online.target
# Only start if user consented to metrics collection (marker written by ga-telemetry-consent.service)
ConditionPathExists=/mnt/data/.ga-consent-metrics
# At most 10 starts in 5 min, then the unit stays failed. [Unit], not
# [Service]: there systemd ignores StartLimitIntervalSec= and the burst ran
# against the 10 s default, which a 5 s restart never reaches.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# Build the env file (base tags + per-device InfluxDB credential) in ONE script.
# NOT inline shell: systemd expands plain ${VAR} in Exec* lines itself, which
# silently emptied INFLUX_USER/INFLUX_PASSWORD and 401'd every write. See the
# header of ga-telegraf-env; guarded fleet-wide by build test CFG-48.
ExecStartPre=/usr/libexec/ga-telegraf-env

# If an override config exists, check it loads in THIS telegraf (a reduced
# build: only the plugins the shipped configs use). Never blocks the start
# ("-" prefix, always exit 0); on a reject it logs at err which plugin or
# option is the cause and that the device will send no metrics. Silent without
# an override. See the header of ga-telegraf-override-check.
ExecStartPre=-/usr/libexec/ga-telegraf-override-check

# Safe defaults (EnvironmentFile is read BEFORE ExecStartPre, so first boot needs these)
Environment=GA_ENV=unknown DEVICE_UUID=unknown GATEWAY_IP=unknown DEVICE_LABEL=unknown GA_BUILD_TIMESTAMP=unknown

# EnvironmentFile overrides defaults above on subsequent starts
EnvironmentFile=-/mnt/data/telegraf/env

# Use override config from data partition if present, otherwise rootfs default.
# To switch to debug: cp /etc/telegraf/telegraf-debug.conf /mnt/data/telegraf/override.conf
# To revert:          rm /mnt/data/telegraf/override.conf
# An override may only use plugins compiled into this build (`telegraf plugins`).
ExecStart=/bin/sh -c 'if [ -f /mnt/data/telegraf/override.conf ]; then exec /usr/bin/telegraf --config /mnt/data/telegraf/override.conf; else exec /usr/bin/telegraf --config /etc/telegraf/telegraf.conf; fi'

Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
