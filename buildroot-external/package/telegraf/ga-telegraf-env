#!/bin/sh
# ga-telegraf-env — build /mnt/data/telegraf/env for telegraf.service.
#
# Why this is a script and not a set of ExecStartPre one-liners
# ------------------------------------------------------------
# systemd expands PLAIN ${VAR} references in Exec* lines *itself*, before
# /bin/sh ever sees the command. The previous inline version read the
# per-device InfluxDB credential and wrote it out with
#   echo "INFLUX_USER=${U}" >> …
# — systemd replaced ${U} and ${P} with empty strings (they are not in the
# unit's environment), so the env file got INFLUX_USER= / INFLUX_PASSWORD=
# and EVERY write 401'd. The unbraced "$U" inside `[ -n "$U" ]` survived, so
# the guard happily took the success branch and even logged
# "cred loaded (user=)" — an empty user, reported as success.
#
# Subtlety that hid this for weeks: the other lines used shell-default syntax
# (${LABEL:-unknown}). systemd does NOT recognise "${VAR:-default}" as a
# simple variable reference, so it passes those through untouched — DEVICE_LABEL
# was always correct while the credential was always empty. Only plain ${VAR}
# is eaten.
#
# Same class as the 2026-07-10 fluent-bit outage (empty LOKI_*), fixed the same
# way — see ga-fluent-bit-env. Two rules, enforced by this script and by build
# test CFG-48 (no plain ${VAR} in any Exec* line of any GA unit):
#   1. No shell, and therefore no ${…}, in the unit files.
#   2. Rewrite the env file in full on every start. Never append, never guard on
#      "the key is already present" — a wrong value must be able to heal.
#
# Exit status is always 0: a missing or incomplete credential must degrade to
# "no per-device auth" (writes 401 until the fleet-manager delivers it), never
# block the unit from starting.

set -u

ENV_FILE=/mnt/data/telegraf/env
# Per-device InfluxDB credential. PREFERRED source is the addon-PRIVATE /data
# sidecar written by ga_manager's creds-write worker (ADR-0003: no secret under
# /share — the /share view is readable by any share:rw addon; Vuln-8). Read it
# root-only via the slug-tolerant glob, exactly like ga-fluent-bit-env does for
# loki. Falls back to the LEGACY /share file during the transition (ga_manager
# < 0.99.0 that has not written the sidecar yet); ADR-0003 Step 5 drops it.
# shellcheck disable=SC2125  # expanded unquoted in find_influx_cred(), by design
CRED_GLOB=/mnt/data/supervisor/addons/data/*_ga_manager/ga-fleet-influx.yaml
LEGACY_CRED=/mnt/data/supervisor/share/ga-fleet-influx.yaml

mkdir -p /mnt/data/telegraf /mnt/data/telegraf/buffer

# --- base env (rebuilt in full every start, so a wrong value can heal) -------

if [ -f /mnt/data/ga-env.conf ]; then
    . /mnt/data/ga-env.conf
elif [ -f /etc/ga-env.conf ]; then
    . /etc/ga-env.conf
fi

UUID=$(grep -oE '[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}' \
       /mnt/data/supervisor/homeassistant/.storage/core.uuid 2>/dev/null | head -1)
LABEL=$(cat /mnt/data/ga-device-label 2>/dev/null)
# Fallback (2026-07-15): derive from the canonical per-device identity when the
# legacy /mnt/data/ga-device-label is absent — ADR-0010 single source of truth.
# Same class + fix as ga-fluent-bit-env; keeps metrics + logs on the same label.
# Read from the addon's PRIVATE data dir, not /share: eleven add-ons map the
# share bridge and Samba exports it to the customer LAN, so anyone there could
# dictate the label this device reports its metrics under.
if [ -z "$LABEL" ]; then
    for _idf in /mnt/data/supervisor/addons/data/*_ga_manager/ga-identity.json; do
        [ -r "$_idf" ] || continue
        LABEL=$(sed -n 's/.*"device_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                "$_idf" 2>/dev/null | head -1)
        [ -n "$LABEL" ] && break
    done
fi
GW=$(ip route 2>/dev/null | grep '^default' | head -1 | awk '{print $3}')

BUILD_TS=""
if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release 2>/dev/null
    BUILD_TS="${GA_BUILD_TIMESTAMP:-}"
fi

{
    printf 'GA_ENV=%s\n'             "${GA_ENV:-dev}"
    printf 'DEVICE_UUID=%s\n'        "${UUID:-unknown}"
    printf 'DEVICE_LABEL=%s\n'       "${LABEL:-unknown}"
    printf 'GATEWAY_IP=%s\n'         "${GW:-unknown}"
    printf 'GA_BUILD_TIMESTAMP=%s\n' "${BUILD_TS:-unknown}"
} > "$ENV_FILE"

# --- per-device InfluxDB credential (ADR-0002 / ADR-0003 Step 2) -------------
#
# Delivered by fleet-manager influx_creds_autopush -> ga_manager creds-write,
# which renders the flat sidecar in its addon-private /data dir (host view:
# CRED_GLOB) and — during the transition — the legacy /share view (LEGACY_CRED).
# Hardened against the /mnt/data addon-mount boot race (seen live on K0
# 2026-07-09): bounded wait, loud journal lines either way, creds written only
# when BOTH fields are non-empty. Same find+wait shape as ga-fluent-bit-env.
find_influx_cred() {
    for c in $CRED_GLOB; do
        [ -f "$c" ] && { printf '%s' "$c"; return 0; }
    done
    [ -f "$LEGACY_CRED" ] && { printf '%s' "$LEGACY_CRED"; return 0; }
    return 1
}

CRED_FILE=$(find_influx_cred) || CRED_FILE=""
if [ -z "$CRED_FILE" ] && [ -d /mnt/data/supervisor/addons/data ]; then
    n=1
    while [ "$n" -le 6 ]; do
        sleep 5
        CRED_FILE=$(find_influx_cred) && break
        CRED_FILE=""
        echo "telegraf: per-device influx cred not present (try $n/6) — waiting for the addon data mount"
        n=$((n + 1))
    done
fi

if [ -z "$CRED_FILE" ]; then
    echo "telegraf: no per-device influx cred (checked /data sidecar + legacy /share) — starting without one (InfluxDB writes will 401 until the fleet-manager delivers it)"
    exit 0
fi

U=$(sed -n 's/^username: *//p' "$CRED_FILE" | head -1)
P=$(sed -n 's/^password: *//p' "$CRED_FILE" | head -1)

if [ -n "$U" ] && [ -n "$P" ]; then
    printf 'INFLUX_USER=%s\n'     "$U" >> "$ENV_FILE"
    printf 'INFLUX_PASSWORD=%s\n' "$P" >> "$ENV_FILE"
    echo "telegraf: per-device influx cred loaded (user=$U)"
else
    echo "telegraf: cred file $CRED_FILE present but username/password missing — writes will 401"
fi

exit 0
