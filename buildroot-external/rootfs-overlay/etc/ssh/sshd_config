# GA sshd — OpenSSH on the host port (ADR-0019).
#
# This file is the SHARED plane every image carries: authorized_keys under
# /root/.ssh, seeded from /usr/share/ga-ssh. It names no CA on purpose.
#
# The certificate plane (ADR-0019 step 2, BOSv1.4.0 and later) is NOT a second
# copy of this file: at bake time post-build.d/87-ssh-cert-plane.sh drops
# sshd_config.d/50-ga-cert-plane.conf (TrustedUserCAKeys,
# AuthorizedPrincipalsFile, AuthorizedKeysFile, RevokedKeys) and the CA public
# key and revocation list into the image, and replaces the baked
# authorized_keys with the single break-glass key. Below 1.4.0 that directory
# stays empty and this Include matches nothing.
#
# The Include MUST stay the first directive: sshd takes the FIRST value it
# reads for most keywords, so a drop-in included after a directive could not
# change it. This is load-bearing for AuthorizedKeysFile: the drop-in's value
# (baked break-glass file first) has to win over the line below.
Include /etc/ssh/sshd_config.d/*.conf

Port 22222

# Where the shared key is read from. /root/.ssh is bind-mounted from the
# overlay (root-.ssh.mount) and seeded on first boot by hassos-overlay.
# Shared plane only: the certificate-plane drop-in sets its own value first.
AuthorizedKeysFile /root/.ssh/authorized_keys

PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no

# Algorithms stay at OpenSSH defaults — deliberately not widened. The shared
# key is RSA-2048; a modern client signs with rsa-sha2-256/512 and is accepted.
# Only a client that insists on SHA-1 (`ssh-rsa`) is refused, and that is the
# client to fix, not the server.

# The ONE host key, generated on first boot by ga-sshd-prepare and persisted
# on the overlay through etc-ssh-keys.mount. NOT /etc/ssh itself: that
# directory is baked read-only and holds this config. Only the per-device,
# writable part is bind-mounted, as its own subdirectory — binding the whole
# of /etc/ssh (the dropbear layout, safe there because /etc/dropbear held
# nothing but keys) would hide this file behind an empty overlay directory.
HostKey /etc/ssh/keys/ssh_host_ed25519_key

X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no

# VERBOSE, not INFO: at VERBOSE sshd logs the fingerprint of the key that was
# accepted — and, on the certificate plane, the certificate's key ID and
# serial, which is the whole access-audit chain.
LogLevel VERBOSE

PrintMotd no
# No external helper: sshd carries SFTP in-process (dropbear needed
# gesftpserver for the same job, and scp on an OpenSSH >= 9.0 client rides
# SFTP, so this subsystem is load-bearing).
Subsystem sftp internal-sftp
