[Unit]
Description=Recover rtw88_8723ds WiFi runtime degraded-TX hang (mode B)
After=NetworkManager.service
# Only on hardware that actually has the iHost rtw SDIO WiFi chip.
ConditionPathExists=/sys/bus/sdio/devices/mmc1:0001:1

[Service]
Type=oneshot
ExecStart=/usr/sbin/ga-wifi-watchdog
Nice=10
TimeoutStartSec=90

# Runs every 3 min. At the default level every run put PID 1's "Starting",
# "Finished"/"Deactivated" and the script's routine info lines into the
# persistent journal on the SD card: systemd timer chatter was ~10 % of all
# journal entries on a bench device (Odoo #1225). Capped at notice: warnings
# and errors (the trigger and recovery events carry <4>/<3>) still reach the journal and tier-0/tier-1, and a failed run
# still logs "Main process exited" (notice) and "Failed with result" (warning).
# Not kept: the plain stdout/stderr text of a run — run the script by hand to
# see it. Guarded by tests/gates/frequent_timer_loglevel.
LogLevelMax=notice
