[Unit]
Description=Periodic check for the Supervisor first-boot deadlock (acts at most once per boot)

[Timer]
# See ga-supervisor-cli-watchdog for N: the script itself requires the
# Supervisor container to have run >= 150 s; +2 min after boot is the first look.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
