[Unit]
Description=GreenAutarky journal dump on clean shutdown (failure trail for the volatile journal)
Documentation=man:journald.conf(5)
DefaultDependencies=no
# Stop order is the reverse of start order: ordering After= the data mount and
# journald makes ExecStop run while both still exist.
After=local-fs.target mnt-data.mount systemd-journald.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Bounded (2 MiB uncompressed, newest 5 kept) and never fails: see the script.
ExecStop=/usr/libexec/ga-journal-dump shutdown
TimeoutStopSec=30s

[Install]
WantedBy=sysinit.target
