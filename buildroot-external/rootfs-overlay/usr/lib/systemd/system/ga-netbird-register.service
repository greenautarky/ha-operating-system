[Unit]
Description=GA — Register NetBird peer on first boot (boot-partition or baked setup key)
# Daemon already starts via netbird.service; we add the `up` step.
Requires=netbird.service
After=netbird.service network-online.target
Wants=network-online.target
# The setup key may sit on the boot partition (/mnt/boot/ga-netbird-setup-key,
# written by the flasher); the script deletes it after a confirmed join.
RequiresMountsFor=/mnt/boot
# No ConditionPathExists on a key path: a skipped unit is silent, and "no key"
# must be loud. The script decides: joined -> exit 0; NeedsLogin without any
# usable key -> err-priority journal lines and exit 78 (see below).

[Service]
Type=oneshot
ExecStart=/usr/libexec/ga-netbird-register
RemainAfterExit=yes
# On failure (no internet at first boot, expired key, mgmt unreachable,
# join not yet confirmed) retry once a minute so devices that come up
# before WiFi association still register as soon as the network is up.
# Stops as soon as the register script exits 0 (confirmed join).
Restart=on-failure
RestartSec=60s
# 78 = no usable setup key anywhere: retrying cannot help, so the unit stays
# failed (visible in `systemctl --failed`) instead of looping every 60 s.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
