[Unit]
Description=Apply the fleet label SSH principal from ga_manager (ADR-0019)
ConditionPathExists=/etc/ssh/ga_user_ca.pub
RequiresMountsFor=/mnt/data
After=etc-ssh-principals.mount mnt-data.mount

[Service]
Type=oneshot
ExecStart=/usr/libexec/ga-ssh-principal-label
# The script reads at most 32 bytes from a regular file, so it finishes in
# milliseconds. The bound is for whatever that assumption misses.
TimeoutStartSec=15s

[Install]
WantedBy=multi-user.target
