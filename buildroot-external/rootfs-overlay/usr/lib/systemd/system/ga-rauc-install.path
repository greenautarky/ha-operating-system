# ga-rauc-install.path — file-watcher for ga_manager's RAUC install request.
#
# When ga_manager (running inside an HA add-on container) needs to
# trigger an OS-level RAUC install — typically for a same-HAOS-version
# BOSv1.2.x → BOSv1.2.y swap that Supervisor's /os/update refuses 400
# — it writes the target version into its OWN data directory,
# /data/ga-rauc-install-request. The host sees that directory under the
# add-on's pinned slug (ADR-0041):
#
#   /mnt/data/supervisor/addons/data/99f1cad4_ga_manager/
#
# Only ga_manager mounts it. This unit watches that exact path — no glob,
# no /share — and fires ga-rauc-install.service the moment the file changes.
#
# The .service unit's helper deletes the request file as its first
# action so a re-write triggers a fresh run instead of being de-duped
# by `PathChanged=`.

[Unit]
Description=Watch ga_manager's data directory for an OS install request
DefaultDependencies=no
# Wait until the /mnt/data partition is mounted; the add-on data
# directory is a Supervisor-managed subdir, but we only need the parent
# mount for the watch to be valid (systemd watches the nearest existing
# parent until the directory appears). Don't pull supervisor itself —
# this unit must be ready even when Supervisor is down (= for recovery
# flows).
After=mnt-data.mount
Requires=mnt-data.mount

[Path]
# PathChanged fires on writes (= atomic-renames into the path),
# matching how ga_manager writes the file (tmpfile + rename).
PathChanged=/mnt/data/supervisor/addons/data/99f1cad4_ga_manager/ga-rauc-install-request
# Unit to start when the path event fires. Standard systemd naming —
# defaults to <name>.service if not stated, but make it explicit.
Unit=ga-rauc-install.service

[Install]
WantedBy=multi-user.target
