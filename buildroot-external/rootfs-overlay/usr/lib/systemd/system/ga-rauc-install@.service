# ga-rauc-install@VERSION.service — RAUC install bypass for same-HAOS-version
#                                    GA OS-overlay updates.
#
# Triggered by ga_manager 0.41.0+ via Supervisor's /host/services
# /ga-rauc-install@<VERSION>.service/start endpoint when Supervisor's own
# /os/update refuses (= 400 "already on requested version") for a GA release
# that ships a same HAOS version but a different OS-overlay (= the BOSv1.2.x
# cadence on top of one HAOS minor).
#
# Operationally: Supervisor accepts host-service start regardless of the
# refused /os/update path; this template fronts the canonical
# `rauc install <bundle>` workflow that push-ota.sh --device has been doing
# manually since the cascade gotcha was found.
#
# Argument: VERSION — exact HAOS internal version (e.g. 16.3.1.10).
# Helper at /usr/sbin/ga-rauc-install enforces the version-string regex.

[Unit]
Description=GA RAUC install of HAOS version %i (Supervisor /os/update bypass)
DefaultDependencies=no
# Need network to reach the OTA server. Don't need supervisor stack;
# rauc operates against the inactive slot directly.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Realistic ceiling for a 230 MB RAUC download + install on a slow link;
# device-side timeouts in ga_manager's worker should sit ABOVE this.
TimeoutStartSec=900s
# Stay running until the reboot the helper schedules actually fires —
# otherwise systemd cleans up the cgroup before the `(sleep 5 && reboot)&`
# detachment runs.
RemainAfterExit=yes
ExecStart=/usr/sbin/ga-rauc-install %i

[Install]
WantedBy=default.target
