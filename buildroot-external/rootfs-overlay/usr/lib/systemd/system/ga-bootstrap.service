[Unit]
Description=GreenAutarky V1.2-clean first-boot addon bootstrap (install ga_manager)
Documentation=https://github.com/greenautarky/ha-operating-system
# Needs the Supervisor up — it registers the public greenautarky/vibe_addons
# addon repository and installs the ga_manager addon from it via the
# Supervisor API (through the hassio_cli container). The disk bootstrap
# (eMMC erase + OS marker) is a separate, earlier unit.
Requires=hassos-supervisor.service ga-bootstrap-disk.service
After=hassos-supervisor.service ga-bootstrap-disk.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/data

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent — every boot. Registers the vibe_addons addon repository and
# installs + starts the ga_manager addon from it if it is not already
# installed/running. The helper waits for the Supervisor API to be
# responsive before acting.
ExecStart=/usr/libexec/ga-bootstrap
# The Supervisor can be slow on a cold first boot; give the unit room.
# 1500s (25m) — the script's inner SUPERVISOR_WAIT_S poll runs up to
# 1200s; add a buffer so the unit isn't killed mid-poll.
TimeoutStartSec=1500
# A failed addon-install is operator-recoverable (and retried next boot) —
# do not let it wedge the boot transaction.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
