#!/bin/sh
# ga-netbird-register — first-boot NetBird peer registration.
#
# WHY THIS EXISTS
# ---------------
# `netbird.service` only starts the DAEMON. It does NOT register the
# device with the management plane — that requires a separate
# `netbird up --setup-key <KEY>` invocation. Without it, the daemon
# sits in `Daemon status: NeedsLogin`, the laptop's NetBird mgmt sees
# only the OLD peer (if any) with a stale public key, and the tunnel
# is permanently "Connecting".
#
# Previously this registration was done out-of-band by
# ga-flasher-py stage 40 (over SSH) during provisioning. That left
# any freshly-flashed-but-not-yet-provisioned device unreachable.
# This service bakes the step in so devices come up registered on
# first boot.
#
# The "kibu-<UUID>" temporary hostname assigned by NetBird at this
# point is later renamed to "KIB-SON-XXXXXXXX" via the NetBird Mgmt
# API by ga-flasher-py stage 71 (or, longer-term, ga_manager).
#
# WHERE THE KEY COMES FROM (1.6, Odoo #1280 step 1)
# -------------------------------------------------
#   1. /mnt/boot/ga-netbird-setup-key — written onto the card's boot
#      partition (FAT, root of the partition, next to ga-ethernet-force)
#      by the flasher after flashing. Preferred when present.
#   2. /usr/share/ga-netbird/setup-key — the key baked into the rootfs by
#      post-build.d/88-netbird-setup-key.sh. Fallback for cards flashed
#      without a boot-partition key; it goes away in a later step, once
#      the flasher writes the boot-partition key.
#   Format of both: the first line that is neither blank nor a comment
#   (#), whitespace stripped — the rule hook 88 uses for the build input.
#   The boot-partition file has no .txt suffix on purpose: the RAUC
#   install_boot hook keeps only *.txt and grubenv across an OTA, so an
#   update never carries the file forward.
#
# DELETE AFTER A CONFIRMED JOIN, AND ONLY THEN
# --------------------------------------------
# The boot-partition key file is removed once `netbird status` shows the
# join — Management connected AND a NetBird IP — never on the strength
# of `netbird up`'s exit code. A failed or unconfirmed join keeps the file
# so the next attempt can use it. Invariant: a joined device carries no
# key file on its boot partition (also checked on every later boot).
# The baked copy is on the read-only rootfs and cannot be deleted.
#
# IDEMPOTENT
# ----------
# Safe to run on every boot. Exits 0 early if the daemon reports a
# confirmed join (after removing a leftover boot-partition key). Won't
# re-register, won't rotate the peer key.
#
# EXIT STATUS / RETRY BEHAVIOR
# ----------------------------
#   0   joined (now or before)
#   1   transient failure (no internet, key rejected, join not confirmed,
#       daemon not answering while a boot-partition key waits) — the unit
#       has Restart=on-failure RestartSec=60s, so it tries again in 60 s
#   78  daemon needs a login and there is NO usable key anywhere — logged
#       at err priority; RestartPreventExitStatus=78 leaves the unit
#       failed (visible in `systemctl --failed`) instead of looping.
#
# Overrides (host tests only): GA_NETBIRD_BIN, GA_CURL_BIN,
# GA_NETBIRD_BOOT_KEY, GA_NETBIRD_BAKED_KEY, GA_NETBIRD_REACH_TIMEOUT,
# GA_NETBIRD_CONFIRM_TIMEOUT. No output of this script ever prints a key.
set -u

BOOT_KEY_FILE="${GA_NETBIRD_BOOT_KEY:-/mnt/boot/ga-netbird-setup-key}"
BAKED_KEY_FILE="${GA_NETBIRD_BAKED_KEY:-/usr/share/ga-netbird/setup-key}"
MGMT_URL="${NB_MGMT_URL:-https://api.netbird.io:443}"
NB_BIN="${GA_NETBIRD_BIN:-/usr/bin/netbird}"
CURL_BIN="${GA_CURL_BIN:-/usr/bin/curl}"
NB_SOCK="unix:///var/run/netbird.sock"
REACH_TIMEOUT="${GA_NETBIRD_REACH_TIMEOUT:-180}"
CONFIRM_TIMEOUT="${GA_NETBIRD_CONFIRM_TIMEOUT:-120}"
LOG_TAG="ga-netbird-register"
EX_NOKEY=78

# <N> prefixes set the journal priority (SyslogLevelPrefix, systemd default).
log()  { echo "<6>${LOG_TAG}: $*"; }
err()  { echo "<3>${LOG_TAG}: ERROR: $*" >&2; }
die()  { err "$*"; exit 1; }

[ -x "$NB_BIN" ] || die "netbird binary not present at $NB_BIN — install netbird package"

nb_status() { "$NB_BIN" --daemon-addr "$NB_SOCK" status 2>&1 || true; }

# A join is confirmed by its outcome: Management connected AND a NetBird IP
# (the same two facts the device suite checks, NB-REG-D-06/07).
is_joined() {
    printf '%s\n' "$1" | grep -qE 'Management:[[:space:]]+Connected' \
        && printf '%s\n' "$1" | grep -qE 'NetBird IP:[[:space:]]+[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+'
}

# Remove the boot-partition key and prove it is gone. Called only with a
# confirmed join in hand.
retire_boot_key() {
    [ -e "$BOOT_KEY_FILE" ] || return 0
    rm -f "$BOOT_KEY_FILE" 2>/dev/null
    sync 2>/dev/null || true
    if [ -e "$BOOT_KEY_FILE" ]; then
        err "join confirmed, but the setup key file $BOOT_KEY_FILE could not be removed — remove it by hand"
        return 1
    fi
    log "join confirmed — removed the setup key file $BOOT_KEY_FILE"
}

# read_key <file> — prints the first non-blank, non-comment line with
# whitespace stripped; returns 1 (and says why, loudly) if there is none.
read_key() {
    if [ ! -r "$1" ]; then
        err "setup key file $1 exists but is not readable"
        return 1
    fi
    _k=$(grep -vE '^[[:space:]]*(#|$)' "$1" 2>/dev/null | head -1 | tr -d '[:space:]')
    if [ -z "$_k" ]; then
        err "setup key file $1 has no usable key line (empty or only comments)"
        return 1
    fi
    printf '%s' "$_k"
}

# 1. Idempotency check — already registered?
#    `netbird status` returns "Daemon status: NeedsLogin" when no `up`
#    has run, and otherwise emits Management/Signal/NetBird IP lines.
status_out=$(nb_status)
if is_joined "$status_out"; then
    log "daemon already joined — nothing to register"
    retire_boot_key || exit 1
    exit 0
fi
case "$status_out" in
    *NeedsLogin*)
        log "daemon in NeedsLogin — attempting registration"
        ;;
    *)
        # Not NeedsLogin, not confirmed either (daemon not answering yet,
        # management still connecting). Without a waiting boot-partition key
        # this is the old "nothing to do"; with one, try again later so the
        # key is removed as soon as the join is confirmed.
        if [ -e "$BOOT_KEY_FILE" ]; then
            die "daemon neither needs a login nor shows a confirmed join yet; the setup key file $BOOT_KEY_FILE stays until it does — retrying"
        fi
        log "daemon not in NeedsLogin — nothing to do"
        exit 0
        ;;
esac

# 2. Setup key: the boot partition first, then the baked fallback.
KEY="" KEY_SRC=""
if [ -e "$BOOT_KEY_FILE" ]; then
    if KEY=$(read_key "$BOOT_KEY_FILE"); then KEY_SRC="$BOOT_KEY_FILE"; else KEY=""; fi
fi
if [ -z "$KEY" ] && [ -e "$BAKED_KEY_FILE" ]; then
    if KEY=$(read_key "$BAKED_KEY_FILE"); then KEY_SRC="$BAKED_KEY_FILE"; else KEY=""; fi
fi
if [ -z "$KEY" ]; then
    err "no usable NetBird setup key: neither $BOOT_KEY_FILE nor $BAKED_KEY_FILE — this device cannot join the mesh on its own."
    err "Write the setup key to the boot partition as ga-netbird-setup-key and reboot."
    exit "$EX_NOKEY"   # RestartPreventExitStatus: failed unit, no restart loop
fi
log "using the setup key from $KEY_SRC (${#KEY} chars)"

# 3. Wait for api.netbird.io to be REACHABLE — not just DNS-resolvable.
#    network-online.target fires when NetworkManager reports a default
#    route, but the bench WiFi's DHCP-supplied DNS sometimes takes 30+
#    seconds to start answering on first boot (observed 2026-05-27:
#    getent failed for ~3 min, then succeeded). We now combine
#    DNS resolution + an HTTP HEAD probe so we catch both "DNS not ready"
#    and "DNS works but mgmt-plane unreachable" cases.
#
#    180 s budget × Restart=on-failure (60 s gap) = 3 retries in ~13 min.
log "waiting up to ${REACH_TIMEOUT}s for api.netbird.io to be reachable..."
INTERVAL=5
i=0
reached=0
while :; do
    # curl -sI tests both DNS resolution AND HTTPS reachability in one
    # shot — ANY HTTP response (200/401/404/etc.) means the mgmt plane
    # is reachable. We used to wrap this in a `getent hosts` pre-check
    # for speed, but iHost's BusyBox OS lacks /usr/bin/getent — the gate
    # always failed, the inner curl never ran, and the pre-flight burned
    # the full 180 s budget on every retry. curl handles DNS itself, so
    # the extra layer was pure liability. (Observed live 2026-05-27 —
    # 4 consecutive retries all hit the 180 s timeout.)
    if "$CURL_BIN" -sI --max-time 5 -o /dev/null https://api.netbird.io/ 2>/dev/null; then
        log "api.netbird.io reachable after ${i}s"
        reached=1
        break
    fi
    [ "$i" -ge "$REACH_TIMEOUT" ] && break
    sleep "$INTERVAL"
    i=$((i + INTERVAL))
done
if [ "$reached" -ne 1 ]; then
    die "api.netbird.io unreachable after ${REACH_TIMEOUT}s (DNS + HTTPS HEAD both failed) — retry via Restart=on-failure"
fi

# 4. Register. The --setup-key flag does the actual auth + peer create.
#    Its exit code is reported, not trusted: step 5 measures the outcome.
log "running netbird up against $MGMT_URL"
if "$NB_BIN" --daemon-addr "$NB_SOCK" up \
        --management-url "$MGMT_URL" \
        --setup-key "$KEY" >/dev/null 2>&1; then
    log "netbird up returned 0 — confirming the join"
else
    rc=$?
    die "netbird up failed (exit $rc) — key valid? mgmt reachable? The key file stays; retry per unit Restart=."
fi

# 5. Confirm the join by its outcome, then — and only then — retire the key.
j=0
while :; do
    status_out=$(nb_status)
    is_joined "$status_out" && break
    if [ "$j" -ge "$CONFIRM_TIMEOUT" ]; then
        case "$status_out" in
            *NeedsLogin*) die "registration failed — daemon still in NeedsLogin after ${CONFIRM_TIMEOUT}s; the key file stays" ;;
            *) die "join not confirmed after ${CONFIRM_TIMEOUT}s (no Management connected + NetBird IP); the key file stays" ;;
        esac
    fi
    sleep "$INTERVAL"
    j=$((j + INTERVAL))
done
log "registration complete:"
printf '%s\n' "$status_out" | head -10 | sed 's/^/  /'
retire_boot_key || exit 1
exit 0
