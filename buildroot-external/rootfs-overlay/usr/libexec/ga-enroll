#!/bin/sh
# ga-enroll — device self-enrollment with the fleet-manager (ADR-0010 P1).
#
# WHY THIS EXISTS
# ---------------
# Until ADR-0010, a freshly flashed device was invisible to the fleet:
# the operator hand-edited devices.yaml, and ga-bootstrap sat retrying
# forever because nothing could deliver GHCR pull creds to a device the
# fleet-manager didn't know (the autopush only serves registered
# devices, and it pushes THROUGH ga_manager — which isn't installed yet
# without those very creds). This service breaks that chicken-and-egg:
#
#   POST /api/enroll  {hw_serial, ha_uuid, netbird_hostname, netbird_ip,
#                      ga_release}
#     → fleet-manager stores a PENDING enrollment (tag enroll:pending)
#     → the RESPONSE carries the GHCR pull creds, which we write to
#       /mnt/data/ghcr-creds.json (fallback 4 of ga-bootstrap's chain,
#       root-only). ga-bootstrap's next retry then installs ga_manager.
#
# The device API token is NOT handled here — ga_manager binds its own
# /data/auth.token later via POST /api/enroll/token (trust-on-first-use
# while pending). This script never touches secrets other than writing
# the received GHCR creds to a root-only path. Per the /share rule
# (DISCUSSION-SECRETS-SHARE-VS-DATA.md) NOTHING secret goes to /share;
# the bridge state file written there is metadata only.
#
# IDEMPOTENT / RUNS EVERY BOOT
# ----------------------------
# Re-enrolling is safe and wanted: it refreshes the device's mesh IP and
# ga_release at the fleet-manager after every boot/reflash. The GHCR
# creds file is only (re)written when content actually changed.
#
# FLEET ENVIRONMENT (ADR-0027 D4)
# -------------------------------
# Two fleet-managers run on the same host, one port apart: production and
# staging. Which one this device belongs to is PROVISIONED DATA, not something
# an image can know (GA_ENV is the build mode — canaries run prod-mode images
# and live in staging). It is `GA_FLEET_ENV` in ga-services.conf, normally set
# in the /mnt/data override next to `GA_FLEET_PORT=8091`; ABSENT MEANS
# PRODUCTION. The resolved value rides in the enroll payload as `fleet_env`,
# so the fleet-manager that receives it can compare it with its own
# environment and badge or refuse a misrouted device. A value that is neither
# `prod` nor `staging` is refused HERE, loudly (exit 1, retried) — a typo in
# the override must never quietly enrol a device into production.
#
# RETRY BEHAVIOR
# --------------
# Exit 1 on any transient failure (fleet unreachable, 5xx, no mesh IP
# yet); the unit retries every 60 s until enrollment succeeds.
#
# Test hooks (tests/ga_tests/enroll_env/test.sh drives the real script on a
# CI runner): every path below can be moved with GA_ENROLL_*; the defaults are
# the device paths.
set -e

LOG_TAG="ga-enroll"
CONF_DEFAULT="${GA_ENROLL_CONF_DEFAULT:-/etc/ga-services.conf}"
CONF_OVERRIDE="${GA_ENROLL_CONF_OVERRIDE:-/mnt/data/ga-services.conf}"
CREDS_FILE="${GA_ENROLL_CREDS_FILE:-/mnt/data/ghcr-creds.json}"
STATE_FILE="${GA_ENROLL_STATE_FILE:-/mnt/data/supervisor/share/ga-enroll-state.json}"
NB_ENV="${GA_ENROLL_NB_ENV:-/mnt/data/netbird/netbird.env}"
HA_UUID_STORE="${GA_ENROLL_HA_UUID_STORE:-/mnt/data/supervisor/homeassistant/.storage/core.uuid}"
SHARE_PUBLISH="${GA_SHARE_PUBLISH:-/usr/libexec/ga-share-publish}"

log()  { echo "${LOG_TAG}: $*"; }
warn() { echo "${LOG_TAG}: WARNING: $*" >&2; }
die()  { echo "${LOG_TAG}: ERROR: $*" >&2; exit 1; }

# 1. Endpoint config — runtime override wins (same precedence as
#    ga-update-hosts / ga-resolve-ota).
# shellcheck disable=SC1090
if [ -f "$CONF_OVERRIDE" ]; then . "$CONF_OVERRIDE"; else . "$CONF_DEFAULT"; fi
if [ -z "${GA_FLEET_HOST:-}" ]; then
    log "GA_FLEET_HOST not set in ga-services.conf — enrollment disabled on this image"
    exit 0
fi
FLEET_URL="http://${GA_FLEET_HOST}:${GA_FLEET_PORT:-8090}"

# Fleet environment — absent means production (ADR-0027 D4). Anything else
# than the two known values is a provisioning error, refused before any
# request is made: better a device that visibly fails to enrol than one that
# quietly enrols into the wrong fleet.
fleet_env="${GA_FLEET_ENV:-prod}"
case "$fleet_env" in
    prod|staging) ;;
    *) die "GA_FLEET_ENV='${fleet_env}' is not 'prod' or 'staging' — fix it in ${CONF_OVERRIDE} (absent = prod); refusing to enrol" ;;
esac

command -v jq >/dev/null 2>&1 || die "jq not present — required to parse the enroll response"

# 2. Collect identity facts (all best-effort except hw_serial).
hw_serial=""
if [ -r /sys/firmware/devicetree/base/serial-number ]; then
    hw_serial=$(tr -d '\0' < /sys/firmware/devicetree/base/serial-number)
fi
[ -n "$hw_serial" ] || hw_serial=$(awk '/^Serial/{print $3; exit}' /proc/cpuinfo 2>/dev/null || true)
[ -n "$hw_serial" ] || hw_serial=$(cat /etc/machine-id 2>/dev/null || true)
[ -n "$hw_serial" ] || die "no hardware serial source available"

ha_uuid=""
[ -r "$HA_UUID_STORE" ] && ha_uuid=$(jq -r '.data.uuid // empty' "$HA_UUID_STORE" 2>/dev/null || true)

nb_hostname=$(hostname 2>/dev/null || true)
if [ -r "$NB_ENV" ]; then
    # shellcheck disable=SC1090
    nb_from_env=$(. "$NB_ENV" 2>/dev/null; echo "${NB_HOSTNAME:-}")
    [ -n "$nb_from_env" ] && nb_hostname="$nb_from_env"
fi

netbird_ip=$(ip -4 -o addr show dev wt0 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
[ -n "$netbird_ip" ] || warn "no wt0 address yet — enrolling without netbird_ip (refreshed next boot)"

ga_release=""
[ -r /etc/ga-release ] && ga_release=$(head -1 /etc/ga-release | tr -d '\r\n')

# 3. Enroll. --max-time keeps a hung fleet-manager from wedging the unit.
payload=$(jq -cn \
    --arg hw "$hw_serial" --arg uuid "$ha_uuid" --arg host "$nb_hostname" \
    --arg ip "$netbird_ip" --arg rel "$ga_release" --arg fenv "$fleet_env" \
    '{hw_serial:$hw, ha_uuid:$uuid, netbird_hostname:$host, netbird_ip:$ip, ga_release:$rel, fleet_env:$fenv}')
log "enrolling hw_serial=${hw_serial} at ${FLEET_URL} (ip=${netbird_ip:-none}, fleet_env=${fleet_env})"
# Forward/backward-compatible enrollment (#986). A device from rc30+ declares
# its fleet environment (ADR-0027 D4), but a fleet-manager that predates that
# field rejects the WHOLE enroll with HTTP 422 (EnrollPayload extra=forbid) — so
# a producer (this script) that shipped before the consumer (fm) was deployed
# would leave every fresh device unenrolled and invisible. On any failure of the
# fleet_env attempt, retry once with the pre-D4 payload shape (no fleet_env): the
# device still enrols against the older fm, and declares its env again as soon as
# fm is upgraded. A genuine outage fails both attempts and we die (and retry).
if response=$(curl -fsS --max-time 20 -H "Content-Type: application/json" \
    -X POST "${FLEET_URL}/api/enroll" -d "$payload" 2>/dev/null); then
    :
else
    warn "enroll with fleet_env failed (fleet-manager may predate ADR-0027 D4) — retrying without fleet_env"
    payload_compat=$(jq -cn \
        --arg hw "$hw_serial" --arg uuid "$ha_uuid" --arg host "$nb_hostname" \
        --arg ip "$netbird_ip" --arg rel "$ga_release" \
        '{hw_serial:$hw, ha_uuid:$uuid, netbird_hostname:$host, netbird_ip:$ip, ga_release:$rel}')
    response=$(curl -fsS --max-time 20 -H "Content-Type: application/json" \
        -X POST "${FLEET_URL}/api/enroll" -d "$payload_compat") \
        || die "fleet-manager unreachable or rejected the enrollment — will retry"
fi

status=$(printf '%s' "$response" | jq -r '.status // empty')
prov_id=$(printf '%s' "$response" | jq -r '.provisional_id // empty')
[ -n "$status" ] || die "malformed enroll response"
log "enrolled: status=${status} provisional_id=${prov_id}"

# 4. GHCR pull creds from the response → root-only persistent fallback in
#    ga-bootstrap's chain. Atomic write, only on change.
registries=$(printf '%s' "$response" | jq -S '.registries // empty')
if [ -n "$registries" ] && [ "$registries" != "null" ]; then
    if [ ! -f "$CREDS_FILE" ] || ! printf '%s\n' "$registries" | cmp -s - "$CREDS_FILE"; then
        umask 077
        printf '%s\n' "$registries" > "${CREDS_FILE}.tmp"
        mv "${CREDS_FILE}.tmp" "$CREDS_FILE"
        chmod 0600 "$CREDS_FILE"
        log "GHCR creds written to ${CREDS_FILE}"
    else
        log "GHCR creds unchanged"
    fi
else
    warn "enroll response carried no registries — ga-bootstrap stays blocked unless creds exist already"
fi

# 5. Non-secret bridge state for ga_manager's enroll worker (token bind):
#    tells the addon its hw_serial + where the fleet-manager lives.
#    fleet_url_ip: addon containers resolve via Supervisor CoreDNS, which
#    (as of 2025.11.4.6) does NOT know fleet.greenautarky.com — only the
#    HOST /etc/hosts does. We resolve here (host-side) and pass the IP
#    URL as fallback so enroll_bind works without the CoreDNS entry
#    (K0 rc12 finding 2026-07-06; CoreDNS fix = next Supervisor release).
fleet_ip=$(getent hosts "$GA_FLEET_HOST" 2>/dev/null | awk '{print $1; exit}')
[ -n "$fleet_ip" ] || fleet_ip=$(awk -v h="$GA_FLEET_HOST" '$0 ~ h {print $1; exit}' /etc/hosts)
FLEET_URL_IP=""
[ -n "$fleet_ip" ] && FLEET_URL_IP="http://${fleet_ip}:${GA_FLEET_PORT:-8090}"
mkdir -p "$(dirname "$STATE_FILE")"
# ga_release rides in the bridge so config-mapped addons (ga_manager /info,
# status page) can report the live release — no addon can see /etc/ga-release
# (Odoo #513: the release-train's verify gate polls exactly this).
# ga_env (dev/prod) rides in the bridge too: addons map /share but not
# /mnt/data, so /mnt/data/ga-env.conf is invisible to them. ga_manager's
# canary-only set-telemetry-consent guardrail reads it here (gm 0.85.0).
ga_env=""
[ -r /mnt/data/ga-env.conf ] && ga_env=$(sed -n 's/^GA_ENV=//p' /mnt/data/ga-env.conf | head -1 | tr -d '\r\n"'"'"'')
[ -n "$ga_env" ] || { [ -r /etc/ga-env.conf ] && ga_env=$(sed -n 's/^GA_ENV=//p' /etc/ga-env.conf | head -1 | tr -d '\r\n"'"'"''); }
# fleet_env (prod/staging — the FLEET, ADR-0027) rides next to ga_env (the
# BUILD MODE): two different facts that are easy to conflate, side by side so
# a reader of the bridge sees both.
jq -cn --arg hw "$hw_serial" --arg url "$FLEET_URL" --arg ipurl "$FLEET_URL_IP" \
       --arg pid "$prov_id" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
       --arg rel "$ga_release" --arg env "$ga_env" --arg fenv "$fleet_env" \
       '{hw_serial:$hw, fleet_url:$url, fleet_url_ip:$ipurl, provisional_id:$pid, enrolled_at:$at, ga_release:$rel, ga_env:$env, fleet_env:$fenv}' \
    | "$SHARE_PUBLISH" "$STATE_FILE" 0644
log "state written to ${STATE_FILE}"
