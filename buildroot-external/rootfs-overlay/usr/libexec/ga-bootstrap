#!/bin/sh
# ga-bootstrap - V1.2-clean OS first-boot addon bootstrap
#
# Runs at every boot (idempotent), AFTER the Supervisor is up. Ensures the
# baked `ga_manager` local addon is installed and running. This is the only
# job of this unit — once ga_manager is running it owns the rest of device
# convergence (the `converge` worker, gated on the /share/.ga_os marker that
# ga-bootstrap-disk writes).
#
# Why a boot service and not a one-time provisioning step: a v1.0/v1.1 field
# device gets V1.2-clean via a RAUC OS update, which swaps the rootfs but
# NOT the data partition — so the addon must be (re)installed on the device
# after the OS update too. Idempotent + every-boot covers both fresh-flash
# and OTA-upgrade paths.
#
# Host -> Supervisor API: there is no SUPERVISOR_TOKEN on the host. We use the
# existing `/usr/bin/ha` wrapper, which runs `ha` inside the `hassio_cli`
# container; that container holds a valid Supervisor token. Same mechanism
# the OS already uses for the interactive CLI.
#
# See ga-ihost-docs V1.2-CLEAN-REBUILD.md (T4).

set -eu

# Vendored local-addon metadata baked into the (read-only) rootfs. This dir
# holds ONE sub-directory per baked GA addon (ga_manager, ga_mosquitto,
# ga_zigbee2mqtt, sonoff_dongle_flasher_for_ihost, ...).
LOCAL_ADDONS_SRC="/usr/share/ga/local-addons"
# The ga_manager source dir specifically — the only addon ga-bootstrap also
# *installs* (the rest are installed by ga_manager's own `converge` worker).
ADDON_SRC="${LOCAL_ADDONS_SRC}/ga_manager"
# Where the Supervisor scans for local addons (on the data partition).
LOCAL_ADDONS_DIR="/mnt/data/supervisor/addons/local"
ADDON_DST="${LOCAL_ADDONS_DIR}/ga_manager"
# Supervisor slug for a local addon = local_<config-slug>, where <config-slug>
# is the `slug:` field inside the addon's config.{yaml,json} (NOT the dir
# name). ga_manager's config carries `slug: ga_manager` -> local_ga_manager.
ADDON_SLUG="local_ga_manager"

# Vendored custom_component(s) baked into the (read-only) rootfs, and where
# they get staged so ga_manager (an addon — sees /mnt/data/supervisor/share
# as /share) can read them. ga_manager's `converge` worker copies them from
# /share into /config/custom_components and owns their drift afterwards.
CUSTOM_COMPONENTS_SRC="/usr/share/ga/custom_components"
CUSTOM_COMPONENTS_DST="/mnt/data/supervisor/share/ga-custom-components"

HA="/usr/bin/ha"
SUPERVISOR_WAIT_S=300
INSTALL_WAIT_S=300

log()  { echo "ga-bootstrap: $*"; }
warn() { echo "ga-bootstrap: WARNING: $*" >&2; }
die()  { echo "ga-bootstrap: ERROR: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Wait for the Supervisor to be responsive. hassos-supervisor.service starts
# the container; the API takes a little longer to come up.
# ---------------------------------------------------------------------------
wait_for_supervisor() {
	i=0
	while [ "$i" -lt "$SUPERVISOR_WAIT_S" ]; do
		if "$HA" supervisor info --no-progress >/dev/null 2>&1; then
			log "Supervisor API is responsive"
			return 0
		fi
		sleep 3
		i=$((i + 3))
	done
	return 1
}

# ---------------------------------------------------------------------------
# Step 1: stage EVERY vendored local-addon's metadata onto the data partition.
#
# The rootfs is read-only and squashfs; the Supervisor's local-addon store
# lives on the (writable, NOT RAUC-updated) data partition. Copy the metadata
# there every boot so an OS update that ships a newer config is picked up.
# Each config carries an `image:` field -> Supervisor installs from the
# pre-baked image, no Dockerfile build, fully offline.
#
# ALL baked GA addons are staged here so they are *present* in the local
# store: ga_manager (which ga-bootstrap then installs itself, below) plus
# ga_mosquitto / ga_zigbee2mqtt / sonoff_dongle_flasher_for_ihost (which
# ga_manager's `converge` worker installs — it can only find them if they
# are already staged into the store). ga-bootstrap stages all, installs one.
# ---------------------------------------------------------------------------
stage_local_addon() {
	[ -d "$LOCAL_ADDONS_SRC" ] || die "vendored local-addons source missing: $LOCAL_ADDONS_SRC"
	[ -d "$ADDON_SRC" ] || die "vendored ga_manager addon source missing: $ADDON_SRC"
	mkdir -p "$LOCAL_ADDONS_DIR"

	staged=""
	for src in "$LOCAL_ADDONS_SRC"/*/; do
		[ -d "$src" ] || continue
		name=$(basename "$src")
		# Skip a dir with no addon config — it cannot be a Supervisor addon.
		if [ ! -f "${src}config.yaml" ] && [ ! -f "${src}config.yml" ] \
				&& [ ! -f "${src}config.json" ]; then
			warn "vendored dir ${name} has no addon config — skipping"
			continue
		fi
		dst="${LOCAL_ADDONS_DIR}/${name}"
		mkdir -p "$dst"
		# Copy contents (config.{yaml,json}, DOCS.md, icon/logo, VENDORED.md).
		# -p preserves modes. VENDORED.md is harmless extra metadata.
		cp -p "$src"* "$dst"/ 2>/dev/null || true
		staged="${staged} ${name}"
	done
	log "staged local addons into ${LOCAL_ADDONS_DIR}:${staged}"
}

# ---------------------------------------------------------------------------
# Step 1b: stage the vendored custom_component(s) onto /share.
#
# The component ships in the OS image (GA's own trusted build) — NOT in the
# ga_manager addon image, so the addon image carries no private-repo content.
# ga_manager (an addon) sees /mnt/data/supervisor/share as /share; its
# `converge` worker copies the component from /share/ga-custom-components into
# /config/custom_components on first boot. Re-staged every boot so an OS
# update that ships a newer component is picked up.
# ---------------------------------------------------------------------------
stage_custom_components() {
	if [ ! -d "$CUSTOM_COMPONENTS_SRC" ]; then
		log "no vendored custom_components at ${CUSTOM_COMPONENTS_SRC} — skipping"
		return 0
	fi
	mkdir -p "$CUSTOM_COMPONENTS_DST"
	staged=""
	for src in "$CUSTOM_COMPONENTS_SRC"/*/; do
		[ -d "$src" ] || continue
		name=$(basename "$src")
		dst="${CUSTOM_COMPONENTS_DST}/${name}"
		# Replace wholesale so a removed file in a newer component is gone.
		rm -rf "$dst"
		cp -rp "${src%/}" "$dst"
		staged="${staged} ${name}"
	done
	log "staged custom_components into ${CUSTOM_COMPONENTS_DST}:${staged}"
}

# ---------------------------------------------------------------------------
# Step 2: install + start the addon (idempotent).
# ---------------------------------------------------------------------------
addon_installed() {
	# `ha addons info <slug>` succeeds only if the addon is known to the
	# Supervisor; `version` is non-null once it is installed.
	"$HA" addons info "$ADDON_SLUG" --no-progress --raw-json 2>/dev/null \
		| grep -q '"version"' 2>/dev/null
}

addon_running() {
	"$HA" addons info "$ADDON_SLUG" --no-progress --raw-json 2>/dev/null \
		| grep -q '"state"[[:space:]]*:[[:space:]]*"started"' 2>/dev/null
}

install_addon() {
	# Make the Supervisor re-scan the local store so it sees the staged dir.
	log "reloading the addon store"
	"$HA" addons reload --no-progress >/dev/null 2>&1 \
		|| warn "addons reload returned non-zero (continuing)"

	if addon_installed; then
		log "${ADDON_SLUG} already installed — skipping install"
	else
		log "installing ${ADDON_SLUG} from the baked local addon"
		if ! "$HA" addons install "$ADDON_SLUG" --no-progress >/dev/null 2>&1; then
			# One retry after another store reload — the first reload can
			# race the Supervisor's own store refresh on a cold first boot.
			warn "install failed — retrying after a store reload"
			"$HA" addons reload --no-progress >/dev/null 2>&1 || true
			sleep 5
			"$HA" addons install "$ADDON_SLUG" --no-progress >/dev/null 2>&1 \
				|| die "could not install ${ADDON_SLUG}"
		fi

		# Wait for the install to settle (offline install from a baked
		# image is fast, but give it room).
		i=0
		while [ "$i" -lt "$INSTALL_WAIT_S" ]; do
			addon_installed && break
			sleep 3
			i=$((i + 3))
		done
		addon_installed || die "${ADDON_SLUG} did not finish installing in time"
		log "${ADDON_SLUG} installed"
	fi

	if addon_running; then
		log "${ADDON_SLUG} already running — bootstrap complete"
	else
		log "starting ${ADDON_SLUG}"
		"$HA" addons start "$ADDON_SLUG" --no-progress >/dev/null 2>&1 \
			|| warn "could not start ${ADDON_SLUG} (Supervisor may auto-start it)"
	fi
}

main() {
	if [ ! -x "$HA" ]; then
		die "$HA not found — cannot reach the Supervisor"
	fi

	log "waiting for the Supervisor..."
	if ! wait_for_supervisor; then
		die "Supervisor did not become responsive within ${SUPERVISOR_WAIT_S}s"
	fi

	stage_local_addon
	stage_custom_components
	install_addon

	log "first-boot addon bootstrap done"
}

main "$@"
