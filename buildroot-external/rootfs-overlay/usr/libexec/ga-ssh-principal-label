#!/bin/sh
# ga-ssh-principal-label — apply the fleet label principal handed over by
# ga_manager (ADR-0019 step 2, amendment C).
#
# ga_manager's REST-only `ssh-principals-write` worker cannot see /etc/ssh (an
# addon container never can). It writes the label into its OWN data directory,
# which the host sees under the pinned slug listed in /etc/ga-addon-prime.conf:
#
#   /mnt/data/supervisor/addons/data/99f1cad4_ga_manager/ga-ssh-principal-label
#
# The path is static on purpose — no glob over *_ga_manager, which would match
# any add-on whose slug merely ends that way. Only ga_manager writes there.
#
# Before anything reaches ga-ssh-principals, this script requires:
#   1. a regular file, not a symlink, not a device or FIFO;
#   2. a bounded read (at most 32 bytes — a label is 16 plus a newline);
#   3. exactly one label: charset [A-Za-z0-9-], shape ^KIB-SON-[0-9]{8}$;
#   4. equality with this device's OWN label, from every source that exists:
#        - /mnt/data/ga-device-label (host-only; written by a flasher stage
#          that is retired — absent on every fresh flash since), and
#        - device_id in ga_manager's private ga-identity.json under the same
#          pinned slug (written by identity-write and the fleet-manager's
#          identity backfill; what ga-telegraf-env / ga-fluent-bit-env /
#          ga-manage-ethernet already read).
#      Every existing source must hold a usable label and all must equal the
#      delivered one. With NO source the label is REFUSED (fail closed): until
#      2026-10-06 it was accepted on shape alone, which a fresh-flashed
#      BOSv1.4.0-rc4 canary did on every delivery.
#      That refusal cannot lock a fresh device out: it changes nothing in the
#      principals file, the hardware-serial anchor (ga-sshd-prepare) stays, and
#      the .path unit also watches ga-identity.json, so a label delivered
#      before the identity is applied the moment the identity appears.
#      Trust note: ga-identity.json and the delivered label are both written
#      by ga_manager, so this catches a wrong or stale delivery (another
#      device's label), not a compromised ga_manager; the host-only
#      ga-device-label, where present, is the independent source.
# A refused value is never printed — only its length. ga-ssh-principals then
# re-validates and rebuilds the principals file atomically, keeping the anchor.
#
# Removing the file does NOT remove the label: revocation is done by
# certificate expiry, not by deleting a file.
#
# No-op on a shared-plane image (no user CA baked, i.e. below BOSv1.4.0).
#
# GA_ROOT relocates every default path under a fixture root (tests only).
set -u
R="${GA_ROOT:-}"
CA_PUB="${GA_SSH_CA_PUB:-$R/etc/ssh/ga_user_ca.pub}"
SRC="${GA_SSH_LABEL_BRIDGE:-$R/mnt/data/supervisor/addons/data/99f1cad4_ga_manager/ga-ssh-principal-label}"
OWN_FILE="${GA_DEVICE_LABEL_FILE:-$R/mnt/data/ga-device-label}"
ID_FILE="${GA_IDENTITY_FILE:-$R/mnt/data/supervisor/addons/data/99f1cad4_ga_manager/ga-identity.json}"
ID_MAX=4096
PRINCIPALS_BIN="${GA_SSH_PRINCIPALS_BIN:-/usr/libexec/ga-ssh-principals}"
MAX=32

log() { echo "ga-ssh-principal-label: $*" >&2; }

# Bounded read that keeps trailing newlines (a command substitution strips
# them; the sentinel preserves them so a second line cannot hide).
read_bounded() { _v=$(head -c "$MAX" "$1" 2>/dev/null; echo x); printf '%s' "${_v%x}"; }

valid_label() {
    case "$1" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac
    printf '%s' "$1" | grep -qE '^KIB-SON-[0-9]{8}$'
}

[ -s "$CA_PUB" ] || exit 0
# Absent (and not a dangling link) → nothing delivered yet.
[ -e "$SRC" ] || [ -L "$SRC" ] || exit 0
if [ -L "$SRC" ] || [ ! -f "$SRC" ]; then
    log "$SRC is not a regular file — ignored, principals unchanged"
    exit 1
fi

raw=$(read_bounded "$SRC")
nl='
'
label=${raw%"$nl"}           # exactly one trailing newline allowed
if ! valid_label "$label"; then
    log "refusing the delivered label (${#raw} bytes) — not exactly one KIB-SON-<8 digits> line; principals unchanged"
    exit 2
fi

# compare_own <source> <own-label-or-empty>: fail closed unless it equals $label.
compare_own() {
    if ! valid_label "$2"; then
        log "$1 exists but holds no usable label — refusing the delivered label (fail closed)"
        exit 2
    fi
    if [ "$label" != "$2" ]; then
        log "refusing the delivered label — it is not this device's label ($2, from $1); principals unchanged"
        exit 2
    fi
}

sources=0
if [ -e "$OWN_FILE" ] || [ -L "$OWN_FILE" ]; then
    own=""
    [ -f "$OWN_FILE" ] && [ ! -L "$OWN_FILE" ] && own=$(read_bounded "$OWN_FILE" | tr -d ' \t\r\n')
    compare_own "$OWN_FILE" "$own"
    sources=$((sources + 1))
fi
if [ -e "$ID_FILE" ] || [ -L "$ID_FILE" ]; then
    own=""
    if [ -f "$ID_FILE" ] && [ ! -L "$ID_FILE" ]; then
        own=$(head -c "$ID_MAX" "$ID_FILE" 2>/dev/null \
            | sed -n 's/.*"device_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
    fi
    compare_own "$ID_FILE" "$own"
    sources=$((sources + 1))
fi
if [ "$sources" -eq 0 ]; then
    log "no own identity yet (neither $OWN_FILE nor $ID_FILE) — refusing the delivered label (fail closed); principals unchanged, the hardware-serial anchor stays; re-runs when ga-identity.json appears"
    exit 2
fi

exec "$PRINCIPALS_BIN" label "$label"
