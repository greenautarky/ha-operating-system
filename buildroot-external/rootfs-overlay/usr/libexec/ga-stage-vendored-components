#!/bin/sh
# ga-stage-vendored-components — stage the OS-vendored Home Assistant
# custom_components from the read-only rootfs into the persistent, addon-
# readable trees, on EVERY boot, idempotently.
#
# WHY THIS EXISTS (the OTA-converge gap, layer 1 of 2)
# ----------------------------------------------------
# Vendored integrations ship in the OS image under /usr/share/ga/
# custom_components/ (laid out by scripts/sync-components.sh at build time).
# The ga_manager addon CANNOT read the host rootfs — it only maps /share,
# /config, /ssl, /addon_configs — so a host-side step must copy the rootfs
# trees somewhere the addon can see, from where its `converge` worker (and its
# steady-state reconcile) places them into /config/custom_components/ and
# enables them (layer 2).
#
# Historically this staging was assumed to be done by `ga-bootstrap`, but that
# service is first-boot-only (ConditionPathExists=!/mnt/data/.ga-bootstrapped,
# a marker on persistent /mnt/data that survives an OS OTA). So a component
# NEWLY shipped or version-bumped in an OTA was never re-staged on already-
# provisioned devices: the staging tree kept its first-boot contents and the
# new integration silently never appeared. This oneshot closes that gap by
# running on every boot with NO marker gate — the host-side twin of
# ga_manager's steady-state vendored-component reconcile.
#
# WHERE IT STAGES, AND WHY TWO PLACES
# -----------------------------------
# THIS IS A CODE PATH, not a status file. Whatever ends up in
# /config/custom_components/<an enabled component>/ is imported and executed by
# Home Assistant Core, with Core's access to /config (including .storage) and
# to the Supervisor API. So the question for the staging tree is not who can
# read it, but who can write it.
#
#   1. <supervisor data root>/*_ga_manager/ga-custom-components  — TRUSTED, preferred.
#      The add-on's private data dir. No other add-on is given a path to it,
#      so what the placer reads is what the OS wrote. Same trust channel the
#      per-device Loki credential and the device identity already use.
#
#   2. /share/ga-custom-components  — COMPATIBILITY ONLY.
#      /share is the addon<->host bridge, writable by every add-on that
#      declares `share:rw`. ga_manager < 0.105.0 reads only this path, so it
#      is still written; from 0.105.0 the placer prefers (1) and this copy is
#      vestigial. It can be dropped once no supported addon reads it.
#
# Note what the version-gate below does NOT do. It compares manifest.json to
# skip unchanged trees — that is a CHANGE gate, not a TRUST gate. Anyone who
# can write a staging tree can write its version string too, so a tampered
# tree that bumps its version reads as "newly released" and is copied out,
# while one that keeps the version reads as "unchanged" and is left alone. No
# arrangement of this comparison detects tampering, which is why the fix is a
# location the attacker cannot write rather than a check on the content.
#
# SAFETY: best-effort — this must NEVER block boot (it is ordered
# Before=haos-supervisor.service). Every failure is logged and swallowed;
# the script always exits 0. Staging is version-gated (compares manifest.json)
# so an unchanged device performs NO writes — important for eMMC longevity.

set -u

# The three paths are overridable so the host suite
# (tests/ga_tests/stage_components) can exercise this against a temp tree.
# Nothing on a device sets them.
SRC="${GA_STAGE_SRC:-/usr/share/ga/custom_components}"
# Host path for the Supervisor "share" folder; the ga_manager addon sees this
# same directory mounted as /share.
SHARE_DST="${GA_STAGE_SHARE_DST:-/mnt/data/supervisor/share/ga-custom-components}"
# The addon's private data dir. The slug carries a per-device repository hash
# prefix, hence the glob.
if [ -n "${GA_STAGE_PRIV_GLOB:-}" ]; then
	PRIV_PARENT_GLOB="$GA_STAGE_PRIV_GLOB"
else
	. "${GA_DATA_ROOT_LIB:-/usr/libexec/ga-data-root.sh}"
	PRIV_PARENT_GLOB="$(ga_data_root_or_unresolved)/*_ga_manager"
fi

log() { echo "ga-stage-vendored-components: $*"; }

# manifest_version <manifest.json> — print the "version" string, nothing when
# the file is missing/unreadable or has no parsable dotted-numeric version.
# Pure POSIX (sed/awk-free of GNU flags): no jq and no `sort -V` dependency.
manifest_version() {
	[ -r "$1" ] || return 0
	_v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1)
	case "$_v" in
	[0-9]*) ;;
	*) return 0 ;;
	esac
	# Reject anything whose leading dotted-numeric run is malformed (e.g. "1..2").
	_core=$(printf '%s' "$_v" | sed -n 's/^\([0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/p')
	[ -n "$_core" ] && printf '%s\n' "$_v"
}

# baked_is_newer <baked_ver> <staged_ver> — exit 0 only when baked is strictly
# newer. Numeric, component-wise on the leading dotted run (2.12.9 < 2.12.12;
# a lexical compare gets that wrong). Any suffix ("-1", "rc2") is ignored, so
# equal numeric cores count as equal (= keep staged).
baked_is_newer() {
	_b=$(printf '%s' "$1" | sed 's/^\([0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/')
	_s=$(printf '%s' "$2" | sed 's/^\([0-9][0-9]*\(\.[0-9][0-9]*\)*\).*/\1/')
	while [ -n "$_b" ] || [ -n "$_s" ]; do
		_bh=${_b%%.*}; _sh=${_s%%.*}
		case "$_b" in *.*) _b=${_b#*.} ;; *) _b= ;; esac
		case "$_s" in *.*) _s=${_s#*.} ;; *) _s= ;; esac
		_bh=${_bh:-0}; _sh=${_sh:-0}
		[ "$_bh" -gt "$_sh" ] && return 0
		[ "$_bh" -lt "$_sh" ] && return 1
	done
	return 1
}

# stage_tree <dst_root> <label> — mirror every component under $SRC into
# <dst_root>. Returns non-zero only when <dst_root> is unusable.
stage_tree() {
	dst_root="$1"
	label="$2"
	newer_wins="${3:-0}"

	# $dst_root may live in a container-writable tree. If it has been replaced
	# by a symlink to e.g. /mnt/data, the `rm -rf` / `cp -a` below would
	# delete+write an arbitrary root-owned tree ("$dst_root/$name" resolving
	# outside it). Refuse to operate through a symlinked staging dir.
	# [Vuln-2 hardening]
	if [ -L "$dst_root" ]; then
		rm -f "$dst_root" 2>/dev/null || {
			log "WARN $label: $dst_root is a symlink and could not be removed — skipping"
			return 1
		}
	fi
	if ! mkdir -p "$dst_root" 2>/dev/null; then
		log "WARN $label: could not create $dst_root — skipping"
		return 1
	fi
	if [ -L "$dst_root" ] || [ ! -d "$dst_root" ]; then
		log "WARN $label: $dst_root is not a real directory — skipping"
		return 1
	fi

	staged=0
	current=0
	for comp in "$SRC"/*/; do
		[ -d "$comp" ] || continue
		name=$(basename "$comp")
		# Only stage real integrations (a directory with a manifest.json). This
		# also skips VENDORED.md and any stray non-component file.
		[ -f "$comp/manifest.json" ] || continue
		dst="$dst_root/$name"
		# Version-gate. Trusted root: NEWER-WINS. Restage the baked tree only when
		# it is strictly newer than the staged one, or the staged tree is missing /
		# unreadable / has no parsable version (fail toward baked, loudly). A newer
		# staged tree -- delivered by the fm component-sync job -- must survive
		# reboot; the old "manifest differs" gate rolled it back to the baked
		# version on every boot (Odoo #1888). Equal = unchanged = no eMMC write.
		# Compat /share root: stays a strict "differs" gate, because /share is
		# writable by other add-ons and a forged higher version must not stick.
		# See the header: this is a change gate, not a trust gate.
		if [ "$newer_wins" -eq 1 ]; then
			baked_v=$(manifest_version "$comp/manifest.json")
			staged_v=$(manifest_version "$dst/manifest.json")
			if [ -n "$baked_v" ] && [ -n "$staged_v" ]; then
				if baked_is_newer "$baked_v" "$staged_v"; then
					log "$label: restaging $name $staged_v -> baked $baked_v"
				else
					if baked_is_newer "$staged_v" "$baked_v"; then
						log "INFO $label: keeping newer staged $name $staged_v over baked $baked_v"
					fi
					current=$((current + 1))
					continue
				fi
			elif [ -e "$dst" ]; then
				log "WARN $label: staged $name has no readable version — restaging baked ${baked_v:-?}"
			fi
		elif [ -f "$dst/manifest.json" ] && cmp -s "$comp/manifest.json" "$dst/manifest.json"; then
			current=$((current + 1))
			continue
		fi
		if rm -rf "$dst" && cp -a "$comp" "$dst"; then
			staged=$((staged + 1))
		else
			log "WARN $label: failed to stage $name — leaving previous copy in place"
		fi
	done

	log "$label: staged=$staged already-current=$current into $dst_root"
	return 0
}

if [ ! -d "$SRC" ]; then
	log "no vendored source at $SRC — OS staged none; nothing to do"
	exit 0
fi

# 1. Trusted destination first, so a device whose addon is new enough never has
#    to fall back. Absent when ga_manager has not been installed yet — the glob
#    then matches nothing, and the addon reads the compat copy until the next
#    boot. That is the pre-existing behaviour, so this is no worse than before;
#    it is also not a state an attacker can induce, since nothing outside this
#    script and the addon itself can write the addon's data dir.
priv_found=0
# shellcheck disable=SC2086  # PRIV_PARENT_GLOB must word-split to expand
for priv_parent in $PRIV_PARENT_GLOB; do
	[ -d "$priv_parent" ] || continue
	priv_found=1
	stage_tree "$priv_parent/ga-custom-components" "trusted" 1
done
[ "$priv_found" -eq 1 ] || log "no ga_manager data dir yet — trusted staging skipped this boot"

# 2. Compatibility destination for addons older than 0.105.0.
stage_tree "$SHARE_DST" "compat"

exit 0
