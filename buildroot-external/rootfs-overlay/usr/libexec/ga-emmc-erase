#!/bin/sh
# ga-emmc-erase — first-boot eMMC wipe (replaces ga-flasher-py stage 35).
#
# WHY
# ---
# iHost has both an eMMC (mmcblk0) and an SD slot (mmcblk2). V1.2-clean
# always boots from SD; the eMMC's pre-existing Sonoff factory firmware
# can be intermittently chain-loaded by the bootrom if the SD card is
# slow-to-init or has a transient I/O glitch, producing weird hybrid
# boot states. Wiping the eMMC guarantees SD-only boot.
#
# Previously done out-of-band by ga-flasher-py stage 35. Baking it in
# the OS means a fresh-flash device wipes its own eMMC on first boot.
#
# SAFETY (matches stage 35's checks)
# ----------------------------------
# - Verifies root is on mmcblk2 (SD card) BEFORE touching mmcblk0.
# - Verifies mmcblk0 actually exists (some boards lack eMMC).
# - blkdiscard first (fast TRIM/hardware-erase); on failure dd zero-fill
#   the first 16 MiB to corrupt partition tables.
# - Writes idempotency marker `/mnt/data/.ga_emmc_erased` with epoch+method.
#
# RE-RUN BEHAVIOR
# ---------------
# Marker file makes this a one-shot per device lifetime. To force re-run
# (e.g. after replacing eMMC silicon — unusual), `rm /mnt/data/.ga_emmc_erased`
# and reboot.
set -e

MARKER="/mnt/data/.ga_emmc_erased"
EMMC_DEVICE="${EMMC_DEVICE:-/dev/mmcblk0}"
SD_ROOT_PATTERN="mmcblk2"

log()  { echo "ga-emmc-erase: $*"; }
warn() { echo "ga-emmc-erase: WARNING: $*" >&2; }
die()  { echo "ga-emmc-erase: ERROR: $*" >&2; exit 1; }

# 1. Idempotency.
if [ -f "$MARKER" ]; then
    log "marker present ($MARKER) — already erased; exit 0"
    log "content: $(cat $MARKER)"
    exit 0
fi

# 2. SAFETY — refuse if root isn't on the SD card.
if ! grep -q "$SD_ROOT_PATTERN" /proc/mounts; then
    die "root filesystem NOT on $SD_ROOT_PATTERN (SD card) — refusing to wipe $EMMC_DEVICE; this would brick the device"
fi
log "safety check: root is on $SD_ROOT_PATTERN (SD) ✓"

# 3. Confirm eMMC exists.
if [ ! -b "$EMMC_DEVICE" ]; then
    log "$EMMC_DEVICE not a block device — board may lack eMMC; nothing to do"
    # Still write the marker so we don't keep retrying.
    echo "no-emmc:$(date +%s)" > "$MARKER"
    exit 0
fi

# 4. Try fast TRIM (`blkdiscard`) first.
log "attempting blkdiscard on $EMMC_DEVICE (fast hardware TRIM)..."
if /usr/sbin/blkdiscard "$EMMC_DEVICE" 2>/dev/null; then
    log "blkdiscard succeeded"
    method="blkdiscard"
else
    warn "blkdiscard failed — falling back to dd zero-fill of first 16 MiB"
    if /usr/bin/dd if=/dev/zero of="$EMMC_DEVICE" bs=1M count=16 conv=fsync >/dev/null 2>&1; then
        log "dd zero-fill of first 16 MiB succeeded — partition table destroyed"
        method="dd-zero-16M"
    else
        die "both blkdiscard and dd failed — eMMC may be physically read-only or busy"
    fi
fi
sync

# 5. Write idempotency marker with method + timestamp.
mkdir -p "$(dirname "$MARKER")"
printf 'method=%s timestamp=%d device=%s\n' "$method" "$(date +%s)" "$EMMC_DEVICE" > "$MARKER"
chmod 600 "$MARKER"
log "marker written: $(cat $MARKER)"
log "eMMC erase complete — SD-only boot guaranteed on next power cycle"
exit 0
