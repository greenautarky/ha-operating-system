#!/bin/sh
# =============================================================================
# ga-ssh-posture — which SSH access plane does this device actually run?
# =============================================================================
# ADR-0019. Prints exactly one word on stdout: "ca" or "shared".
#
# "ca" requires BOTH of:
#   1. sshd trusts a user CA — TrustedUserCAKeys names a file that exists and
#      is not empty, and
#   2. the pre-cut fleet-wide operator key cannot authenticate: it is absent
#      from every authorized_keys file sshd reads, or sshd's RevokedKeys list
#      holds it.
#
# Both questions are answered from the EFFECTIVE sshd configuration — the
# directives sshd itself would use — not from a fixed path. sshd takes the
# FIRST value it reads for each keyword, reading Include'd files at the point
# of the Include. A device updated over the air keeps an overlay
# authorized_keys written by an older image; whether a key in it can log in
# depends on AuthorizedKeysFile and RevokedKeys, so that is what is judged.
#
# The WEAKER path wins. A device that trusts a CA and still lets the
# fleet-wide key in is on the shared plane in every way that matters; reporting
# "ca" there would announce the exact state the cut exists to eliminate as
# fixed, which is worse than reporting nothing at all.
#
# FAILS CLOSED. Anything missing, unreadable or ambiguous prints "shared" and
# says why on stderr. This must never print "ca" on a guess: fleet-manager
# compares this word against what the release marker promises, and a false
# "ca" is precisely what makes the contradiction disappear.
#
# The known-bad key is pinned HERE as a fingerprint constant, never read out of
# the file being inspected (norm N7 — an audit that derives its expectation
# from its subject goes green on a wrong subject).
#
# Run it by hand on a device to see the reasoning:  ga-ssh-posture -v
# -----------------------------------------------------------------------------
set -u

# The pre-cut fleet-wide operator key: RSA-2048, comment rsa-key-20240404,
# baked into every image up to and including the BOSv1.3.0 line. Its presence
# is what "shared" means.
GA_LEGACY_FLEET_KEY_FP="SHA256:T+Pt2vUEG+lYv0t5qTMdFyd2Kchx6mjkOR3YZaVqcjE"

# Overridable for the gate self-test ONLY. Never set on a device.
SSHD_CONFIG="${GA_SSHD_CONFIG:-/etc/ssh/sshd_config}"
# Home directory of the user sshd admits (root). Relative AuthorizedKeysFile
# entries and %h resolve against it, as sshd resolves them.
ROOT_HOME="${GA_SSH_ROOT_HOME:-/root}"

VERBOSE=0
[ "${1:-}" = "-v" ] && VERBOSE=1

note() { [ "$VERBOSE" = "1" ] && printf 'ga-ssh-posture: %s\n' "$*" >&2; return 0; }
# A fallback must be loud (norm N44): substituting the weaker verdict for a
# value we could not read is a finding, not a detail.
warn() { printf 'ga-ssh-posture: %s\n' "$*" >&2; }

shared() { printf 'shared\n'; exit 0; }

# --- the effective configuration ---------------------------------------------
# Prints the global directives in the order sshd reads them: the main file,
# with every `Include <glob>` replaced in place by the files it matches (name
# order, relative globs against /etc/ssh as sshd does). Reading stops at the
# first `Match` block of a file: what follows applies to some connections
# only, and the global answer is what this sensor reports.
emit_config() {  # <file> <depth>
    [ "$2" -gt 8 ] && { warn "Include nesting deeper than 8 at $1 — ignored"; return 0; }
    [ -r "$1" ] || return 0
    while IFS= read -r _line || [ -n "$_line" ]; do
        _kw=$(printf '%s\n' "$_line" | sed -nE 's/^[[:space:]]*([A-Za-z]+).*$/\1/p' | tr '[:upper:]' '[:lower:]')
        case "$_kw" in
            match) return 0 ;;
            include)
                _globs=$(printf '%s\n' "$_line" | sed -E 's/^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee]([[:space:]]*=[[:space:]]*|[[:space:]]+)//')
                # Split the argument list WITHOUT expanding it; each glob is
                # expanded below, after a relative one is anchored.
                set -f
                for _glob in $_globs; do
                    set +f
                    case "$_glob" in /*) ;; *) _glob="$(dirname "$SSHD_CONFIG")/$_glob" ;; esac
                    for _inc in $_glob; do
                        if [ -f "$_inc" ]; then emit_config "$_inc" $(( $2 + 1 )); fi
                    done
                    set -f
                done
                set +f
                ;;
            *) printf '%s\n' "$_line" ;;
        esac
    done < "$1"
}

if [ ! -r "$SSHD_CONFIG" ]; then
    note "no readable $SSHD_CONFIG"
    shared
fi
EFFECTIVE=$(emit_config "$SSHD_CONFIG" 0)

# First value of <keyword> (case-insensitive, `Key value` or `Key=value`).
first_value() {
    printf '%s\n' "$EFFECTIVE" | awk -v kw="$1" '
        { line = $0; sub(/^[ \t]+/, "", line) }
        line == "" || substr(line, 1, 1) == "#" { next }
        {
            n = match(line, /^[A-Za-z]+/)
            if (!n) next
            k = tolower(substr(line, 1, RLENGTH))
            if (k != tolower(kw)) next
            v = substr(line, RLENGTH + 1)
            sub(/^[ \t]*=?[ \t]*/, "", v); sub(/[ \t\r]+$/, "", v); gsub(/"/, "", v)
            print v; exit
        }'
}

# sshd's path tokens for the root user.
expand_path() {
    _p=$(printf '%s' "$1" | sed -e "s#%h#$ROOT_HOME#g" -e 's#%u#root#g' -e 's#%U#0#g' -e 's#%%#%#g')
    case "$_p" in /*) printf '%s\n' "$_p" ;; *) printf '%s/%s\n' "$ROOT_HOME" "$_p" ;; esac
}

# --- 1. does sshd trust a user CA? -------------------------------------------
ca_path=$(first_value TrustedUserCAKeys)
if [ -z "$ca_path" ] || [ "$ca_path" = "none" ]; then
    note "no TrustedUserCAKeys configured"
    shared
fi
ca_path=$(expand_path "$ca_path")
note "TrustedUserCAKeys -> $ca_path"
if [ ! -s "$ca_path" ]; then
    warn "TrustedUserCAKeys points at '$ca_path' which is missing or empty — \
reporting 'shared'. sshd will not accept a single certificate in this state."
    shared
fi

# --- 2. can the pre-cut fleet-wide key authenticate? --------------------------
akc=$(first_value AuthorizedKeysCommand)
if [ -n "$akc" ] && [ "$akc" != "none" ]; then
    warn "AuthorizedKeysCommand is set ('$akc') — keys it returns cannot be \
inspected here, reporting 'shared'."
    shared
fi

if ! command -v ssh-keygen >/dev/null 2>&1; then
    warn "ssh-keygen not available — cannot fingerprint the authorized keys, \
reporting 'shared'. This is a fail-closed guess, not a measurement."
    shared
fi

tmp=$(mktemp) || shared
# shellcheck disable=SC2064
trap "rm -f '$tmp'" EXIT INT TERM

# Is the pinned key on sshd's revocation list? A text list of public keys is
# fingerprinted line by line. Anything else (a missing file, a binary KRL) is
# not credited: the key then counts as usable wherever it is listed.
legacy_revoked=0
rk=$(first_value RevokedKeys)
if [ -n "$rk" ] && [ "$rk" != "none" ]; then
    rk=$(expand_path "$rk")
    if [ -r "$rk" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|'#'*) continue ;; esac
            printf '%s\n' "$line" > "$tmp"
            fp=$(ssh-keygen -lf "$tmp" 2>/dev/null | awk '{print $2}')
            [ "$fp" = "$GA_LEGACY_FLEET_KEY_FP" ] && legacy_revoked=1
        done < "$rk"
        if [ "$legacy_revoked" = "1" ]; then
            note "RevokedKeys $rk holds the legacy fleet key"
        else
            note "RevokedKeys $rk does not list the legacy fleet key"
        fi
    else
        warn "RevokedKeys points at '$rk' which is not readable — the legacy \
key is judged as if nothing revoked it."
    fi
else
    note "no RevokedKeys configured"
fi

# The files sshd reads static keys from. Unset means sshd's built-in default.
akf=$(first_value AuthorizedKeysFile)
[ -n "$akf" ] || akf=".ssh/authorized_keys .ssh/authorized_keys2"
note "AuthorizedKeysFile -> $akf"

checked=0
for entry in $akf; do
    [ "$entry" = "none" ] && continue
    ak=$(expand_path "$entry")
    if [ ! -r "$ak" ]; then
        # A missing file holds no static key, including no legacy one.
        note "no readable $ak — no static keys there"
        continue
    fi
    # `|| [ -n "$line" ]` is load-bearing: a file whose last line has no
    # trailing newline otherwise loses that line entirely — and an
    # authorized_keys written by hand very often looks exactly like that.
    # Without it the legacy key hides in the one position it is most likely
    # to occupy, and the sensor reports 'ca' while it is sitting right there.
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        printf '%s\n' "$line" > "$tmp"
        fp=$(ssh-keygen -lf "$tmp" 2>/dev/null | awk '{print $2}')
        [ -n "$fp" ] || continue
        checked=$((checked + 1))
        if [ "$fp" = "$GA_LEGACY_FLEET_KEY_FP" ]; then
            if [ "$legacy_revoked" = "1" ]; then
                note "$ak lists the legacy fleet key; sshd refuses it (RevokedKeys)"
                continue
            fi
            warn "the pre-cut fleet-wide operator key is present in $ak ($fp) \
and nothing revokes it — reporting 'shared'."
            shared
        fi
        note "authorized key $fp is not the legacy fleet key"
    done < "$ak"
done

note "checked $checked key(s); the legacy fleet key cannot authenticate"
printf 'ca\n'
