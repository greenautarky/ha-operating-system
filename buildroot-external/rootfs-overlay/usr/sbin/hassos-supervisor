#!/bin/sh
# shellcheck disable=SC1091
# ==============================================================================
# Supervisor on HassOS
# ==============================================================================
set -e

# GA: the version file this device follows is <base><channel>.json, and the
# CHANNEL is the device's own — the one the bake seeded into updater.json
# (dind-import-containers.sh) and the Supervisor keeps there. It used to be a
# literal .../main/stable.json, so a device on dev or beta that lost its
# Supervisor image re-pulled the STABLE Supervisor and then sat one version
# away from its own channel. The base stays `main`: it is what the Supervisor
# itself polls (URL_HASSIO_VERSION in the GA fork), whatever branch the image
# was BAKED from (hassio.mk HASSIO_VERSION_URL is build-time only).
GA_VERSION_URL_BASE="https://raw.githubusercontent.com/greenautarky/haos-version/main/"

# Prints the device's channel. An unreadable updater.json or an unknown value
# falls back to stable — loudly, on stderr (journal), never silently.
ga_supervisor_channel() {
    _ga_ch="$(jq -r '.channel // "stable"' "$1" 2>/dev/null)" || _ga_ch=""
    case "${_ga_ch}" in
        stable|beta|dev) echo "${_ga_ch}" ;;
        *)
            echo "[WARNING] channel in $1 is '${_ga_ch}' (unreadable or unknown) - using stable" >&2
            echo "stable"
            ;;
    esac
}

ga_channel_version_url() {
    echo "${GA_VERSION_URL_BASE}$(ga_supervisor_channel "$1").json"
}

# GA: the haos-version base URL the Supervisor polls comes from the IMAGE.
# The bake writes /etc/ga-version-url from hassio.mk's HASSIO_VERSION_URL, and
# GA Supervisor 2025.11.5.6+ reads that path inside its container (absent or
# invalid -> main, with a warning). Prints the docker option that mounts it
# there read-only. Only for a regular file: a bind mount of a missing source
# makes Docker create it — a directory, on a read-only /etc — and the container
# would not be created at all. Missing -> no mount, a loud warning, and the
# Supervisor's own fallback to main. The argument exists for the test suite.
# shellcheck disable=SC2120  # production calls it without an argument
ga_version_url_mount() {
    _ga_vu_src="${1:-/etc/ga-version-url}"
    if [ -f "${_ga_vu_src}" ]; then
        echo "-v ${_ga_vu_src}:/etc/ga-version-url:ro"
    else
        echo "[WARNING] ${_ga_vu_src} missing or not a file - the Supervisor polls haos-version main" >&2
    fi
}

# tests/ga_tests/hassos_supervisor_channel sources this file for the three
# helper functions above and must stop here, before anything touches the host.
if [ "${HASSOS_SUPERVISOR_FUNCTIONS_ONLY:-0}" = "1" ]; then
    return 0
fi

# Load configs
. /etc/os-release

# Init supervisor
SUPERVISOR_DATA=/mnt/data/supervisor
SUPERVISOR_STARTUP_MARKER="/run/supervisor/startup-marker"
SUPERVISOR_CIDFILE="${SUPERVISOR_DATA}/hassio_supervisor.cid"
SUPERVISOR_STARTSCRIPT_VERSION="/mnt/data/.hassos-supervisor-version"
SUPERVISOR_IMAGE="ghcr.io/greenautarky/${SUPERVISOR_ARCH}-hassio-supervisor"

SUPERVISOR_IMAGE_ID=$(docker images --no-trunc --filter "reference=${SUPERVISOR_IMAGE}:latest" --format "{{.ID}}" || echo "")
SUPERVISOR_CONTAINER_ID=$(docker inspect --format='{{.Image}}' hassio_supervisor || echo "")

# Check if previous run left the startup-marker in place. If so, we assume the
# Container image or container is somehow corrupted.
# Delete the container, delete the image, pull a fresh one
if [ -f "${SUPERVISOR_STARTUP_MARKER}" ]; then
    echo "[WARNING] Supervisor container did not remove the startup marker file. Assuming container image or container corruption."
    docker container rm --force hassio_supervisor || true
    SUPERVISOR_CONTAINER_ID=""

    # Make sure we delete all supervisor images
    SUPERVISOR_IMAGE_IDS=$(docker images --no-trunc --filter "reference=${SUPERVISOR_IMAGE}" --format "{{.ID}}" | sort | uniq || echo "")
    # Intended splitting of SUPERVISOR_IMAGE_IDS
    # Busybox sh doesn't support arrays
    # shellcheck disable=SC2086
    docker image rm --force ${SUPERVISOR_IMAGE_IDS} || true
    SUPERVISOR_IMAGE_ID=""
fi

mkdir -p "$(dirname ${SUPERVISOR_STARTUP_MARKER})"
touch ${SUPERVISOR_STARTUP_MARKER}

# If Supervisor image is missing, pull it
if [ -z "${SUPERVISOR_IMAGE_ID}" ]; then
    # Get the latest from update information
    # Using updater information instead of config. If the config version is
    # broken, this creates a way back (e.g., bad release).
    SUPERVISOR_VERSION=$(jq -r '.supervisor // "stable"' "${SUPERVISOR_DATA}/updater.json" || echo "stable")

    # No local version information ("stable" is jq's placeholder above, not a
    # channel): ask the device's OWN channel file, not always stable.json.
    if [ "${SUPERVISOR_VERSION}" = "stable" ]; then
        GA_CHANNEL_URL="$(ga_channel_version_url "${SUPERVISOR_DATA}/updater.json")"
        echo "[INFO] No local Supervisor version, asking ${GA_CHANNEL_URL}"
        SUPERVISOR_VERSION="$(curl -s --location "${GA_CHANNEL_URL}" | jq -e -r '.supervisor')"
    fi

    echo "[WARNING] Supervisor image missing, downloading a fresh one: ${SUPERVISOR_VERSION}"

    # Pull in the Supervisor
    if docker pull "${SUPERVISOR_IMAGE}:${SUPERVISOR_VERSION}"; then
        # Tag as latest
        docker tag "${SUPERVISOR_IMAGE}:${SUPERVISOR_VERSION}" "${SUPERVISOR_IMAGE}:latest"
    else
        # Pull failed, updater info might be corrupted or the release might have
        # been removed from the container registry, delete the updater info
        # to start from scratch on next try.
        echo "[ERROR] Supervisor download failed."
        rm -f "${SUPERVISOR_DATA}/updater.json"
        exit 1
    fi

    SUPERVISOR_IMAGE_ID=$(docker inspect --format='{{.Id}}' "${SUPERVISOR_IMAGE}" || echo "")
fi

if [ -n "${SUPERVISOR_CONTAINER_ID}" ]; then
    # Image changed, remove previous container
    if [ "${SUPERVISOR_IMAGE_ID}" != "${SUPERVISOR_CONTAINER_ID}" ]; then
        echo "[INFO] Supervisor image has been updated, destroying previous container..."
        docker container rm --force hassio_supervisor || true
        SUPERVISOR_CONTAINER_ID=""
    fi

    # Start script changed, remove previous container
    # shellcheck disable=SC3013
    if [ ! -f "${SUPERVISOR_STARTSCRIPT_VERSION}" ] || [ "${SUPERVISOR_STARTSCRIPT_VERSION}" -nt "$0" ] || [ "${SUPERVISOR_STARTSCRIPT_VERSION}" -ot "$0" ]; then
        echo "[INFO] Supervisor start script has changed, destroying previous container..."
        docker container rm --force hassio_supervisor || true
        SUPERVISOR_CONTAINER_ID=""
    fi
fi

# If Supervisor container is missing, create it
if [ -z "${SUPERVISOR_CONTAINER_ID}" ]; then
    # We need to remove the CID file here, Docker will refuse to start if the
    # file is present. Single instance is ensured by other code paths.
    [ -f "${SUPERVISOR_CIDFILE}" ] && rm -f "${SUPERVISOR_CIDFILE}"

    # GA: let the Supervisor SEE the config it already reads.
    #
    # The Supervisor fork's DNS plugin injects influx/loki/ota.greenautarky.com
    # into CoreDNS for containers and add-ons, and it learns the target IP from
    # /etc/ga-services.conf (GA_SERVICES_IP, GA_OTA_IPS). That file was never
    # mounted, so both lookups failed inside the container and the plugin fell
    # back to a HARDCODED address — dns.py:429, _GA_HARDCODED_FALLBACK_IP.
    #
    # Measured on a bench device 2026-07-30:
    #   docker exec hassio_supervisor ls /etc/ga-services.conf -> No such file
    #   supervisor.plugins.dns logged the hardcoded fallback, not the configured
    #   address, while the HOST resolved the same names correctly via /etc/hosts.
    # The fallback pointed at a superseded endpoint, so every container doing
    # HTTPS to a GA name hit a TLS failure (curl exit 60) that a lenient probe
    # would have called healthy. Addresses and host state: see ga-ihost-docs.
    #
    # Mounting the file is deliberately preferred over correcting the hardcoded
    # constant: the constant would be correct until the next server move, and
    # this repo already carries four copies of that address ageing at different
    # rates. One source of truth beats a fresher duplicate.
    #
    # Read-only, and conditional: bind-mounting a MISSING source makes Docker
    # create a directory at the destination, which would break the read it is
    # supposed to fix. The /mnt/data override is the same file's runtime twin and
    # legitimately may not exist.
    GA_SERVICES_MOUNT=""
    if [ -f /etc/ga-services.conf ]; then
        GA_SERVICES_MOUNT="-v /etc/ga-services.conf:/etc/ga-services.conf:ro"
    else
        echo "[WARNING] /etc/ga-services.conf missing — Supervisor DNS will fall back to its hardcoded IP"
    fi
    if [ -f /mnt/data/ga-services.conf ]; then
        GA_SERVICES_MOUNT="${GA_SERVICES_MOUNT} -v /mnt/data/ga-services.conf:/mnt/data/ga-services.conf:ro"
    fi

    # The version URL the Supervisor polls (see ga_version_url_mount above).
    # shellcheck disable=SC2119
    GA_VERSION_URL_MOUNT="$(ga_version_url_mount)"

    echo "[INFO] Creating a new Supervisor container..."
    # shellcheck disable=SC2086
    docker container create \
        --name hassio_supervisor \
        --privileged --security-opt apparmor="hassio-supervisor" \
        --oom-score-adj=-300 \
        --cidfile "${SUPERVISOR_CIDFILE}" \
        --mount type=bind,src="${SUPERVISOR_CIDFILE}",dst=/run/cid,readonly \
        -v /run/docker.sock:/run/docker.sock:rw \
        -v /run/containerd/containerd.sock:/run/containerd/containerd.sock:rw \
        -v /run/systemd/journal/socket:/run/systemd/journal/socket:rw \
        -v /run/systemd-journal-gatewayd.sock:/run/systemd-journal-gatewayd.sock:rw \
        -v /run/dbus:/run/dbus:ro \
        -v /run/supervisor:/run/os:rw \
        -v /run/udev:/run/udev:ro \
        -v /etc/machine-id:/etc/machine-id:ro \
        -v ${SUPERVISOR_DATA}:/data:rw,slave \
        ${GA_SERVICES_MOUNT} \
        ${GA_VERSION_URL_MOUNT} \
        -e SUPERVISOR_SHARE=${SUPERVISOR_DATA} \
        -e SUPERVISOR_NAME=hassio_supervisor \
        -e SUPERVISOR_MACHINE=${SUPERVISOR_MACHINE} \
        "${SUPERVISOR_IMAGE}:latest"

    # Store the timestamp of this script. If the script changed, let's
    # recreate the container automatically.
    touch --reference="$0" "${SUPERVISOR_STARTSCRIPT_VERSION}"
fi

# Run supervisor
mkdir -p ${SUPERVISOR_DATA}
echo "[INFO] Starting the Supervisor..."
docker container start hassio_supervisor
exec docker container wait hassio_supervisor
