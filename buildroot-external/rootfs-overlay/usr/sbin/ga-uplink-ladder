#!/bin/sh
# ga-uplink-ladder — stay on a rung that actually carries internet.
#
# THE PROBLEM THIS SOLVES
# -----------------------
# A device has up to four ways out: Ethernet, the customer's WiFi, the LTE
# stick's AP, and the install WiFi. NetworkManager picks among the ones that
# are UP, by route metric. Nothing asked whether the chosen one WORKS. An
# associated WiFi whose router lost its line, a stick whose SIM ran dry, a
# hotel-style portal — all of them stay the default route for ever, and the
# device is gone with every surface reporting "connected".
#
# NM already knows the answer: it probes https://checkonline.greenautarky.com
# and reports `full | limited | portal | none` (see NetworkManager.conf). What
# was missing is someone who ACTS on it. This is that someone.
#
# HOW IT DECIDES
# --------------
#   every tick (120 s):  read NM's CACHED verdict — free, no traffic
#   verdict not `full`:  force ONE probe (`connectivity check`) — the "fast
#                        only when suspicious" rule: a healthy device costs
#                        nothing extra, a metered SIM is not probed per minute
#   3 confirmed strikes: PARK the active connection (autoconnect no + down) so
#                        NM falls to the next rung, and record a cooldown
#   cooldown expired:    UNPARK and let it compete again
#
# TWO RULES IT MUST NEVER BREAK
# -----------------------------
#   * Never park the LAST rung. A device with nothing else to fall to must keep
#     what it has, however bad — parking it would be this script causing the
#     outage it exists to prevent. It says so and keeps probing.
#   * ...but never stop LOOKING (Odoo #2112). "Last rung" is judged from the
#     NM Wi-Fi scan CACHE, which goes stale (K31, 2026-11-16: hours on a dead
#     dongle Wi-Fi while the bench Wi-Fi was in range). So before giving up the
#     ladder forces a rescan, waits a bounded time and re-evaluates; and while
#     the device stays offline on its last rung it repeats that EVERY tick, so
#     an SSID that appears later is found. A switch is verified on the next
#     tick; if the new rung is not `full` either, the previous one is restored
#     and the candidate is not retried for TRIED_COOLDOWN_S (no flapping).
#   * A single radio holds ONE association. Falling back to the stick means
#     taking the customer WiFi down first — that is why parking is an explicit
#     `down`, not a metric change.
#
# It writes /mnt/data/supervisor/share/ga-uplink.json on every change, so the
# fleet can see which rung a device stands on and why it moved. An uplink that
# switches silently is how we end up debugging a site instead of reading it.
#
# POSIX /bin/sh. Every path and command is env-overridable so the decision
# logic runs host-side against a stub nmcli (tests/ga_tests/uplink_ladder).
set -u

NMCLI="${GA_NMCLI:-nmcli}"
IP_BIN="${GA_IP:-ip}"
STATE="${GA_LADDER_STATE:-/run/ga-uplink-ladder.state}"
BOOT_MARK="${GA_LADDER_BOOT_MARK:-/run/ga-uplink-ladder.booted}"
PARK_DIR="${GA_LADDER_PARK_DIR:-/run/ga-uplink-parked}"
STATUS="${GA_LADDER_STATUS:-/mnt/data/supervisor/share/ga-uplink.json}"
# The status file lives in the shared directory, so it is published through
# ga-share-publish (staged, then renamed into place) — never opened in place.
PUBLISH="${GA_SHARE_PUBLISH:-/usr/libexec/ga-share-publish}"
SYS_NET="${GA_LADDER_SYS_NET:-/sys/class/net}"
FAIL_THRESHOLD="${GA_LADDER_FAILS:-3}"
COOLDOWN_S="${GA_LADDER_COOLDOWN_S:-900}"
NOW="${GA_LADDER_NOW:-$(date -u +%s)}"
TRIED_DIR="${GA_LADDER_TRIED_DIR:-/run/ga-uplink-tried}"
RESCAN_WAIT_S="${GA_LADDER_RESCAN_WAIT_S:-8}"
UP_TIMEOUT_S="${GA_LADDER_UP_TIMEOUT_S:-25}"
SETTLE_S="${GA_LADDER_SETTLE_S:-90}"
TRIED_COOLDOWN_S="${GA_LADDER_TRIED_COOLDOWN_S:-600}"
SWITCH_REC="$STATE.switch"
RESCAN_REC="$STATE.rescan"
# per-tick facts published in the status file
SPARE=""; LAST_RUNG=false; SEARCHING=false
LAST_RESCAN=$(cat "$RESCAN_REC" 2>/dev/null || true)
LOG_TAG=ga-uplink-ladder

log() { logger -t "$LOG_TAG" -p "daemon.$1" "$2" 2>/dev/null || echo "$LOG_TAG: $2" >&2; }

# --- what NM says, without spending traffic ---------------------------------
cached_verdict() { $NMCLI -t -f CONNECTIVITY general status 2>/dev/null | head -1; }
forced_verdict() { $NMCLI networking connectivity check 2>/dev/null | head -1; }

# The connection that currently carries the default route. Empty when there is
# no default route at all — which is itself a "not full" situation.
active_connection() {
    _dev=$($IP_BIN -4 route show default 2>/dev/null | head -1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
    [ -n "$_dev" ] || return 0
    $NMCLI -t -f NAME,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v d="$_dev" '$2==d {print $1; exit}'
}

# Can this profile actually carry traffic if we fall to it?
#
# MEASURED ON K31 (rc42, 2026-09-19) — the first thing the device said that the
# host-side tests could not: the ladder parked the only working uplink. It had
# counted `Wired connection 1` as a spare rung because the profile exists and
# may autoconnect — with no cable in the socket. `lo` and `wt0` (the mesh
# WireGuard link, which RIDES on the uplink) were candidates too. Three
# "rungs", none of which can carry a packet, and a device that took itself off
# the network to reach them.
#
# So a spare rung is not a profile that exists. It is a profile whose medium is
# there: a cable with carrier, an SSID in range, a modem. Anything we cannot
# PROVE carries traffic is not a spare — fail closed, because the cost of being
# wrong here is the outage this script exists to prevent.
eth_has_carrier() {
    _if=$($NMCLI -t -f connection.interface-name connection show "$1" 2>/dev/null | cut -d: -f2-)
    [ -n "$_if" ] || return 1
    [ "$(cat "$SYS_NET/$_if/carrier" 2>/dev/null)" = "1" ]
}

wifi_in_range() {
    _ssid=$($NMCLI -t -f 802-11-wireless.ssid connection show "$1" 2>/dev/null | cut -d: -f2-)
    [ -n "$_ssid" ] || return 1
    $NMCLI -t -f SSID device wifi list 2>/dev/null | grep -qx "$_ssid"
}

# One line per candidate profile: "OK<TAB>name" or "NO<TAB>name: reason".
# Non-uplink types (loopback, wireguard, bridge, tun) are not listed at all.
rung_report() {
    _active="$1"
    $NMCLI -t -f NAME,TYPE,AUTOCONNECT connection show 2>/dev/null | while IFS=: read -r _n _t _a; do
        [ "$_n" = "$_active" ] && continue
        case "$_t" in 802-3-ethernet|802-11-wireless|gsm|cdma) ;; *) continue ;; esac
        if [ -f "$PARK_DIR/$_n" ]; then
            printf 'NO\t%s: parked (cooldown until %s)\n' "$_n" "$(cat "$PARK_DIR/$_n" 2>/dev/null)"; continue
        fi
        if [ -f "$TRIED_DIR/$_n" ]; then
            _tu=$(cat "$TRIED_DIR/$_n" 2>/dev/null || echo 0)
            if [ "$NOW" -lt "$_tu" ] 2>/dev/null; then
                printf 'NO\t%s: tried, not full (retry after %s)\n' "$_n" "$_tu"; continue
            fi
            rm -f "$TRIED_DIR/$_n"
        fi
        if [ "$_a" != "yes" ]; then printf 'NO\t%s: autoconnect off\n' "$_n"; continue; fi
        case "$_t" in
            802-3-ethernet)
                if eth_has_carrier "$_n"; then printf 'OK\t%s\n' "$_n"; else printf 'NO\t%s: no carrier\n' "$_n"; fi ;;
            802-11-wireless)
                if wifi_in_range "$_n"; then printf 'OK\t%s\n' "$_n"; else printf 'NO\t%s: SSID not in range\n' "$_n"; fi ;;
            gsm|cdma) printf 'OK\t%s\n' "$_n" ;;
        esac
    done
}

# Rungs that could take over: another profile, allowed to autoconnect, not
# parked, not recently tried, of an uplink type, and with its medium present.
spare_rungs() { rung_report "$1" | sed -n 's/^OK\t//p'; }

iso_now() { date -u -d "@$NOW" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ; }

# The cache is not the world: ask the radio, give it a bounded moment.
rescan_wait() {
    $NMCLI device wifi rescan >/dev/null 2>&1
    sleep "$RESCAN_WAIT_S"
    LAST_RESCAN=$(iso_now)
    echo "$LAST_RESCAN" > "$RESCAN_REC" 2>/dev/null
}

# Sets SPARE (first usable rung, "" if none). Rescans once before giving up and
# says, at warning level, why every other known rung was rejected (rule 44).
pick_spare() {
    _rep=$(rung_report "$1")
    if ! printf '%s\n' "$_rep" | grep -q '^OK'; then
        log warning "no spare uplink in the scan cache — forcing a Wi-Fi rescan (${RESCAN_WAIT_S}s) before judging '${1:-none}' the last rung"
        rescan_wait
        _rep=$(rung_report "$1")
    fi
    SPARE=$(printf '%s\n' "$_rep" | sed -n 's/^OK\t//p' | head -1)
    printf '%s\n' "$_rep" | sed -n 's/^NO\t//p' | while IFS= read -r _l; do
        log warning "uplink candidate rejected: $_l"
    done
    [ -z "$SPARE" ] || log notice "uplink candidate '$SPARE' is a usable spare"
    return 0
}

park() {
    _c="$1"; _why="$2"
    mkdir -p "$PARK_DIR"
    echo $((NOW + COOLDOWN_S)) > "$PARK_DIR/$_c"
    $NMCLI connection modify "$_c" connection.autoconnect no >/dev/null 2>&1
    $NMCLI connection down "$_c" >/dev/null 2>&1
    log warning "parked '$_c' for ${COOLDOWN_S}s — $_why. Falling to the next uplink."
}

unpark() {
    _c="$1"
    rm -f "$PARK_DIR/$_c"
    $NMCLI connection modify "$_c" connection.autoconnect yes >/dev/null 2>&1
    log notice "unparked '$_c' — its cooldown expired, it may compete again"
}

# A reboot is a fresh start: let every rung try before we judge any of them.
# Parking persists in the keyfile (autoconnect=no), so without this a device
# could come up with a rung disabled by a decision taken before the reboot.
unpark_all_on_boot() {
    [ -f "$BOOT_MARK" ] && return 0
    rm -rf "$TRIED_DIR" "$SWITCH_REC"
    [ -d "$PARK_DIR" ] && for _f in "$PARK_DIR"/*; do
        [ -e "$_f" ] || continue
        unpark "$(basename "$_f")"
    done
    mkdir -p "$(dirname "$BOOT_MARK")" 2>/dev/null
    : > "$BOOT_MARK"
}

release_expired() {
    [ -d "$PARK_DIR" ] || return 0
    for _f in "$PARK_DIR"/*; do
        [ -e "$_f" ] || continue
        _until=$(cat "$_f" 2>/dev/null || echo 0)
        [ "$NOW" -ge "$_until" ] 2>/dev/null && unpark "$(basename "$_f")"
    done
}

write_status() {
    printf '{"rung":"%s","verdict":"%s","strikes":%s,"parked":"%s","spare":"%s","last_rung":%s,"searching":%s,"last_rescan":"%s","updated_at":"%s"}\n' \
        "$1" "$2" "$3" "$(ls "$PARK_DIR" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')" \
        "$SPARE" "$LAST_RUNG" "$SEARCHING" "$LAST_RESCAN" "$(iso_now)" \
        | "$PUBLISH" "$STATUS" 0644 || log warning "could not publish $STATUS"
}

# Take a candidate up explicitly (bounded), and remember to verify it next tick.
switch_to() {
    _prev="$1"; _cand="$2"
    $NMCLI -w "$UP_TIMEOUT_S" connection up "$_cand" >/dev/null 2>&1 \
        || log warning "'connection up $_cand' did not complete within ${UP_TIMEOUT_S}s — NM may still bring it up"
    echo "$_prev|$_cand|$NOW" > "$SWITCH_REC"
    log warning "switched '${_prev:-none}' -> '$_cand' — verifying on the next tick, falling back if it is not full either"
}

# Previous tick moved us to a candidate. Full -> done. Not full after the settle
# time -> restore the previous rung and bar the candidate for a while.
# Returns 0 only when it fell back.
check_switch() {
    [ -f "$SWITCH_REC" ] || return 1
    IFS='|' read -r _p _cand _at < "$SWITCH_REC"
    if [ "$1" = "full" ]; then
        log notice "candidate '$_cand' verified full — staying on it"
        rm -f "$SWITCH_REC"; return 1
    fi
    [ $((NOW - _at)) -ge "$SETTLE_S" ] || return 1
    mkdir -p "$TRIED_DIR"; echo $((NOW + TRIED_COOLDOWN_S)) > "$TRIED_DIR/$_cand"
    rm -f "$SWITCH_REC"
    if [ -n "$_p" ]; then
        [ -f "$PARK_DIR/$_p" ] && unpark "$_p"
        $NMCLI -w "$UP_TIMEOUT_S" connection up "$_p" >/dev/null 2>&1
        log warning "candidate '$_cand' is not full either ('$1') — fell back to previous '$_p'; '$_cand' barred for ${TRIED_COOLDOWN_S}s"
    else
        log warning "candidate '$_cand' is not full ('$1') — barred for ${TRIED_COOLDOWN_S}s, still searching"
    fi
    return 0
}

main() {
    unpark_all_on_boot
    release_expired

    _active=$(active_connection)
    _strikes=$(cat "$STATE" 2>/dev/null || echo 0)
    case "$_strikes" in ''|*[!0-9]*) _strikes=0 ;; esac

    _verdict=$(cached_verdict)
    if [ "$_verdict" != "full" ]; then
        # Suspicion — and only here — costs one request.
        _verdict=$(forced_verdict)
    fi

    if [ "$_verdict" = "full" ]; then
        [ "$_strikes" -gt 0 ] && log notice "uplink '$_active' is healthy again after $_strikes strike(s)"
        echo 0 > "$STATE"
        write_status "${_active:-none}" "$_verdict" 0
        return 0
    fi

    _strikes=$((_strikes + 1))
    echo "$_strikes" > "$STATE"
    log warning "uplink '${_active:-none}' reports '$_verdict' (strike $_strikes/$FAIL_THRESHOLD)"
    write_status "${_active:-none}" "$_verdict" "$_strikes"

    if check_switch "$_verdict"; then
        # fell back: stay one strike short of the threshold so the search
        # resumes on the very next tick
        echo $((FAIL_THRESHOLD - 1)) > "$STATE"
        write_status "${_active:-none}" "$_verdict" $((FAIL_THRESHOLD - 1))
        return 0
    fi

    [ "$_strikes" -ge "$FAIL_THRESHOLD" ] || return 0
    pick_spare "$_active"
    if [ -z "$SPARE" ]; then
        LAST_RUNG=true; SEARCHING=true
        if [ -z "$_active" ]; then
            log warning "NO default route and no usable candidate (after a rescan) — device is OFFLINE, searching again next tick"
        else
            log warning "'$_active' is the LAST uplink ('$_verdict') — keeping it, but OFFLINE searching continues every tick. Parking it would take the device off the network entirely."
        fi
        write_status "${_active:-none}" "$_verdict" "$_strikes"
        return 0
    fi
    if [ -z "$_active" ]; then
        switch_to "" "$SPARE"
        echo 0 > "$STATE"
        write_status "switching" "$_verdict" 0
        return 0
    fi
    park "$_active" "no internet after $_strikes checks ($_verdict)"
    switch_to "$_active" "$SPARE"
    echo 0 > "$STATE"
    write_status "switching" "$_verdict" 0
}

main "$@"
