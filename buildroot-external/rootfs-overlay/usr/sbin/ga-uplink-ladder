#!/bin/sh
# ga-uplink-ladder — stay on a rung that actually carries internet.
#
# THE PROBLEM THIS SOLVES
# -----------------------
# A device has up to four ways out: Ethernet, the customer's WiFi, the LTE
# stick's AP, and the install WiFi. NetworkManager picks among the ones that
# are UP, by route metric. Nothing asked whether the chosen one WORKS. An
# associated WiFi whose router lost its line, a stick whose SIM ran dry, a
# hotel-style portal — all of them stay the default route for ever, and the
# device is gone with every surface reporting "connected".
#
# NM already knows the answer: it probes https://checkonline.greenautarky.com
# and reports `full | limited | portal | none` (see NetworkManager.conf). What
# was missing is someone who ACTS on it. This is that someone.
#
# HOW IT DECIDES
# --------------
#   every tick (120 s):  read NM's CACHED verdict — free, no traffic
#   verdict not `full`:  force ONE probe (`connectivity check`) — the "fast
#                        only when suspicious" rule: a healthy device costs
#                        nothing extra, a metered SIM is not probed per minute
#   3 confirmed strikes: PARK the active connection (autoconnect no + down) so
#                        NM falls to the next rung, and record a cooldown
#   cooldown expired:    UNPARK and let it compete again
#
# TWO RULES IT MUST NEVER BREAK
# -----------------------------
#   * Never park the LAST rung. A device with nothing else to fall to must keep
#     what it has, however bad — parking it would be this script causing the
#     outage it exists to prevent. It says so and keeps probing.
#   * ...but never stop LOOKING (Odoo #2112). "Last rung" is judged from the
#     NM Wi-Fi scan CACHE, which goes stale (K31, 2026-11-16: hours on a dead
#     dongle Wi-Fi while the bench Wi-Fi was in range). So before giving up the
#     ladder forces a rescan, waits a bounded time and re-evaluates; and while
#     the device stays offline on its last rung it repeats that EVERY tick, so
#     an SSID that appears later is found. A switch is verified on the next
#     tick; if the new rung is not `full` either, the previous one is restored
#     and the candidate is not retried for TRIED_COOLDOWN_S (no flapping).
#   * A single radio holds ONE association. Falling back to the stick means
#     taking the customer WiFi down first — that is why parking is an explicit
#     `down`, not a metric change.
#
# BUILT-IN MODEM RUNG (boards that have one: DSGW-210; Odoo #2176)
# ---------------------------------------------------------------
# A board whose ga-board.conf sets GA_BUILTIN_MODEM=1 has a modem soldered on.
# On such a board, and ONLY there (the iHost keeps the behaviour above exactly):
#   * the `gsm` profile is a rung only while NM sees a modem that is usable
#     (device present, SIM readable, state not unavailable). Without that it is
#     rejected with the reason, like a cable-less Ethernet profile.
#   * falling to the modem parks the dead rung for GA_LADDER_MODEM_BACK_S (not
#     the long cooldown). When that expires the ladder moves back through the
#     same verified switch as any candidate; if the returning rung is still not
#     full the modem is restored and the rung is parked again, so a dead
#     Ethernet cannot hold the default route.
#   * the APN is a config value, never a literal: /mnt/boot/ga-lte-apn (one
#     line) wins, then GA_LTE_APN_DEFAULT from the board file, else empty =
#     ModemManager / NM auto-config from the SIM. Applied to the profile when it
#     differs; the profile is re-activated only if it is up already.
#   * the status file gains a `modem` object (present / registered / bearer_up /
#     iface / operator / tech / signal / state). ga_manager reads it: the add-on
#     container has no mmcli and no host interfaces.
# NM ranks the modem profile last (route-metric 700), so Ethernet and WLAN win
# whenever they are up, and a cable pulled fails over with no ladder tick.
#
# It writes /mnt/data/supervisor/share/ga-uplink.json on every change, so the
# fleet can see which rung a device stands on and why it moved. An uplink that
# switches silently is how we end up debugging a site instead of reading it.
#
# POSIX /bin/sh. Every path and command is env-overridable so the decision
# logic runs host-side against a stub nmcli (tests/ga_tests/uplink_ladder).
set -u

# Per-board values (GA_BUILTIN_MODEM, GA_LTE_PROFILE, GA_LTE_APN_DEFAULT). Absent
# on the iHost, which has no built-in modem: everything below then stays inert.
GA_BOARD_CONF="${GA_BOARD_CONF:-/usr/share/ga-board.conf}"
# shellcheck disable=SC1090
[ -r "$GA_BOARD_CONF" ] && . "$GA_BOARD_CONF"
BUILTIN_MODEM="${GA_BUILTIN_MODEM:-0}"
LTE_PROFILE="${GA_LTE_PROFILE:-DSGW-210 LTE}"
LTE_APN_DEFAULT="${GA_LTE_APN_DEFAULT:-}"
LTE_APN_FILE="${GA_LTE_APN_FILE:-/mnt/boot/ga-lte-apn}"
MODEM_BACK_S="${GA_LADDER_MODEM_BACK_S:-600}"
MMCLI="${GA_MMCLI:-mmcli}"
MODEM_JSON=""
# SIM inserted after the modem started (Odoo #2176): the BG96 ships with SIM
# detection off (AT+QSIMDET 0,0, measured on DUT2 2026-11-18), so ModemManager
# keeps the modem `failed / sim-missing` until it is power-cycled, and
# `mmcli --reset` is unsupported on it. The ladder resets the modem itself
# (AT+CFUN=1,1 on a port ModemManager does not use as primary), after a grace
# period, rate-limited and capped per boot. No port configured = no reset.
MODEM_RESET_PORT="${GA_MODEM_RESET_PORT:-}"
SIM_GRACE_S="${GA_LADDER_SIM_GRACE_S:-180}"
SIM_RESET_EVERY_S="${GA_LADDER_SIM_RESET_EVERY_S:-1800}"
SIM_RESET_MAX="${GA_LADDER_SIM_RESET_MAX:-3}"
NMCLI="${GA_NMCLI:-nmcli}"
IP_BIN="${GA_IP:-ip}"
STATE="${GA_LADDER_STATE:-/run/ga-uplink-ladder.state}"
BOOT_MARK="${GA_LADDER_BOOT_MARK:-/run/ga-uplink-ladder.booted}"
PARK_DIR="${GA_LADDER_PARK_DIR:-/run/ga-uplink-parked}"
STATUS="${GA_LADDER_STATUS:-/mnt/data/supervisor/share/ga-uplink.json}"
# The status file lives in the shared directory, so it is published through
# ga-share-publish (staged, then renamed into place) — never opened in place.
PUBLISH="${GA_SHARE_PUBLISH:-/usr/libexec/ga-share-publish}"
SYS_NET="${GA_LADDER_SYS_NET:-/sys/class/net}"
FAIL_THRESHOLD="${GA_LADDER_FAILS:-3}"
COOLDOWN_S="${GA_LADDER_COOLDOWN_S:-900}"
NOW="${GA_LADDER_NOW:-$(date -u +%s)}"
TRIED_DIR="${GA_LADDER_TRIED_DIR:-/run/ga-uplink-tried}"
RESCAN_WAIT_S="${GA_LADDER_RESCAN_WAIT_S:-8}"
UP_TIMEOUT_S="${GA_LADDER_UP_TIMEOUT_S:-25}"
SETTLE_S="${GA_LADDER_SETTLE_S:-90}"
TRIED_COOLDOWN_S="${GA_LADDER_TRIED_COOLDOWN_S:-600}"
SWITCH_REC="$STATE.switch"
RESCAN_REC="$STATE.rescan"
# per-tick facts published in the status file
SPARE=""; LAST_RUNG=false; SEARCHING=false
LAST_RESCAN=$(cat "$RESCAN_REC" 2>/dev/null || true)
LOG_TAG=ga-uplink-ladder

log() { logger -t "$LOG_TAG" -p "daemon.$1" "$2" 2>/dev/null || echo "$LOG_TAG: $2" >&2; }

# --- what NM says, without spending traffic ---------------------------------
cached_verdict() { $NMCLI -t -f CONNECTIVITY general status 2>/dev/null | head -1; }
forced_verdict() { $NMCLI networking connectivity check 2>/dev/null | head -1; }

# The connection that currently carries the default route. Empty when there is
# no default route at all — which is itself a "not full" situation.
active_connection() {
    _dev=$($IP_BIN -4 route show default 2>/dev/null | head -1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')
    [ -n "$_dev" ] || return 0
    $NMCLI -t -f NAME,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v d="$_dev" '$2==d {print $1; exit}'
}

# Can this profile actually carry traffic if we fall to it?
#
# MEASURED ON K31 (rc42, 2026-09-19) — the first thing the device said that the
# host-side tests could not: the ladder parked the only working uplink. It had
# counted `Wired connection 1` as a spare rung because the profile exists and
# may autoconnect — with no cable in the socket. `lo` and `wt0` (the mesh
# WireGuard link, which RIDES on the uplink) were candidates too. Three
# "rungs", none of which can carry a packet, and a device that took itself off
# the network to reach them.
#
# So a spare rung is not a profile that exists. It is a profile whose medium is
# there: a cable with carrier, an SSID in range, a modem. Anything we cannot
# PROVE carries traffic is not a spare — fail closed, because the cost of being
# wrong here is the outage this script exists to prevent.
eth_has_carrier() {
    _if=$($NMCLI -t -f connection.interface-name connection show "$1" 2>/dev/null | cut -d: -f2-)
    [ -n "$_if" ] || return 1
    [ "$(cat "$SYS_NET/$_if/carrier" 2>/dev/null)" = "1" ]
}

wifi_in_range() {
    _ssid=$($NMCLI -t -f 802-11-wireless.ssid connection show "$1" 2>/dev/null | cut -d: -f2-)
    [ -n "$_ssid" ] || return 1
    $NMCLI -t -f SSID device wifi list 2>/dev/null | grep -qx "$_ssid"
}

# --- the built-in modem (BUILTIN_MODEM=1 boards only) -----------------------
# NM's own view of the modem device: "<device>:<state>", empty when none. NM
# keeps a modem without a readable SIM `unavailable`, so state is the medium test.
modem_device() {
    $NMCLI -t -f DEVICE,TYPE,STATE device 2>/dev/null \
        | awk -F: '$2=="gsm"||$2=="cdma" {print $1":"$3; exit}'
}
modem_usable() {
    _md=$(modem_device); [ -n "$_md" ] || return 1
    case "${_md#*:}" in unavailable|unmanaged|"") return 1 ;; esac
    return 0
}
profile_type() { $NMCLI -t -f connection.type connection show "$1" 2>/dev/null | cut -d: -f2-; }
is_modem_profile() { [ "$BUILTIN_MODEM" = 1 ] && [ -n "$1" ] && [ "$(profile_type "$1")" = gsm ]; }

# value of a `mmcli -m any -K` line ("key : value"); empty when absent
mm_get() { printf '%s\n' "$_mm" | sed -n "s/^$1[[:space:]]*:[[:space:]]*//p" | head -1; }
json_str() { printf '%s' "$1" | tr -d '"\\' | tr -d '\000-\037'; }

# One JSON object describing the modem, for ga-uplink.json. Published facts only:
# no IMEI, ICCID or number leaves the device through here.
modem_status() {
    _md=$(modem_device); _present=false; _bearer=false; _reg=false
    _dev=${_md%%:*}; _st=${_md#*:}; _iface=""; _op=""; _tech=""; _sig=null; _mst=""; _why=""
    _mm=$($MMCLI -m any -K 2>/dev/null) || _mm=""
    [ -n "$_mm" ] && _present=true
    [ -n "$_md" ] && _present=true
    _mst=$(mm_get 'modem\.generic\.state')
    _why=$(mm_get 'modem\.generic\.state-failed-reason')
    _op=$(mm_get 'modem\.3gpp\.operator-name')
    _tech=$(mm_get 'modem\.generic\.access-technologies\.value\[1\]')
    _q=$(mm_get 'modem\.generic\.signal-quality\.value')
    case "$_q" in ''|*[!0-9]*) _sig=null ;; *) _sig=$_q ;; esac
    [ "$_st" = connected ] && _bearer=true
    case "$_mst" in registered|connected|connecting|disconnecting) _reg=true ;; esac
    [ "$_bearer" = true ] && _reg=true
    [ -n "$_dev" ] && _iface=$($NMCLI -g GENERAL.IP-IFACE device show "$_dev" 2>/dev/null | head -1)
    printf '{"present":%s,"registered":%s,"bearer_up":%s,"iface":"%s","state":"%s","failed_reason":"%s","operator":"%s","tech":"%s","signal":%s}' \
        "$_present" "$_reg" "$_bearer" "$(json_str "$_iface")" "$(json_str "$_mst")" "$(json_str "$_why")" \
        "$(json_str "$_op")" "$(json_str "$_tech")" "$_sig"
}

# A modem that reports `failed / sim-missing` for longer than SIM_GRACE_S gets a
# modem power-cycle (AT+CFUN=1,1), at most every SIM_RESET_EVERY_S and at most
# SIM_RESET_MAX times per boot (the record lives under /run). Anything else
# (SIM present, modem gone, no reset port) clears the record. Every action and
# every give-up is logged at warning level (rule 44).
sim_missing_recover() {
    [ "$BUILTIN_MODEM" = 1 ] || return 0
    _rec="$STATE.simmissing"
    _mm=$($MMCLI -m any -K 2>/dev/null) || _mm=""
    if [ "$(mm_get 'modem\.generic\.state')" != failed ] \
        || [ "$(mm_get 'modem\.generic\.state-failed-reason')" != sim-missing ]; then
        rm -f "$_rec"; return 0
    fi
    _first=""; _last=""; _count=""   # set -u: a missing record must not abort the ladder
    [ -r "$_rec" ] && read -r _first _last _count < "$_rec"
    _gave_up=0; [ "$_last" = giveup ] && _gave_up=1
    case "$_first" in ''|*[!0-9]*) _first=$NOW; _last=0; _count=0 ;; esac
    case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
    case "$_count" in ''|*[!0-9]*) _count=0 ;; esac
    if [ $((NOW - _first)) -lt "$SIM_GRACE_S" ]; then
        printf '%s %s %s\n' "$_first" "$_last" "$_count" > "$_rec"; return 0
    fi
    if [ "$_count" -ge "$SIM_RESET_MAX" ]; then
        [ "$_gave_up" = 0 ] && log warning "modem still sim-missing after $_count reset(s) — giving up until the next boot (insert a SIM, check its seat)"
        printf '%s giveup %s\n' "$_first" "$_count" > "$_rec"; return 0
    fi
    if [ "$_last" -gt 0 ] && [ $((NOW - _last)) -lt "$SIM_RESET_EVERY_S" ]; then
        printf '%s %s %s\n' "$_first" "$_last" "$_count" > "$_rec"; return 0
    fi
    if [ -z "$MODEM_RESET_PORT" ] || [ ! -e "$MODEM_RESET_PORT" ]; then
        log warning "modem sim-missing for $((NOW - _first))s but no modem reset port (GA_MODEM_RESET_PORT='${MODEM_RESET_PORT}') — cannot re-read the SIM"
        printf '%s %s %s\n' "$_first" "$NOW" "$_count" > "$_rec"; return 0
    fi
    _count=$((_count + 1))
    if printf 'AT+CFUN=1,1\r' > "$MODEM_RESET_PORT" 2>/dev/null; then
        log warning "modem sim-missing for $((NOW - _first))s — power-cycling it (AT+CFUN=1,1 on $MODEM_RESET_PORT, reset $_count/$SIM_RESET_MAX) so it re-reads the SIM"
    else
        log warning "modem sim-missing: writing AT+CFUN=1,1 to $MODEM_RESET_PORT FAILED (reset $_count/$SIM_RESET_MAX)"
    fi
    printf '%s %s %s\n' "$_first" "$NOW" "$_count" > "$_rec"
}

# The APN is configuration, not code. File on the boot partition > board default
# > empty (= auto-config from the SIM). Only a sane APN string is accepted.
apply_apn() {
    [ "$BUILTIN_MODEM" = 1 ] || return 0
    $NMCLI -t -f NAME connection show 2>/dev/null | grep -qxF "$LTE_PROFILE" || return 0
    _want=$(sed -n '1{s/[[:space:]]//g;p;q}' "$LTE_APN_FILE" 2>/dev/null)
    if [ -n "$_want" ] && ! printf '%s' "$_want" | grep -Eq '^[A-Za-z0-9._-]{1,100}$'; then
        log warning "ignoring $LTE_APN_FILE: not a valid APN"; _want=""
    fi
    [ -n "$_want" ] || _want="$LTE_APN_DEFAULT"
    _have=$($NMCLI -g gsm.apn connection show "$LTE_PROFILE" 2>/dev/null | head -1)
    [ "$_want" = "$_have" ] && return 0
    if [ -n "$_want" ]; then
        $NMCLI connection modify "$LTE_PROFILE" gsm.apn "$_want" gsm.auto-config no >/dev/null 2>&1
    else
        $NMCLI connection modify "$LTE_PROFILE" gsm.apn "" gsm.auto-config yes >/dev/null 2>&1
    fi
    log notice "LTE APN set to '${_want:-auto}' (was '${_have:-auto}')"
    if $NMCLI -t -f NAME connection show --active 2>/dev/null | grep -qxF "$LTE_PROFILE"; then
        $NMCLI -w "$UP_TIMEOUT_S" connection up "$LTE_PROFILE" >/dev/null 2>&1
    fi
}

# One line per candidate profile: "OK<TAB>name" or "NO<TAB>name: reason".
# Non-uplink types (loopback, wireguard, bridge, tun) are not listed at all.
rung_report() {
    _active="$1"
    $NMCLI -t -f NAME,TYPE,AUTOCONNECT connection show 2>/dev/null | while IFS=: read -r _n _t _a; do
        [ "$_n" = "$_active" ] && continue
        case "$_t" in 802-3-ethernet|802-11-wireless|gsm|cdma) ;; *) continue ;; esac
        if [ -f "$PARK_DIR/$_n" ]; then
            printf 'NO\t%s: parked (cooldown until %s)\n' "$_n" "$(cat "$PARK_DIR/$_n" 2>/dev/null)"; continue
        fi
        if [ -f "$TRIED_DIR/$_n" ]; then
            _tu=$(cat "$TRIED_DIR/$_n" 2>/dev/null || echo 0)
            if [ "$NOW" -lt "$_tu" ] 2>/dev/null; then
                printf 'NO\t%s: tried, not full (retry after %s)\n' "$_n" "$_tu"; continue
            fi
            rm -f "$TRIED_DIR/$_n"
        fi
        if [ "$_a" != "yes" ]; then printf 'NO\t%s: autoconnect off\n' "$_n"; continue; fi
        case "$_t" in
            802-3-ethernet)
                if eth_has_carrier "$_n"; then printf 'OK\t%s\n' "$_n"; else printf 'NO\t%s: no carrier\n' "$_n"; fi ;;
            802-11-wireless)
                if wifi_in_range "$_n"; then printf 'OK\t%s\n' "$_n"; else printf 'NO\t%s: SSID not in range\n' "$_n"; fi ;;
            gsm|cdma)
                if [ "$BUILTIN_MODEM" != 1 ] || modem_usable; then printf 'OK\t%s\n' "$_n"
                else printf 'NO\t%s: no usable modem (absent, no SIM or not enabled)\n' "$_n"; fi ;;
        esac
    done
}

# Rungs that could take over: another profile, allowed to autoconnect, not
# parked, not recently tried, of an uplink type, and with its medium present.
spare_rungs() { rung_report "$1" | sed -n 's/^OK\t//p'; }

iso_now() { date -u -d "@$NOW" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ; }

# The cache is not the world: ask the radio, give it a bounded moment.
rescan_wait() {
    $NMCLI device wifi rescan >/dev/null 2>&1
    sleep "$RESCAN_WAIT_S"
    LAST_RESCAN=$(iso_now)
    echo "$LAST_RESCAN" > "$RESCAN_REC" 2>/dev/null
}

# Sets SPARE (first usable rung, "" if none). Rescans once before giving up and
# says, at warning level, why every other known rung was rejected (rule 44).
pick_spare() {
    _rep=$(rung_report "$1")
    if ! printf '%s\n' "$_rep" | grep -q '^OK'; then
        log warning "no spare uplink in the scan cache — forcing a Wi-Fi rescan (${RESCAN_WAIT_S}s) before judging '${1:-none}' the last rung"
        rescan_wait
        _rep=$(rung_report "$1")
    fi
    SPARE=$(printf '%s\n' "$_rep" | sed -n 's/^OK\t//p' | head -1)
    printf '%s\n' "$_rep" | sed -n 's/^NO\t//p' | while IFS= read -r _l; do
        log warning "uplink candidate rejected: $_l"
    done
    [ -z "$SPARE" ] || log notice "uplink candidate '$SPARE' is a usable spare"
    return 0
}

park() {
    _c="$1"; _why="$2"; _cd="${3:-$COOLDOWN_S}"
    mkdir -p "$PARK_DIR"
    echo $((NOW + _cd)) > "$PARK_DIR/$_c"
    $NMCLI connection modify "$_c" connection.autoconnect no >/dev/null 2>&1
    $NMCLI connection down "$_c" >/dev/null 2>&1
    log warning "parked '$_c' for ${_cd}s — $_why. Falling to the next uplink."
}

unpark() {
    _c="$1"
    rm -f "$PARK_DIR/$_c"
    $NMCLI connection modify "$_c" connection.autoconnect yes >/dev/null 2>&1
    log notice "unparked '$_c' — its cooldown expired, it may compete again"
}

# A reboot is a fresh start: let every rung try before we judge any of them.
# Parking persists in the keyfile (autoconnect=no), so without this a device
# could come up with a rung disabled by a decision taken before the reboot.
unpark_all_on_boot() {
    [ -f "$BOOT_MARK" ] && return 0
    rm -rf "$TRIED_DIR" "$SWITCH_REC"
    [ -d "$PARK_DIR" ] && for _f in "$PARK_DIR"/*; do
        [ -e "$_f" ] || continue
        unpark "$(basename "$_f")"
    done
    mkdir -p "$(dirname "$BOOT_MARK")" 2>/dev/null
    : > "$BOOT_MARK"
}

release_expired() {
    [ -d "$PARK_DIR" ] || return 0
    for _f in "$PARK_DIR"/*; do
        [ -e "$_f" ] || continue
        _until=$(cat "$_f" 2>/dev/null || echo 0)
        if [ "$NOW" -ge "$_until" ] 2>/dev/null; then
            _r=$(basename "$_f")
            unpark "$_r"
            # Built-in modem board, standing on the modem: go BACK through the same
            # verified switch every candidate gets, instead of leaving it to NM
            # (a dead Ethernet would take the default route and hold it).
            if [ "$BUILTIN_MODEM" = 1 ] && [ -n "${_ACTIVE_NOW:-}" ] && ! is_modem_profile "$_r" \
               && is_modem_profile "$_ACTIVE_NOW" && [ ! -f "$SWITCH_REC" ]; then
                log notice "modem fallback in use - trying '$_r' again, the modem is restored if it is not full"
                switch_to "$_ACTIVE_NOW" "$_r"
            fi
        fi
    done
}

write_status() {
    _mj=""; [ -z "$MODEM_JSON" ] || _mj=",\"modem\":$MODEM_JSON"
    printf '{"rung":"%s","verdict":"%s","strikes":%s,"parked":"%s","spare":"%s","last_rung":%s,"searching":%s,"last_rescan":"%s","updated_at":"%s"%s}\n' \
        "$1" "$2" "$3" "$(ls "$PARK_DIR" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')" \
        "$SPARE" "$LAST_RUNG" "$SEARCHING" "$LAST_RESCAN" "$(iso_now)" "$_mj" \
        | "$PUBLISH" "$STATUS" 0644 || log warning "could not publish $STATUS"
}

# Take a candidate up explicitly (bounded), and remember to verify it next tick.
switch_to() {
    _prev="$1"; _cand="$2"
    $NMCLI -w "$UP_TIMEOUT_S" connection up "$_cand" >/dev/null 2>&1 \
        || log warning "'connection up $_cand' did not complete within ${UP_TIMEOUT_S}s — NM may still bring it up"
    echo "$_prev|$_cand|$NOW" > "$SWITCH_REC"
    log warning "switched '${_prev:-none}' -> '$_cand' — verifying on the next tick, falling back if it is not full either"
}

# Previous tick moved us to a candidate. Full -> done. Not full after the settle
# time -> restore the previous rung and bar the candidate for a while.
# Returns 0 only when it fell back.
check_switch() {
    [ -f "$SWITCH_REC" ] || return 1
    IFS='|' read -r _p _cand _at < "$SWITCH_REC"
    if [ "$1" = "full" ]; then
        log notice "candidate '$_cand' verified full — staying on it"
        rm -f "$SWITCH_REC"; return 1
    fi
    [ $((NOW - _at)) -ge "$SETTLE_S" ] || return 1
    mkdir -p "$TRIED_DIR"; echo $((NOW + TRIED_COOLDOWN_S)) > "$TRIED_DIR/$_cand"
    rm -f "$SWITCH_REC"
    if [ -n "$_p" ]; then
        [ -f "$PARK_DIR/$_p" ] && unpark "$_p"
        # The returning rung is still up and, ranked above the modem, would keep the
        # default route: park it again (short back-off) so the modem really carries.
        is_modem_profile "$_p" && ! is_modem_profile "$_cand" \
            && park "$_cand" "returning from the modem failed ('$1')" "$MODEM_BACK_S"
        $NMCLI -w "$UP_TIMEOUT_S" connection up "$_p" >/dev/null 2>&1
        log warning "candidate '$_cand' is not full either ('$1') — fell back to previous '$_p'; '$_cand' barred for ${TRIED_COOLDOWN_S}s"
    else
        log warning "candidate '$_cand' is not full ('$1') — barred for ${TRIED_COOLDOWN_S}s, still searching"
    fi
    return 0
}

main() {
    unpark_all_on_boot
    _ACTIVE_NOW=$(active_connection)
    # A switch recorded by an EARLIER tick is verified on this one (built-in modem
    # boards; see the full branch below). Taken before release_expired, which may
    # record a new switch of its own this tick.
    _had_switch=0
    [ "$BUILTIN_MODEM" = 1 ] && [ -f "$SWITCH_REC" ] && _had_switch=1
    release_expired
    if [ "$BUILTIN_MODEM" = 1 ]; then
        apply_apn
        sim_missing_recover
        MODEM_JSON=$(modem_status)
    fi

    _active=$(active_connection)
    _strikes=$(cat "$STATE" 2>/dev/null || echo 0)
    case "$_strikes" in ''|*[!0-9]*) _strikes=0 ;; esac

    _verdict=$(cached_verdict)
    # NM's cached verdict can still describe the rung we just left, so the tick
    # that verifies a switch asks for a fresh one (one probe per switch).
    if [ "$_verdict" != "full" ] || [ "$_had_switch" = 1 ]; then
        # Suspicion — and only here — costs one request.
        _verdict=$(forced_verdict)
    fi

    if [ "$_verdict" = "full" ]; then
        # check_switch() only runs on a failing tick, so a switch that worked would
        # leave its record behind and a later blip would be "verified" against it
        # and undone. Cleared here on the built-in-modem boards only; the iHost
        # keeps its behaviour unchanged (known gap, tracked in Odoo #2176).
        if [ "$_had_switch" = 1 ]; then
            log notice "candidate verified full — staying on '$_active'"
            rm -f "$SWITCH_REC"
        fi
        [ "$_strikes" -gt 0 ] && log notice "uplink '$_active' is healthy again after $_strikes strike(s)"
        echo 0 > "$STATE"
        write_status "${_active:-none}" "$_verdict" 0
        return 0
    fi

    _strikes=$((_strikes + 1))
    echo "$_strikes" > "$STATE"
    log warning "uplink '${_active:-none}' reports '$_verdict' (strike $_strikes/$FAIL_THRESHOLD)"
    write_status "${_active:-none}" "$_verdict" "$_strikes"

    if check_switch "$_verdict"; then
        # fell back: stay one strike short of the threshold so the search
        # resumes on the very next tick
        echo $((FAIL_THRESHOLD - 1)) > "$STATE"
        write_status "${_active:-none}" "$_verdict" $((FAIL_THRESHOLD - 1))
        return 0
    fi

    [ "$_strikes" -ge "$FAIL_THRESHOLD" ] || return 0
    pick_spare "$_active"
    if [ -z "$SPARE" ]; then
        LAST_RUNG=true; SEARCHING=true
        if [ -z "$_active" ]; then
            log warning "NO default route and no usable candidate (after a rescan) — device is OFFLINE, searching again next tick"
        else
            log warning "'$_active' is the LAST uplink ('$_verdict') — keeping it, but OFFLINE searching continues every tick. Parking it would take the device off the network entirely."
        fi
        write_status "${_active:-none}" "$_verdict" "$_strikes"
        return 0
    fi
    if [ -z "$_active" ]; then
        switch_to "" "$SPARE"
        echo 0 > "$STATE"
        write_status "switching" "$_verdict" 0
        return 0
    fi
    if is_modem_profile "$SPARE"; then
        park "$_active" "no internet after $_strikes checks ($_verdict); modem fallback" "$MODEM_BACK_S"
    else
        park "$_active" "no internet after $_strikes checks ($_verdict)"
    fi
    switch_to "$_active" "$SPARE"
    echo 0 > "$STATE"
    write_status "switching" "$_verdict" 0
}

main "$@"
