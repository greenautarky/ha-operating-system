#!/bin/sh
# ga-addon-prime — post-OTA one-shot to update baked addons to the
# versions pinned in the new OS image's addon-images.json.
#
# Why: Supervisor preserves the running addon container across an OS
# slot-swap (= /mnt/data/supervisor persists), so even though the OS
# image bakes a newer addon image tag, the previous version keeps
# running until an explicit `ha addons update` fires.
#
# Reads `/etc/ga-addon-prime.conf` (one slug per line, '#' comments OK),
# runs `docker exec hassio_cli ha store reload` once, then `ha addons
# update <slug>` per entry. On success, writes the marker file
# `/mnt/data/.ga-addon-primed` so the gating service does not re-run.
#
# The `ha` CLI lives in the hassio_cli sibling container, NOT on the
# host. We could use `docker exec hassio_cli ha …` from the host
# (= what this script does) or call Supervisor's REST API directly.
# Docker exec is simpler and matches yesterday's bench-verified pattern.

set -eu

PRIME_CONF="/etc/ga-addon-prime.conf"
MARKER="/mnt/data/.ga-addon-primed"

log() { echo "[ga-addon-prime] $*"; }

if [ ! -f "$PRIME_CONF" ]; then
    log "no prime conf at $PRIME_CONF — nothing to do"
    # Still write the marker so the service doesn't keep firing.
    touch "$MARKER"
    exit 0
fi

# Wait for hassio_cli container to be up (= comes online a few seconds
# after hassos-supervisor starts).
for i in $(seq 1 60); do
    if docker exec hassio_cli /bin/true >/dev/null 2>&1; then
        break
    fi
    log "waiting for hassio_cli (${i}/60)…"
    sleep 5
done
if ! docker exec hassio_cli /bin/true >/dev/null 2>&1; then
    log "ERROR: hassio_cli not reachable after 5 min — bailing (no marker written)"
    exit 1
fi

# Wait for Supervisor to be READY (not still in `setup` / `initialize`).
# Discovered 2026-06-18 on K0 BOSv1.2.21-rc1: hassio_cli container is up
# within ~30s of boot, but Supervisor is still finishing its setup phase
# for another 60-90s. Any `ha addons update` call before then returns:
#   Error: System is not ready with state: setup
# and the prime fails, marker not written, retry-loop next boot — but
# next boot has the same race, so the prime never succeeds.
#
# Probe: try `ha store reload` until it returns rc=0. This call returns
# the same "System is not ready" error pre-setup-complete that addons
# update does, but it's idempotent + cheap + the operation we're about
# to do anyway. Once it succeeds, Supervisor is ready for the per-slug
# updates. Poll up to 10 min total (= plenty of slack for cold-boot
# supervisor-update racing scenarios).
log "waiting for Supervisor to be ready (= store reload succeeds)"
SUP_READY=0
for i in $(seq 1 120); do
    # set +e / -e bracket: `OUT=$(failing-cmd)` triggers set -e in dash
    # (the HAOS /bin/sh), aborting the script before $? can be checked.
    # POSIX-portable workaround.
    set +e
    PROBE_OUT=$(docker exec hassio_cli ha store reload 2>&1)
    PROBE_RC=$?
    set -e
    if [ "$PROBE_RC" -eq 0 ]; then
        SUP_READY=1
        log "  → Supervisor ready after $((i * 5))s (store reload OK)"
        break
    fi
    # Surface the actual error so first-boot debugging is easy.
    ERR_SHORT=$(echo "$PROBE_OUT" | head -1 | cut -c1-80)
    log "  Supervisor not ready (rc=$PROBE_RC, $ERR_SHORT) — waiting (${i}/120)…"
    sleep 5
done
if [ "$SUP_READY" -ne 1 ]; then
    log "ERROR: Supervisor did not become ready within 10 min — bailing (no marker written)"
    exit 1
fi
# Store-reload already succeeded as the probe — no need to re-call.
log "addon store cache refreshed (= /store/reload OK during readiness probe)"

# Registry-credential preflight (2026-07-29).
#
# The ga_manager packages on GHCR are PRIVATE since 2026-07-29. A prime is a
# real registry pull, so it needs Supervisor to hold ghcr.io credentials —
# written by ga_manager's `ghcr-creds-write` + `docker-registry-ensure`
# workers, which the fleet-manager drives after the device enrolls.
#
# A fresh flash does NOT need this: the addon images are baked into the data
# partition at build time (hassio.mk -> fetch-addon-images.sh -> skopeo copy
# -> dind-import-containers.sh), so the pinned version is already in the local
# docker store and the prime is a no-op. The pull only happens when the store
# has moved AHEAD of the bake pin — i.e. exactly in the window between the two
# lockstep PRs.
#
# This is diagnostic, not a gate: we still attempt the prime (public addons
# work without credentials), but a first-boot log that says "no registry
# credentials" beats one that says "update failed".
set +e
REG_OUT=$(docker exec hassio_cli ha docker registries --raw-json 2>/dev/null)
set -e
if echo "$REG_OUT" | grep -q 'ghcr\.io'; then
    log "registry credentials: ghcr.io present (private addon images pullable)"
else
    log "registry credentials: NO ghcr.io entry — private addon images are NOT pullable."
    log "  If a prime below fails with an auth error, that is the cause."
    log "  Fix: fleet-manager -> ga_manager job 'ghcr-creds-write' then 'docker-registry-ensure'."
fi

# Iterate prime conf
FAIL=0
SKIPPED=0
while IFS= read -r SLUG; do
    # strip comments + whitespace
    SLUG="${SLUG%%#*}"
    SLUG="$(echo "$SLUG" | tr -d '[:space:]')"
    [ -z "$SLUG" ] && continue

    log "priming addon: $SLUG"
    # set +e / -e bracket: see Supervisor-readiness probe above for rationale.
    set +e
    UPDATE_OUT=$(docker exec hassio_cli ha addons update "$SLUG" 2>&1)
    UPDATE_RC=$?
    set -e
    if [ "$UPDATE_RC" -eq 0 ]; then
        log "  → $SLUG: primed OK"
        PRIMED_OK=1
    elif echo "$UPDATE_OUT" | grep -qiE 'no update available|already at version'; then
        # Discovered 2026-06-18 on K0: `ha addons update` returns rc!=0
        # with "No update available" when the addon is already at the
        # bake-pinned version. That's the EXPECTED state on a
        # reflashed-from-current-image device, not a failure — the
        # prime semantics are "ensure addon is at pinned version", not
        # "force an upgrade". Treat as success + log so the operator
        # has the trail.
        log "  → $SLUG: already at pinned version (no-op)"
        PRIMED_OK=1
    elif echo "$UPDATE_OUT" | grep -qiE 'does not exist|not installed'; then
        # FRESH SD FLASH. Measured on K31, 2026-07-30: this service primes at
        # T+0:10 and ga-bootstrap installs the add-on at T+0:33 — 22 seconds
        # LATER. So on every freshly flashed device the add-on genuinely does
        # not exist yet, `ha addons update` says so, and the old code counted
        # that as a prime failure: exit 1, a permanently red systemd unit on a
        # device where nothing is wrong. IDLE-08 flagged it, correctly.
        #
        # There is nothing to prime here and there never will be on this boot:
        # ga-bootstrap installs the BAKE-PINNED version, which is by definition
        # what priming would have produced. Priming means "ensure the add-on is
        # at the pinned version", and an absent add-on is not at the wrong
        # version — it is not yet the subject of the question.
        #
        # Deliberately NOT a failure and deliberately NOT a success either:
        # SKIPPED is counted separately so the marker stays unwritten and the
        # service still runs next boot. That keeps the post-OTA case — the one
        # this service exists for — fully intact, while a fresh flash stops
        # reporting a failure it does not have.
        log "  → $SLUG: not installed yet (ga-bootstrap installs it later this boot) — nothing to prime, skipping"
        SKIPPED=$((SKIPPED + 1))
        PRIMED_OK=0
    elif echo "$UPDATE_OUT" | grep -qiE 'unauthorized|authentication required|denied|pull access'; then
        # Private image + no registry credentials. Distinct from a generic
        # failure because the fix is an ops action (push creds), not a retry —
        # and the marker stays unwritten, so the prime self-heals on the next
        # boot once the credentials land.
        log "  → $SLUG: FAILED (registry auth) — private image, Supervisor has no credentials"
        log "     run ga_manager jobs 'ghcr-creds-write' + 'docker-registry-ensure' on this device"
        FAIL=$((FAIL + 1))
        PRIMED_OK=0
    else
        log "  → $SLUG: FAILED — $(echo "$UPDATE_OUT" | head -1 | cut -c1-120)"
        FAIL=$((FAIL + 1))
        PRIMED_OK=0
    fi

    # 1.2.22+: defensive `ha addons start` after every successful update.
    # The Supervisor 2025.11.4.6 no-autostart-after-update bug
    # (= bug_supervisor_no_autostart_after_addon_update_2026_06_19) lands
    # the addon in state=stopped despite boot:auto. Chaining a start here
    # papers over the bug at the OS priming layer (the runtime ga_manager
    # addon-update worker carries the equivalent fix as of 0.48.0).
    # No-op when the addon is already running. `|| true` because some
    # addons may be intentionally stopped (= protected user override) +
    # we don't want a benign start failure to fail the prime gate.
    if [ "$PRIMED_OK" -eq 1 ]; then
        set +e
        docker exec hassio_cli ha addons start "$SLUG" >/dev/null 2>&1
        START_RC=$?
        set -e
        if [ "$START_RC" -eq 0 ]; then
            log "  → $SLUG: defensive start OK"
        else
            # rc!=0 is normal for "already running" — only log at debug level.
            log "  → $SLUG: defensive start rc=$START_RC (= addon may already be running)"
        fi
    fi
done < "$PRIME_CONF"

if [ "$FAIL" -gt 0 ]; then
    log "ERROR: $FAIL addon(s) failed to prime — marker NOT written, service will retry next boot"
    exit 1
fi

if [ "$SKIPPED" -gt 0 ]; then
    # Not an error: the add-on is not installed yet (fresh flash). No marker, so
    # the service re-runs next boot; exit 0, so systemd does not show a failed
    # unit for a device in a perfectly normal state. The distinction matters —
    # a red unit that is always red on a fresh device teaches operators to
    # ignore red units.
    log "$SKIPPED addon(s) not installed yet — nothing primed, marker NOT written, will run again next boot"
    exit 0
fi

log "all addons primed — writing marker $MARKER"
touch "$MARKER"
log "done"
