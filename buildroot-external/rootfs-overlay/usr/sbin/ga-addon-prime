#!/bin/sh
# ga-addon-prime — post-OTA one-shot to update baked addons to the
# versions pinned in the new OS image's addon-images.json.
#
# Why: Supervisor preserves the running addon container across an OS
# slot-swap (= /mnt/data/supervisor persists), so even though the OS
# image bakes a newer addon image tag, the previous version keeps
# running until an explicit `ha addons|apps update` (CLI generation: see below) fires.
#
# Reads `/etc/ga-addon-prime.conf` (one slug per line, '#' comments OK),
# waits for `ha info` state running, runs `ha store reload` ONCE, then `ha addons
# update <slug>` per entry. On success, writes the marker file
# `/mnt/data/.ga-addon-primed` so the gating service does not re-run.
#
# The `ha` CLI lives in the hassio_cli sibling container, NOT on the
# host. We could use `docker exec hassio_cli ha …` from the host
# (= what this script does) or call Supervisor's REST API directly.
# Docker exec is simpler and matches yesterday's bench-verified pattern.

set -eu

# GA_PRIME_CONF / GA_PRIME_MARKER: test hooks (tests/ga_tests/addon_prime), never set on a device.
PRIME_CONF="${GA_PRIME_CONF:-/etc/ga-addon-prime.conf}"
MARKER="${GA_PRIME_MARKER:-/mnt/data/.ga-addon-primed}"

log() { echo "[ga-addon-prime] $*"; }

# --- ONE global deadline (Odoo #1610, review round 2) --------------------------
# The stages below can each wait for minutes (hassio_cli 300 s, readiness probe
# 600 s, then up to RETRY_BUDGET_S per slug), so their sum exceeds the unit's
# TimeoutStartSec (10 min): systemd killed the script silently, before it could
# print its loud give-up line, and no outcome was visible. Now the WHOLE script
# gets TOTAL_BUDGET_S, kept below TimeoutStartSec with margin (the unit and this
# default are checked against each other by tests/ga_tests/addon_prime APRIME-41):
#   - every wait loop below stops at the deadline and takes its own FAILED path;
#   - a hung `docker exec` cannot outlive it: the script re-runs itself under
#     `timeout`, and when that fires it says so loudly and exits 1 (no marker).
# GA_PRIME_TOTAL_BUDGET_S, GA_PRIME_SH: test hooks, never set on a device.
TOTAL_BUDGET_S="${GA_PRIME_TOTAL_BUDGET_S:-540}"
if [ -z "${GA_PRIME_INNER:-}" ] && command -v timeout >/dev/null 2>&1; then
    set +e
    # shellcheck disable=SC2086  # GA_PRIME_SH may be two words ("busybox sh") in tests
    GA_PRIME_INNER=1 timeout -s TERM "$TOTAL_BUDGET_S" ${GA_PRIME_SH:-/bin/sh} "$0" "$@"
    _rc=$?
    set -e
    if [ "$_rc" -eq 124 ] || [ "$_rc" -eq 143 ]; then
        log "ERROR: FAILED — global deadline of ${TOTAL_BUDGET_S}s reached (a docker call hung or the waits ran out); no marker written, the prime retries on the next boot"
        exit 1
    fi
    exit "$_rc"
fi
DEADLINE=$(( $(date +%s) + TOTAL_BUDGET_S ))
past_deadline() { [ "$(date +%s)" -ge "$DEADLINE" ]; }

# Per-slug update retry (Odoo #1610, finding C). The
# readiness probe below can pass while Supervisor is still starting Core, but the
# update itself is then refused: "Supervisor is not ready to perform this
# operation, please try again later" (measured on a fresh BOSv1.6.0-rc6 flash:
# probe passed at :18, Core start issued at :13, update refused at :20).
# That one error text means "try again", so the update is retried with
# exponential backoff (5, 10, 20, then 30 s steps) until RETRY_BUDGET_S of
# waiting has passed. 600 s is the same budget this script already gives the
# readiness probe below (120 x 5 s); the real Supervisor start-up time is not
# measured, the budget is a bound, not a claim. Every OTHER error is not
# retried and keeps its own classification below; an exhausted budget falls
# through to the generic FAILED branch, loudly.
# GA_PRIME_RETRY_BUDGET_S: test hook, never set on a device.
RETRY_BUDGET_S="${GA_PRIME_RETRY_BUDGET_S:-600}"

# --- ha CLI generations -------------------------------------------------------
# Supervisor 2025.11.x (iHost today): the CLI knows only `ha addons ...`.
# Supervisor 2026.10+ (DSGW-210, later iHost): `ha apps ...`; `ha addons ...`
# still works as an alias but prints "The use of 'addons' is deprecated, please
# use 'apps' instead!" on STDERR. The old code merged stderr into the text it
# classified and logged only its first line, so on 2026.10 every failure was
# logged as that notice and the real error was hidden.
#
# Two rules, both needed:
#   1. detect which word this CLI has (capability, not a version compare);
#   2. keep stdout and stderr apart, drop the deprecation notice from what is
#      classified, and log the real error (the last meaningful line).
# On a 2026.10 CLI `ha apps --help` returns rc 0 and lists the subcommands
# incl. "update"; `ha bogus --help` returns rc 1 "unknown command".
APPS_CMD=addons
detect_apps_cmd() {
    set +e
    HELP_OUT=$(docker exec hassio_cli ha apps --help 2>&1)
    HELP_RC=$?
    set -e
    # rc 0 AND an `update` subcommand line: an old CLI that answered an unknown
    # word with its root help (rc 0) must not be taken for an apps CLI.
    if [ "$HELP_RC" -eq 0 ] && echo "$HELP_OUT" | grep -qE '^[[:space:]]+update[[:space:]]'; then
        APPS_CMD=apps
    fi
    log "ha CLI generation: using 'ha $APPS_CMD' (apps --help rc=$HELP_RC)"
}

# run_ha <ha args...> — runs `ha` in hassio_cli. Sets RUN_RC, RUN_OUT (stdout)
# and RUN_ERR (stderr without the deprecation notice). Never trips set -e.
RUN_ERRF="${TMPDIR:-/tmp}/ga-addon-prime.$$.err"
trap 'rm -f "$RUN_ERRF"' EXIT
run_ha() {
    set +e
    RUN_OUT=$(docker exec hassio_cli ha "$@" 2>"$RUN_ERRF")
    RUN_RC=$?
    set -e
    RUN_ERR=$(grep -viE "is deprecated, please use" "$RUN_ERRF" 2>/dev/null || true)
    return 0
}

# log_full <text> — the whole captured output (first 20 non-empty lines, 200
# chars each) under a failure, so the journal keeps the full trail and not only
# the summary line.
log_full() {
    printf '%s\n' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | head -n 20 | \
    while IFS= read -r _l; do log "     | $(printf '%s' "$_l" | cut -c1-200)"; done
}

# update_with_retry <slug> — `run_ha <apps-cmd> update <slug>`, repeated while
# (and only while) the refusal is Supervisor's "not ready to perform".
update_with_retry() {
    _waited=0
    _delay=5
    while :; do
        run_ha "$APPS_CMD" update "$1"
        [ "$RUN_RC" -ne 0 ] || return 0
        printf '%s\n%s\n' "$RUN_OUT" "$RUN_ERR" | grep -qi 'not ready to perform' || return 0
        if [ "$_waited" -ge "$RETRY_BUDGET_S" ]; then
            log "  → $1: Supervisor still 'not ready to perform' after ${_waited}s of retries — giving up"
            return 0
        fi
        if [ $(( $(date +%s) + _delay )) -ge "$DEADLINE" ]; then
            log "  → $1: Supervisor still 'not ready to perform' and the global ${TOTAL_BUDGET_S}s deadline is next — giving up"
            return 0
        fi
        log "  → $1: Supervisor not ready to perform the update — retry in ${_delay}s (waited ${_waited}/${RETRY_BUDGET_S}s)"
        sleep "$_delay"
        _waited=$((_waited + _delay))
        _delay=$((_delay * 2))
        [ "$_delay" -le 30 ] || _delay=30
    done
}

# last_line <text> — last non-empty line, whitespace trimmed, max 160 chars.
last_line() {
    printf '%s\n' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | tail -n 1 | cut -c1-160
}

if [ ! -f "$PRIME_CONF" ]; then
    log "no prime conf at $PRIME_CONF — nothing to do"
    # Still write the marker so the service doesn't keep firing.
    touch "$MARKER"
    exit 0
fi

# Wait for hassio_cli container to be up (= comes online a few seconds
# after haos-supervisor starts).
for i in $(seq 1 60); do
    if docker exec hassio_cli /bin/true >/dev/null 2>&1; then
        break
    fi
    past_deadline && break
    log "waiting for hassio_cli (${i}/60)…"
    sleep 5
done
if ! docker exec hassio_cli /bin/true >/dev/null 2>&1; then
    log "ERROR: FAILED — hassio_cli not reachable (5 min wait or the ${TOTAL_BUDGET_S}s global deadline) — bailing (no marker written)"
    exit 1
fi

# Wait for Supervisor to be READY (not still in `setup` / `initialize`).
# Discovered 2026-06-18 on K0 BOSv1.2.21-rc1: hassio_cli container is up
# within ~30s of boot, but Supervisor is still finishing its setup phase
# for another 60-90s. Any `ha addons update` call before then returns:
#   Error: System is not ready with state: setup
# and the prime fails, marker not written, retry-loop next boot — but
# next boot has the same race, so the prime never succeeds.
#
# Probe (Odoo #1752): `ha info --raw-json` -> .data.state == "running". This is a
# plain read of Supervisor's own state (measured on a BOSv1.6 device: the state
# lives in `ha info`; `ha supervisor info` has no state field). The probe used to
# be `ha store reload`, which on Supervisor 2026.10 runs ls-remote + fetch on 5
# GitHub repositories anonymously per call: every 5 s on a fresh flash that
# caused HTTP 429 and "store.git: already a task in progress" (BOSv1.6.0-rc9 K31
# gate, 2026-11-10). The probe now never touches the store. Bounded by 120 tries
# and the global deadline; every try is logged (rc + state). jq program is
# regex-free (the image jq has no oniguruma; gate tests/gates/jq_regex).
log "waiting for Supervisor to be ready (= ha info state running)"
SUP_READY=0
for i in $(seq 1 120); do
    # set +e / -e bracket: `OUT=$(failing-cmd)` triggers set -e in dash
    # (the HAOS /bin/sh), aborting the script before $? can be checked.
    set +e
    PROBE_OUT=$(docker exec hassio_cli ha info --raw-json 2>&1)
    PROBE_RC=$?
    set -e
    PROBE_STATE=""
    if [ "$PROBE_RC" -eq 0 ]; then
        PROBE_STATE=$(printf '%s' "$PROBE_OUT" | jq -r '.data.state // empty' 2>/dev/null || true)
    fi
    if [ "$PROBE_STATE" = "running" ]; then
        SUP_READY=1
        log "  -> Supervisor ready after $((i * 5))s (state=running)"
        break
    fi
    ERR_SHORT=$(echo "$PROBE_OUT" | head -1 | cut -c1-80)
    log "  Supervisor not ready (rc=$PROBE_RC, state=${PROBE_STATE:-unknown}, $ERR_SHORT) — waiting (${i}/120)…"
    past_deadline && break
    sleep 5
done
if [ "$SUP_READY" -ne 1 ]; then
    log "ERROR: FAILED — Supervisor did not become ready (10 min probe or the ${TOTAL_BUDGET_S}s global deadline) — bailing (no marker written)"
    exit 1
fi
detect_apps_cmd

# Exactly ONE store reload, after readiness. Why it is needed: after an OTA the
# persisted store metadata can be older than the version this image pins, and
# `update` compares against the store. Not retried: a failure (e.g. a 429) is
# logged loudly and the updates proceed on the cached metadata (Supervisor
# refreshes it on its own every 3 h); retrying is what caused the storm.
STORE_STALE=0
run_ha store reload
if [ "$RUN_RC" -eq 0 ]; then
    log "addon store cache refreshed (single /store/reload after readiness)"
else
    STORE_STALE=1
    STORE_ERR=$(last_line "$RUN_OUT $RUN_ERR")
    log "WARNING: single store reload failed (rc=$RUN_RC: $STORE_ERR) — store metadata may be stale; updates are still attempted but 'no update available' is NOT trusted, no marker will be written, NOT retried in this run"
fi

# Registry-credential preflight (2026-07-29).
#
# The ga_manager packages on GHCR are PRIVATE since 2026-07-29. A prime is a
# real registry pull, so it needs Supervisor to hold ghcr.io credentials —
# written by ga_manager's `ghcr-creds-write` + `docker-registry-ensure`
# workers, which the fleet-manager drives after the device enrolls.
#
# A fresh flash does NOT need this: the addon images are baked into the data
# partition at build time (hassio.mk -> fetch-addon-images.sh -> skopeo copy
# -> dind-import-containers.sh), so the pinned version is already in the local
# docker store and the prime is a no-op. The pull only happens when the store
# has moved AHEAD of the bake pin — i.e. exactly in the window between the two
# lockstep PRs.
#
# This is diagnostic, not a gate: we still attempt the prime (public addons
# work without credentials), but a first-boot log that says "no registry
# credentials" beats one that says "update failed".
set +e
REG_OUT=$(docker exec hassio_cli ha docker registries --raw-json 2>/dev/null)
set -e
if echo "$REG_OUT" | grep -q 'ghcr\.io'; then
    log "registry credentials: ghcr.io present (private addon images pullable)"
else
    log "registry credentials: NO ghcr.io entry — private addon images are NOT pullable."
    log "  If a prime below fails with an auth error, that is the cause."
    log "  Fix: fleet-manager -> ga_manager job 'ghcr-creds-write' then 'docker-registry-ensure'."
fi

# Iterate prime conf
FAIL=0
SKIPPED=0
while IFS= read -r SLUG; do
    # strip comments + whitespace
    SLUG="${SLUG%%#*}"
    SLUG="$(echo "$SLUG" | tr -d '[:space:]')"
    [ -z "$SLUG" ] && continue

    log "priming addon: $SLUG"
    update_with_retry "$SLUG"
    UPDATE_RC=$RUN_RC
    # Classify on the real output only: stdout + stderr minus the deprecation
    # notice (a 2026.10 CLI writes its errors to stderr, behind the notice
    # when called as `addons`).
    UPDATE_OUT="$RUN_OUT
$RUN_ERR"
    if [ "$UPDATE_RC" -eq 0 ]; then
        log "  → $SLUG: primed OK"
        PRIMED_OK=1
    elif [ "$STORE_STALE" -eq 1 ] && echo "$UPDATE_OUT" | grep -qiE 'no update available|already at version'; then
        # Stale store metadata can hide a needed update: not a success in this run.
        log "  → $SLUG: 'no update available' NOT trusted (store reload failed this run) — prime incomplete"
        PRIMED_OK=0
    elif echo "$UPDATE_OUT" | grep -qiE 'no update available|already at version'; then
        # Discovered 2026-06-18 on K0: `ha addons update` returns rc!=0
        # with "No update available" when the addon is already at the
        # bake-pinned version. That's the EXPECTED state on a
        # reflashed-from-current-image device, not a failure — the
        # prime semantics are "ensure addon is at pinned version", not
        # "force an upgrade". Treat as success + log so the operator
        # has the trail.
        log "  → $SLUG: already at pinned version (no-op)"
        PRIMED_OK=1
    # Registry auth is classified BEFORE "does not exist": docker's own denial
    # reads "pull access denied for X, repository does not exist or may require
    # authorization" and would otherwise be taken for "add-on not installed yet".
    elif echo "$UPDATE_OUT" | grep -qiE 'unauthorized|authentication required|denied|pull access'; then
        # Private image + no registry credentials. Distinct from a generic
        # failure because the fix is an ops action (push creds), not a retry —
        # and the marker stays unwritten, so the prime self-heals on the next
        # boot once the credentials land.
        log "  → $SLUG: FAILED (registry auth: $(last_line "$UPDATE_OUT")) — private image, Supervisor has no credentials"
        log "     run ga_manager jobs 'ghcr-creds-write' + 'docker-registry-ensure' on this device"
        log_full "$UPDATE_OUT"
        FAIL=$((FAIL + 1))
        PRIMED_OK=0
    elif echo "$UPDATE_OUT" | grep -qiE 'does not exist|not installed'; then
        # FRESH SD FLASH. Measured on K31, 2026-07-30: this service primes at
        # T+0:10 and ga-bootstrap installs the add-on at T+0:33 — 22 seconds
        # LATER. So on every freshly flashed device the add-on genuinely does
        # not exist yet, `ha addons update` says so, and the old code counted
        # that as a prime failure: exit 1, a permanently red systemd unit on a
        # device where nothing is wrong. IDLE-08 flagged it, correctly.
        #
        # There is nothing to prime here and there never will be on this boot:
        # ga-bootstrap installs the BAKE-PINNED version, which is by definition
        # what priming would have produced. Priming means "ensure the add-on is
        # at the pinned version", and an absent add-on is not at the wrong
        # version — it is not yet the subject of the question.
        #
        # Deliberately NOT a failure and deliberately NOT a success either:
        # SKIPPED is counted separately so the marker stays unwritten and the
        # service still runs next boot. That keeps the post-OTA case — the one
        # this service exists for — fully intact, while a fresh flash stops
        # reporting a failure it does not have.
        log "  → $SLUG: not installed yet (ga-bootstrap installs it later this boot) — nothing to prime, skipping"
        SKIPPED=$((SKIPPED + 1))
        PRIMED_OK=0
    else
        # The LAST meaningful line is the error ("Error: ..."); the first line
        # used to be logged and was the deprecation notice on 2026.10.
        log "  → $SLUG: FAILED (rc=$UPDATE_RC) — $(last_line "$UPDATE_OUT")"
        log_full "$UPDATE_OUT"
        FAIL=$((FAIL + 1))
        PRIMED_OK=0
    fi

    # 1.2.22+: defensive `ha addons start` after every successful update.
    # The Supervisor 2025.11.4.6 no-autostart-after-update bug
    # (= bug_supervisor_no_autostart_after_addon_update_2026_06_19) lands
    # the addon in state=stopped despite boot:auto. Chaining a start here
    # papers over the bug at the OS priming layer (the runtime ga_manager
    # addon-update worker carries the equivalent fix as of 0.48.0).
    # No-op when the addon is already running. `|| true` because some
    # addons may be intentionally stopped (= protected user override) +
    # we don't want a benign start failure to fail the prime gate.
    if [ "$PRIMED_OK" -eq 1 ]; then
        run_ha "$APPS_CMD" start "$SLUG"
        START_RC=$RUN_RC
        if [ "$START_RC" -eq 0 ]; then
            log "  → $SLUG: defensive start OK"
        else
            # rc!=0 is normal for "already running" — only log at debug level.
            log "  → $SLUG: defensive start rc=$START_RC (= addon may already be running)"
        fi
    fi
done < "$PRIME_CONF"

if [ "$STORE_STALE" -eq 1 ]; then
    log "ERROR: store reload failed — prime incomplete, retry next start (no marker written)"
    exit 1
fi

if [ "$FAIL" -gt 0 ]; then
    log "ERROR: $FAIL addon(s) failed to prime — marker NOT written, service will retry next boot"
    exit 1
fi

if [ "$SKIPPED" -gt 0 ]; then
    # Not an error: the add-on is not installed yet (fresh flash). No marker, so
    # the service re-runs next boot; exit 0, so systemd does not show a failed
    # unit for a device in a perfectly normal state. The distinction matters —
    # a red unit that is always red on a fresh device teaches operators to
    # ignore red units.
    log "$SKIPPED addon(s) not installed yet — nothing primed, marker NOT written, will run again next boot"
    exit 0
fi

log "all addons primed — writing marker $MARKER"
touch "$MARKER"
log "done"
