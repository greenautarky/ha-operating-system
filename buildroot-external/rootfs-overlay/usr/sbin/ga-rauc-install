#!/bin/sh
# ga-rauc-install — download + RAUC-install + reboot for an HAOS version.
#
# Invoked by the ga-rauc-install.service systemd unit (= triggered in
# turn by ga-rauc-install.path watching the request file), or manually
# by an operator on the host. The systemd path-watcher fires when
# /mnt/data/supervisor/share/ga-rauc-install-request is written or
# updated by ga_manager 0.42.0+ (the addon container sees the same
# file at /share/ga-rauc-install-request).
#
# Argument modes:
#   ga-rauc-install                    — no arg: read version from the request
#                                        file + optional ga_release from its
#                                        .rc sidecar (delete-first to re-trigger).
#   ga-rauc-install <version> [<rc>]   — explicit args: skip the request file,
#                                        use the passed version + optional
#                                        ga_release. For operator debug.
#
# Either path validates the version regex, then downloads the OTA bundle. With
# a ga_release it pulls the per-rc canary slot
# releases/<version>/<ga_release>/haos_ihost-<version>.raucb (falling back to
# the version-only prod slot on 404); without one it pulls the prod slot
# releases/<version>/haos_ihost-<version>.raucb. Then `rauc info` +
# `rauc install` + a 5-second-delayed reboot.
#
# Background — why the path-watcher pattern instead of the original
# BOSv1.2.17 systemd template @.service: Supervisor's REST API
# (verified in 2025.11.4.6 source) exposes /host/services as GET-only;
# there is no /start. The 0.41.0 worker that called
# /host/services/ga-rauc-install@VERSION.service/start always 404'd.
# Files in /share/ are the existing addon-to-host trampoline (already
# used for ghcr-creds.json + ga-fleet-bundle.yaml) — re-using it for
# RAUC trigger means no new Supervisor API dependencies + a clear
# audit trail in /mnt/data/supervisor/share/.

set -eu

REQUEST_FILE="/mnt/data/supervisor/share/ga-rauc-install-request"
# Optional sidecar carrying the GA release label (e.g. BOSv1.2.21-rc19). When
# present, the bundle is pulled from the per-rc CANARY slot
# releases/<version>/<ga_release>/… instead of the shared per-HAOS-version
# PROD slot releases/<version>/… — so a canary build never occupies the
# production slot. The version request file itself stays byte-identical, so
# pre-per-rc hosts (which never read this sidecar) behave exactly as before.
REQUEST_RC_FILE="${REQUEST_FILE}.rc"
VERSION="${1:-}"
GA_RELEASE="${2:-}"

if [ -z "$VERSION" ]; then
    if [ ! -f "$REQUEST_FILE" ]; then
        echo "[ga-rauc-install] FATAL: no VERSION arg and $REQUEST_FILE absent" >&2
        exit 2
    fi
    # Read THEN delete — the delete is the dedupe gate. If install fails,
    # the file is gone and a re-trigger requires a fresh write (which is
    # the desired behaviour: don't retry a known-bad version on every
    # path event).
    VERSION="$(head -c 64 "$REQUEST_FILE" | tr -d '[:space:]')"
    # Read the optional ga_release sidecar BEFORE removing the request file.
    if [ -z "$GA_RELEASE" ] && [ -f "$REQUEST_RC_FILE" ]; then
        GA_RELEASE="$(head -c 64 "$REQUEST_RC_FILE" | tr -d '[:space:]')"
    fi
    rm -f "$REQUEST_FILE" "$REQUEST_RC_FILE"
    echo "[ga-rauc-install] read VERSION='$VERSION' GA_RELEASE='${GA_RELEASE}' from $REQUEST_FILE (files removed)"
fi

# Validate version format — refuse anything that isn't N.N.N.N digits-
# and-dots. The systemd template variant was operator-influencable
# through the Supervisor API; the file-based variant is influencable
# by anything able to write to /share/, which is every running addon
# container. Defence in depth: the worker validates too.
case "$VERSION" in
    *[!0-9.]* | "" | *..* | .* | *. )
        echo "[ga-rauc-install] FATAL: refusing malformed version '$VERSION'" >&2
        exit 2
        ;;
esac

# Validate the optional ga_release label (defence in depth — anything able to
# write /share/ can write the sidecar). Allow only [A-Za-z0-9.-]; on anything
# else, DROP it and fall back to the version-only slot rather than fail the
# whole install.
case "$GA_RELEASE" in
    "" ) : ;;                      # no label → version-only PROD slot
    *[!A-Za-z0-9.-]* )
        echo "[ga-rauc-install] WARN: ignoring malformed ga_release '$GA_RELEASE' — using version-only slot" >&2
        GA_RELEASE=""
        ;;
esac

# Per-rc slot when a ga_release is given, else the version-only prod slot.
# With a ga_release we FALL BACK to the prod slot on a 404 so a device is never
# stranded if the per-rc bundle wasn't staged (e.g. transitional roll).
BASE_URL="https://ota.greenautarky.com/releases/${VERSION}"
if [ -n "$GA_RELEASE" ]; then
    PRIMARY_URL="${BASE_URL}/${GA_RELEASE}/haos_ihost-${VERSION}.raucb"
    FALLBACK_URL="${BASE_URL}/haos_ihost-${VERSION}.raucb"
else
    PRIMARY_URL="${BASE_URL}/haos_ihost-${VERSION}.raucb"
    FALLBACK_URL=""
fi
# Staging directory: /mnt/data/tmp/ — our canonical "scratch space for
# anything larger than a few MB". /tmp/ on HAOS is a 15 MB zram tmpfs
# (see device:/etc/fstab) — a 230 MB raucb bundle does not fit there,
# curl returns error 23 mid-download. /mnt/data/tmp/ is created by
# /usr/lib/tmpfiles.d/ga-mnt-data-tmp.conf and aged out at 7 days by
# systemd-tmpfiles-clean.timer.
STAGING_DIR="/mnt/data/tmp"
mkdir -p "$STAGING_DIR"
BUNDLE="$STAGING_DIR/ga-rauc-install-${VERSION}.raucb"

echo "[ga-rauc-install] downloading $PRIMARY_URL"
if ! curl --fail --silent --show-error --location --output "$BUNDLE" "$PRIMARY_URL"; then
    if [ -n "$FALLBACK_URL" ]; then
        echo "[ga-rauc-install] per-rc slot miss — falling back to $FALLBACK_URL" >&2
        if ! curl --fail --silent --show-error --location --output "$BUNDLE" "$FALLBACK_URL"; then
            echo "[ga-rauc-install] FATAL: download failed for $PRIMARY_URL and $FALLBACK_URL" >&2
            exit 3
        fi
    else
        echo "[ga-rauc-install] FATAL: download failed for $PRIMARY_URL" >&2
        exit 3
    fi
fi
echo "[ga-rauc-install] downloaded $(stat -c %s "$BUNDLE" 2>/dev/null || wc -c < "$BUNDLE") bytes"

echo "[ga-rauc-install] verifying RAUC bundle"
if ! rauc info "$BUNDLE" >/dev/null 2>&1; then
    echo "[ga-rauc-install] FATAL: rauc info refuses the bundle (truncated? wrong signature?)" >&2
    rm -f "$BUNDLE"
    exit 4
fi

echo "[ga-rauc-install] installing $BUNDLE"
if ! rauc install "$BUNDLE"; then
    echo "[ga-rauc-install] FATAL: rauc install failed" >&2
    rm -f "$BUNDLE"
    exit 5
fi

echo "[ga-rauc-install] install OK — scheduling reboot in 5s"
rm -f "$BUNDLE"
sync
# Detach so the systemd unit can exit cleanly before reboot — otherwise
# the path-unit's triggered .service appears hung until reboot fires.
( sleep 5 && systemctl reboot ) &
exit 0
