#!/bin/sh
# ga-rauc-install — download + RAUC-install + reboot for an HAOS version.
#
# Invoked by the ga-rauc-install@VERSION.service systemd template, which
# ga_manager 0.41.0+ triggers via Supervisor's /host/services API when
# Supervisor's own /os/update endpoint refuses an update (= 400 because
# same-HAOS-version with different GA-overlay; tracked in
# memory:incident_ota_false_negative_on_reboot_2026_06_12 + the
# session_2026_06_16 LTE-dongle session notes).
#
# Argument: VERSION — exact HAOS internal version (e.g. 16.3.1.10).
# Constructs the OTA URL from a fixed pattern + downloads + rauc-installs
# + reboots. Runs as root via the systemd unit.

set -eu

VERSION="${1:-}"
if [ -z "$VERSION" ]; then
    echo "[ga-rauc-install] FATAL: no VERSION arg passed (usage: ga-rauc-install <version>)" >&2
    exit 2
fi

# Validate version format — refuse anything that isn't N.N.N.N digits-and-dots.
# This is a small but real safety guard since the value comes via systemd
# template instance name, which is operator-influencable through /host/services.
case "$VERSION" in
    *[!0-9.]* | "" | *..* | .* | *. )
        echo "[ga-rauc-install] FATAL: refusing malformed version '$VERSION'" >&2
        exit 2
        ;;
esac

URL="https://ota.greenautarky.com/releases/${VERSION}/haos_ihost-${VERSION}.raucb"
BUNDLE="/tmp/ga-rauc-install-${VERSION}.raucb"

echo "[ga-rauc-install] downloading $URL"
if ! curl --fail --silent --show-error --location --output "$BUNDLE" "$URL"; then
    echo "[ga-rauc-install] FATAL: download failed for $URL" >&2
    exit 3
fi
echo "[ga-rauc-install] downloaded $(stat -c %s "$BUNDLE" 2>/dev/null || wc -c < "$BUNDLE") bytes"

echo "[ga-rauc-install] verifying RAUC bundle"
if ! rauc info "$BUNDLE" >/dev/null 2>&1; then
    echo "[ga-rauc-install] FATAL: rauc info refuses the bundle (truncated? wrong signature?)" >&2
    rm -f "$BUNDLE"
    exit 4
fi

echo "[ga-rauc-install] installing $BUNDLE"
if ! rauc install "$BUNDLE"; then
    echo "[ga-rauc-install] FATAL: rauc install failed" >&2
    rm -f "$BUNDLE"
    exit 5
fi

echo "[ga-rauc-install] install OK — scheduling reboot in 5s"
rm -f "$BUNDLE"
sync
# Detach so the systemd unit can exit cleanly before reboot — otherwise
# `host/services/<svc>/start` callers see the service hung until reboot.
( sleep 5 && systemctl reboot ) &
exit 0
