#!/bin/sh
# ga-ha-dns-fallback — Configure HA Supervisor DNS with explicit Cloudflare
# upstream servers AND DoT fallback DISABLED.
#
# Target state (set on every boot, idempotent):
#   servers  = [dns://1.1.1.1, dns://1.0.0.1]
#   fallback = false
#
# Why this exact combination (revised 2026-05-07):
#   - Explicit `servers` (Cloudflare): forward lookups (HACS, GitHub, updates,
#     Tailscale control plane) go directly to a known-good resolver, independent
#     of which interface is up (Ethernet / WiFi / LTE-RNDIS / OpenStick LTE-WiFi).
#     This was the original 2026-04-22 fix for the Dongle-DNS Single-Point-of-Failure.
#   - `fallback=false` (DoT off): with fallback=true, HA Core's PTR sweeps for the
#     local subnet escalate to DoT (1.1.1.1:853) when the DHCP-derived locals DNS
#     doesn't answer RFC1918 PTRs. The DoT TLS handshake hangs ~75-95s per query
#     and spikes hassio_dns to 180% CPU. Measured 2026-05-07 on kib-son-0;
#     ga-flasher-py TODO §"DNS Fallback CPU Spike" has the full analysis.
#   - /etc/hosts (populated by ga-update-hosts.service from ga-services.conf) keeps
#     highest priority — GA endpoints (ota / influx / loki) resolve to NetBird IPs
#     before any external DNS query.
#
# Vodafone fleet ACL: 1.1.1.1 is allow-listed, so this works on Vodafone-APN LTE.
#
# Defense-in-depth alongside ha-supervisor commit 6b427484 ("feat(dns): GA
# defaults") which sets the same values as schema defaults. This service is the
# runtime safety-net that kicks in on every boot, including when the supervisor
# was reset/recreated for some reason.
#
# Idempotent — only writes if servers/fallback differ from desired state.
set -e

DESIRED_FALLBACK="false"
DESIRED_SERVERS="dns://1.1.1.1 dns://1.0.0.1"

log() { echo "ga-ha-dns-fallback: $*"; }

# Wait briefly for `ha` CLI + supervisor to be ready
i=0
while ! ha dns info >/dev/null 2>&1; do
    i=$((i+1))
    if [ "$i" -gt 30 ]; then
        log "ha CLI not ready after 30s, exiting (will run on next boot)"
        exit 0
    fi
    sleep 2
done

# Read current state
current=$(ha dns info 2>/dev/null || echo "")
fallback=$(echo "$current" | awk '/^fallback:/{print $2}')

# Compare: only write if fallback != desired OR Cloudflare servers missing.
# servers in `ha dns info` output appear as YAML list lines like "- dns://1.1.1.1".
need_update=0
[ "$fallback" != "$DESIRED_FALLBACK" ] && need_update=1
echo "$current" | grep -q 'dns://1.1.1.1' || need_update=1
echo "$current" | grep -q 'dns://1.0.0.1' || need_update=1

if [ "$need_update" = "0" ]; then
    log "DNS upstream already at desired state (fallback=$fallback, Cloudflare servers present) — skipping"
    exit 0
fi

log "configuring DNS: --fallback=$DESIRED_FALLBACK --servers '$DESIRED_SERVERS'"
# shellcheck disable=SC2086
ha dns options --fallback=$DESIRED_FALLBACK --servers dns://1.1.1.1 --servers dns://1.0.0.1 2>&1

log "done"
