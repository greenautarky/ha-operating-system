#!/bin/sh
# ga-supervisor-cli-watchdog — heal the Supervisor first-boot connectivity
# deadlock (Odoo #1706) by restarting hassos-supervisor ONCE per boot.
#
# THE FAULT. The Supervisor's first version fetch can race the network coming
# up. It then caches "no connectivity", and the plugin install loop (which only
# calls Updater.reload()) retries every 30 s against that stale value for ever:
# the log says "No Supervisor connectivity, delaying version fetch" and "Error
# on installing cli plugin, retrying in 30sec", hassio_cli is never created and
# nothing else (ga-addon-prime, Core, ga_manager, provisioning) comes up.
# `systemctl restart hassos-supervisor` heals it. Fix at the source: the
# Supervisor fork (greenautarky/ha-supervisor). This is the OS-side net under
# it for images that ship an affected Supervisor.
#
# CONDITION (all four, every tick; otherwise no action):
#   1. the hassio_supervisor container is running and has been for >= N s
#      (N = GA_SCW_MIN_UPTIME, default 240; see TIMING);
#   2. hassio_cli is NOT running (`docker inspect` fails or State.Running is
#      not true);
#   3. the Supervisor's own log carries the deadlock signature
#      "Error on installing cli plugin, retrying" inside the last
#      GA_SCW_LOG_WINDOW (default 10m). Without it the cli is missing for some
#      other reason and a restart would be a guess: log ERROR, do not restart;
#   4. no attempt has been made in THIS boot (marker keyed by the kernel
#      boot id, on tmpfs /run, so a reboot gives one new attempt and a failed
#      or hanging restart is never retried).
# Core is deliberately NOT part of the condition: Core can be stopped on
# purpose (and a first boot can take 8+ min to start it), a missing Core is not
# evidence of this fault, while a missing hassio_cli with that log signature is.
#
# TIMING (measured). Fresh-flash gate run of BOSv1.6.0-rc6 on the bench unit
# (2026-11-09): kernel 14:03:20, hassos-supervisor start 14:04:07 (+47 s),
# "Starting CLI plugin" 14:04:32 (+25 s after the container started). The
# Supervisor retries the plugin install every 30 s (plugins/base.py), so a
# healthy boot has the cli within ~1 minute of container start; N = 240 s is
# ~10x that, and still before ga-addon-prime gives up waiting for hassio_cli
# (60 x 5 s = 5 min), so the restart can still rescue the prime.
# The timer starts at +4 min after boot and then ticks every minute.
#
# ACTION, in this order, so a hang can never loop: write the attempt marker,
# log at ERROR (journal priority err -> tier-0 Loki), publish status JSON via
# ga-share-publish to /mnt/data/supervisor/share/ga-supervisor-cli-watchdog.json,
# `systemctl restart hassos-supervisor.service`, publish the outcome.
#
# POSIX /bin/sh (busybox). Every command and path is overridable for the host
# suite tests/ga_tests/supervisor_cli_watchdog.
set -u

DOCKER="${GA_SCW_DOCKER:-docker}"
SYSTEMCTL="${GA_SCW_SYSTEMCTL:-systemctl}"
PUBLISH="${GA_SCW_PUBLISH:-/usr/libexec/ga-share-publish}"
SHARE_FILE="${GA_SCW_SHARE_FILE:-/mnt/data/supervisor/share/ga-supervisor-cli-watchdog.json}"
STATE_DIR="${GA_SCW_STATE_DIR:-/run}"
BOOT_ID_FILE="${GA_SCW_BOOTID:-/proc/sys/kernel/random/boot_id}"
MIN_UPTIME="${GA_SCW_MIN_UPTIME:-240}"
LOG_WINDOW="${GA_SCW_LOG_WINDOW:-10m}"
UNIT="${GA_SCW_UNIT:-hassos-supervisor.service}"
NOW="${GA_SCW_NOW:-$(date -u +%s)}"
MARKER="$STATE_DIR/ga-supervisor-cli-watchdog.attempted"

# systemd priority prefixes: <3> err, <4> warning, <6> info
loge() { echo "<3>ga-supervisor-cli-watchdog: ERROR: $*"; }
logw() { echo "<4>ga-supervisor-cli-watchdog: $*"; }
logi() { echo "<6>ga-supervisor-cli-watchdog: $*"; }

BOOT_ID="$(tr -d '-' < "$BOOT_ID_FILE" 2>/dev/null | cut -c1-32)"
[ -n "$BOOT_ID" ] || BOOT_ID=unknown

# publish STATE DETAIL
publish() {
    _d="$(printf '%s' "$2" | tr '"\\' "''")"
    _j="$(printf '{"schema_version":1,"ts":%s,"state":"%s","detail":"%s","boot_id":"%s","min_uptime_s":%s}\n' \
        "$NOW" "$1" "$_d" "$BOOT_ID" "$MIN_UPTIME")"
    if [ -x "$PUBLISH" ]; then
        printf '%s' "$_j" | "$PUBLISH" "$SHARE_FILE" 2>/dev/null \
            || logw "could not publish $SHARE_FILE"
    fi
}

# Seconds the hassio_supervisor container has been running; empty if not running.
supervisor_uptime() {
    _s="$(timeout 20 "$DOCKER" inspect -f '{{.State.Running}} {{.State.StartedAt}}' hassio_supervisor 2>/dev/null)" || return 0
    case "$_s" in true\ *) ;; *) return 0 ;; esac
    _t="${_s#true }"
    _t="${_t%%.*}"; _t="${_t%Z}"; _t="$(printf '%s' "$_t" | tr 'T' ' ')"
    _e="$(date -u -d "$_t" +%s 2>/dev/null)" || return 0
    echo $((NOW - _e))
}

cli_running() {
    [ "$(timeout 20 "$DOCKER" inspect -f '{{.State.Running}}' hassio_cli 2>/dev/null)" = true ]
}

if [ -f "$MARKER" ] && [ "$(cat "$MARKER" 2>/dev/null)" = "$BOOT_ID" ]; then
    # Quiet: this tick repeats every minute for the rest of the boot.
    exit 0
fi

up="$(supervisor_uptime)"
if [ -z "$up" ]; then
    logi "hassio_supervisor container not running — nothing to watch"
    exit 0
fi
if [ "$up" -lt "$MIN_UPTIME" ]; then
    logi "hassio_supervisor up ${up}s < ${MIN_UPTIME}s — too early to judge"
    exit 0
fi
if cli_running; then
    publish ok "hassio_cli running (supervisor up ${up}s)"
    exit 0
fi

sig="$(timeout 30 "$DOCKER" logs --since "$LOG_WINDOW" hassio_supervisor 2>&1 | grep -c 'Error on installing cli plugin, retrying')"
if [ "${sig:-0}" -lt 1 ]; then
    loge "hassio_cli is not running ${up}s after the Supervisor started, but the Supervisor log shows no plugin-install retries in the last $LOG_WINDOW — NOT the connectivity deadlock, NOT restarting (needs a human)"
    publish cli_missing_no_signature "hassio_cli missing, supervisor up ${up}s, no install-retry signature; no action"
    exit 0
fi

# Marker FIRST: whatever happens next, this boot never tries again.
mkdir -p "$STATE_DIR" 2>/dev/null
printf '%s\n' "$BOOT_ID" > "$MARKER" || loge "cannot write the attempt marker $MARKER — restarting anyway, a later tick may repeat it"
loge "Supervisor first-boot deadlock: hassio_cli missing ${up}s after the Supervisor started and the log shows $sig plugin-install retries — restarting $UNIT ONCE (Odoo #1706)"
publish restarting "supervisor up ${up}s, $sig install retries, restarting $UNIT"
if timeout 180 "$SYSTEMCTL" restart "$UNIT"; then
    logw "$UNIT restarted by the watchdog (once per boot)"
    publish restarted "restarted $UNIT at $NOW; no further attempt this boot"
else
    loge "restart of $UNIT FAILED — no further attempt this boot"
    publish restart_failed "restart of $UNIT failed; no further attempt this boot"
fi
exit 0
