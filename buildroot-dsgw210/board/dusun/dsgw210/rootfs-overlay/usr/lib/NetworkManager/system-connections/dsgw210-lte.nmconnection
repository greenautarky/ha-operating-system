# DSGW-210 LTE - built-in Quectel BG96 cellular connection (ModemManager + NM).
#
# Vendor default, shipped read-only on the erofs rootfs. This is the board's
# fallback uplink: ga-uplink-ladder treats it as a rung (Odoo #2176).
#
# THE APN IS NOT PINNED HERE. [gsm] carries auto-config=true: ModemManager / NM
# resolve the APN from the SIM operator (mobile-broadband-provider-info).
# Set it for a SIM that is not in that database (an IoT / fleet SIM) by
# writing the APN, one line, to /mnt/boot/ga-lte-apn on the boot partition;
# ga-uplink-ladder applies it to this profile within one tick (<= 2 min) and
# re-dials if the profile is up. The board default for series production is
# GA_LTE_APN_DEFAULT in /usr/share/ga-board.conf (empty today = auto).
# NetworkManager reads profiles from /usr/lib, /run and /etc/NetworkManager/
# system-connections - the last wins - so an `nmcli connection modify` copy
# in /etc also overrides this file.

[connection]
id=DSGW-210 LTE
uuid=b89ac5c9-23cd-4fa5-af32-0ed84fde155a
type=gsm
autoconnect=true
# 0 = retry autoconnect forever (the modem can take a while to register).
autoconnect-retries=0
# Negative priority: prefer ethernet / Wi-Fi for autoconnect ordering.
autoconnect-priority=-50

[gsm]
# no apn= on purpose (see the header); the ladder writes one when configured
auto-config=true

[ipv4]
method=auto
# Fallback metric: end0 (~100) and wlan0 (~600) outrank this, so LTE is
# the backup default route. The kernel fails over to it automatically
# when the higher-priority WAN drops, and back when it returns.
route-metric=700

[ipv6]
# No IPv6 PDP on the BG96/Telekom path here — skip IPV6CP entirely
# (otherwise pppd burns ~30 s on an IPV6CP timeout at every dial).
method=ignore
