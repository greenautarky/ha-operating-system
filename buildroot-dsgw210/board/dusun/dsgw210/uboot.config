# DSGW-210 u-boot fragments — overlayed on top of rock64-rk3328_defconfig.
#
# Keep this minimal: only real deltas from the rock64 defaults (same SoC,
# similar layout).
CONFIG_ENV_IS_IN_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_GPT=y

# DRAM hardware delta from the Rock64: the Rock64 ships LPDDR3 at 800 MHz, this
# board DDR4 at 333 MHz. Mainline u-boot's built-in TPL is hardcoded to the
# Rock64's LPDDR3 timing and fails DDR training here, so rkbin's external DDR4
# init blob (rk3328_ddr_333MHz_v1.22.bin, used as ram_init.bin) must be the TPL
# stage instead of u-boot's compiled one.
#
# Setting CONFIG_ROCKCHIP_EXTERNAL_TPL=y switches binman's rockchip-u-boot.dtsi from
# the `u-boot-tpl` node to the `rockchip-tpl` node, which substitutes whatever
# path the ROCKCHIP_TPL environment variable points to. Buildroot's u-boot
# package sets ROCKCHIP_TPL=$(BINARIES_DIR)/ram_init.bin when
# BR2_TARGET_UBOOT_NEEDS_TPL=y and BR2_PACKAGE_ROCKCHIP_BLOBS_TPL is set in the
# defconfig. Without it the board does not come up from eMMC.
CONFIG_ROCKCHIP_EXTERNAL_TPL=y

# USB-C rockusb recovery path.
# The unit has no MaskROM button, so u-boot itself offers a way back to USB
# flashing once it is on the eMMC. Three entries, all ending in rockusb on the
# OTG controller (usb@ff580000, the USB-C port), eMMC = mmc 0:
#   1. Linux `reboot loader` -> boot-mode reg 0x5242C301 -> preboot
#      (patch 0002-rockchip-boot_mode-enter-rockusb-on-BOOT_LOADER.patch)
#   2. boot script: no bootable slot left (uboot-boot.ush)
#   3. bootcmd: bootflow scan returned without booting (below)
#
# setup_boot_mode() is only called from board_late_init(); rock64 does not
# enable BOARD_LATE_INIT, so without this line entry 1 is unreachable.
CONFIG_BOARD_LATE_INIT=y
CONFIG_USE_PREBOOT=y
CONFIG_ROCKCHIP_BOOT_MODE_REG=0xff1005c8
# setup_boot_mode() also polls a "download key" on saradc channel 1 and, if it
# reads <= 30, forces MaskROM on every boot. This board has no such key: keep
# the ADC out of u-boot.
# CONFIG_ADC is not set
# Gadget: driver-model dwc2, so the inno usb2 PHY (u2phy_otg) is powered by
# the generic PHY framework; the legacy non-DM path does not power it on
# rk3328. The dwc2 HOST driver matches the same node ("snps,dwc2") and
# u-boot never uses the OTG port as host here: drop it to avoid a bind race.
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_GADGET_DWC2_OTG=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_ROCKUSB=y
CONFIG_CMD_ROCKUSB=y
# rockusb only. Something implies the fastboot gadget once USB_GADGET is on,
# and FASTBOOT_BUF_ADDR has no default for rk3328, so kconfig would prompt
# forever in a non-interactive build. Off.
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_USB_DWC2 is not set
# 2207:320c = RK3328 rockusb; rkdeveloptool matches on VID/PID. NOTE:
# rkdeveloptool labels Loader vs Maskrom by bcdUSB bit 0; u-boot's gadget
# reports bcdUSB 0x0200, so `rkdeveloptool ld` lists this as "Maskrom".
# rl/wl/rd accept both types, so this is cosmetic.
CONFIG_USB_GADGET_VENDOR_NUM=0x2207
CONFIG_USB_GADGET_PRODUCT_NUM=0x320c
# Distinguishes our u-boot rockusb from the BootROM / stock loader in lsusb.
CONFIG_USB_GADGET_MANUFACTURER="DSGW-210 U-Boot"
# Default for this config is "bootflow scan" (BOOTSTD_DEFAULTS without
# CMD_BOOTFLOW_FULL). Keep it first; only if it returns (no boot script
# anywhere, or nothing booted) fall through to rockusb on the eMMC.
# rockusb gives up after 300 s without host traffic (u-boot patch 0004),
# then `reset` retries the boot.
CONFIG_BOOTCOMMAND="bootflow scan; echo DSGW210-FALLBACK: bootflow scan returned, entering rockusb 0 mmc 0 300; rockusb 0 mmc 0 300; reset"
