# DSGW-210 kernel config fragment — merges on top of
# kernel-arm64-rockchip.config + HAOS fragments.
#
# Only deltas specific to this board go here. Generic Rockchip RK3328
# support is already in the base config.

# ---------------------------------------------------------------------
# USB OTG gadget -- serial console over USB-C (the board has no dedicated
# UART pin header).
# ---------------------------------------------------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_ECM=y
CONFIG_U_SERIAL_CONSOLE=y

# ---------------------------------------------------------------------
# SPI -- Rockchip SPI controllers for the LoRa SX1302 concentrator
# (spidev userspace access).
# ---------------------------------------------------------------------
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=y

# ---------------------------------------------------------------------
# Serial -- UART1 (Z-Wave ZGM130S) + UART2 (debug/console)
# ---------------------------------------------------------------------
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# ---------------------------------------------------------------------
# USB-serial -- CH341 USB-UART bridges used by the on-board radios
# ---------------------------------------------------------------------
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y

# ---------------------------------------------------------------------
# SDIO / MMC -- SDIO path for the Wi-Fi+BT combo chip
# ---------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# ---------------------------------------------------------------------
# GPIO keys -- reset button ("ResetKey")
# ---------------------------------------------------------------------
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# ---------------------------------------------------------------------
# GPIO / leds -- LED class subsystem
# ---------------------------------------------------------------------
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DISK=y

# ---------------------------------------------------------------------
# RTC -- board RTC is the PCF85063 at i2c1 0x51, as in the vendor DT. The
# vendor DT disables the RK805 RTC; the mainline rk8xx MFD cell has no DT
# switch, so it is disabled here. PCF85063 is built in so it is rtc0 before
# hctosys.
# ---------------------------------------------------------------------
CONFIG_RTC_DRV_PCF85063=y
# CONFIG_RTC_DRV_RK808 is not set

# ---------------------------------------------------------------------
# RK805 power key -- disabled, as in the vendor DT. The mainline rk8xx MFD
# registers the rk805-pwrkey cell unconditionally (drivers/mfd/rk8xx-core.c,
# no of_compatible), so DT cannot switch it off; the driver is left out.
# ---------------------------------------------------------------------
# CONFIG_INPUT_RK805_PWRKEY is not set

# ---------------------------------------------------------------------
# Battery charger + fuel gauge on i2c0, as in the vendor DT (bq25895@6A,
# bq27546@55). Modules are enough.
# ---------------------------------------------------------------------
CONFIG_CHARGER_BQ25890=m
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m

# ---------------------------------------------------------------------
# No audio stack. The gateway has no audio function and the fleet policy is
# that no device gains a capture path (the generic HAOS fragments enable the
# sound subsystem; the build test suite AUD-01..05 holds this off).
# ---------------------------------------------------------------------
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# ---------------------------------------------------------------------
# Watchdog -- DW watchdog (standard for Rockchip platforms)
# ---------------------------------------------------------------------
CONFIG_DW_WATCHDOG=y
# Pretimeout -> panic, so a watchdog expiry leaves a pstore dmesg record
# (ramoops, below) instead of a silent reset. dw_wdt offers pretimeout
# only when its DT node has an interrupt (rk3328.dtsi: GIC_SPI 40), and
# enables it when userspace sets any non-zero pretimeout (systemd
# RuntimeWatchdogPreSec, see 10-dsgw210-watchdog.conf). The IRQ fires on
# the first expiry of the hardware counter, the reset follows one counter
# period (~28.6 s at pclk_wdt 75 MHz) later; the panic reboots after
# CONFIG_PANIC_TIMEOUT=5 s, well before that.
CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y

# ---------------------------------------------------------------------
# cpufreq: schedutil by default. "performance" would pin the SoC at its top
# OPP (1.296 GHz) permanently and cost idle thermal headroom. The thermal trips
# are the rk3328.dtsi defaults (critical 95 C, orderly poweroff; hardware
# shutdown at 100 C) and are intentionally not overridden. "performance" stays
# built in for manual use.
# ---------------------------------------------------------------------
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_THERMAL_GOV_BANG_BANG=y

# ---------------------------------------------------------------------
# pstore/ramoops — keep the previous boot's console and any panic/oops
# record in a RAM region that survives a warm reset (region: DT node
# reserved-memory/ramoops@30000000). Built in, not =m as in the base
# config, so it is registered before userspace and captures the whole
# console of a boot that later hangs. systemd-pstore.service (enabled
# in the image) archives /sys/fs/pstore to /var/lib/systemd/pstore.
# A watchdog expiry writes a panic record via the pretimeout governor
# (Watchdog section above); a hardware reset without that IRQ writes none,
# only the console ring survives.
# ---------------------------------------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
