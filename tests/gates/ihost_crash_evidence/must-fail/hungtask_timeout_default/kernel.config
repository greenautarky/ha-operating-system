CONFIG_DEFAULT_MESSAGE_LOGLEVEL=8
CONFIG_MMC_DW_ROCKCHIP=y
# CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CH343=m
CONFIG_HID_GENERIC=y

# Bluetooth as modules only — never autoloaded by default. The onboard
# RTL8723DS BT (serdev node on uart0) is gated at boot by the marker file
# /mnt/boot/ga-bluetooth (see rootfs-overlay ga-bluetooth.service +
# modprobe.d blacklist). Without the marker the modules stay unloaded.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_RTL=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# Disable Linux sound subsystem completely
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# ---- Crash evidence (a field unit hard-resets ~1.4x/day with no log) --------
# Goal: tell power loss from "hang -> DW watchdog" and from "panic -> reboot
# after PANIC_TIMEOUT=5". The ramoops region lives in the iHost DT
# (patches/linux/0006-ihost-ramoops.patch). Built in (not =m): a module would
# load too late for an early panic and cannot load at all once the rootfs is
# wedged.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Hang -> panic (=> pstore record) instead of a silent watchdog reset. The
# systemd RuntimeWatchdog is 30 s and is NOT changed; the detectors fire
# before it: softlockup at ~2x watchdog_thresh(10 s) = ~20 s, buddy hardlockup
# at ~10 s. A total hang (all CPUs, no interrupts) is still only seen as a
# watchdog reset with an EMPTY pstore, which is itself evidence.
# Buddy, not perf: arm32 has no NMI perf; buddy needs only SMP (4x A7).
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# hung_task fires on a task in D state longer than the timeout, and a slow SD
# card produces exactly that. The default 120 s is reachable on a degraded card
# during a docker pull; a panic there would turn a slow device into a boot
# loop. 300 s: an I/O that stalls five minutes is not coming back. Revisit once
# the fleet shows how often it fires.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
