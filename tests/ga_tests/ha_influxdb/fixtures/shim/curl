#!/bin/sh
# curl shim for the ha_influxdb suite selftest — the InfluxDB /query answer comes
# from the fixture; every argument is logged so the selftest can assert WHAT was
# asked (database, measurement, and that the credential is the entry's own).
pick() { if [ -e "$GA_HAIX_FIXTURE/$1" ]; then echo "$GA_HAIX_FIXTURE/$1"; else echo "$GA_HAIX_FIXTURE_BASE/$1"; fi; }
printf '%s\n' "$@" >> "${GA_HAIX_TMP:-/tmp}/curl-args.log"
f="$(pick influx-response.json)"; [ -e "$f" ] && cat "$f"; :
