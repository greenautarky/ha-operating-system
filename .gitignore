# OS generated files
.DS_Store

# Build output dirs
/release
output*/
ga_output*/

# Buildroot-external generated helper files (local/ephemeral)
.br2-external.*

# Certificates
*.pem
# F13 (2026-06-05): legacy signing cert is committed intentionally —
# public X.509 only, no private key — so all future builds bake it
# into the rauc keyring. See buildroot-external/scripts/rauc.sh
# install_rauc_certs().
buildroot-ihost/rootfs-overlay/etc/shadow

# Local build secrets — ignore files inside (NOT the dir itself, so
# .example template files can be re-included via the !secrets/*.example
# negation. Excluding the dir with `secrets/` blocks ALL negations
# beneath it per the gitignore docs.)
scripts/local.env
secrets/*
!secrets/.gitkeep
!secrets/*.example
*.env.local
serial-password.txt

# vscode generated files
.vscode*

# local history files
*.history

# Container image tarballs
images/*.tar

# AI tooling
.claude
scan-results/
releases/
.playwright-mcp/

# Session-local screenshots from operator audits (browser captures,
# diagnostic screenshots, fleet-page snapshots) — these are short-lived
# artifacts, never check them into the OS repo.
/*.png

# Local-only backups (z2m state, device snapshots etc) — never commit
.local-backups/

# Tier-2 components pulled at OS build time by scripts/sync-components.sh.
# The pinned version lives in version.yaml; the pulled trees themselves
# are NOT committed (= single source of truth is the component repo,
# not a stale copy in this repo). To re-pull manually, run
# `./scripts/sync-components.sh`.
buildroot-external/rootfs-overlay/usr/share/ga/custom_components/greenautarky_site/
buildroot-external/rootfs-overlay/usr/share/ga/custom_components/ga_frontend_bundle/
# ga-telemetry-config (Tier-2: usr/libexec/ga-boot-timing + etc/fluent-bit/fluent-bit-tier0.conf)
buildroot-external/rootfs-overlay/usr/libexec/ga-boot-timing
buildroot-external/rootfs-overlay/etc/fluent-bit/fluent-bit-tier0.conf
